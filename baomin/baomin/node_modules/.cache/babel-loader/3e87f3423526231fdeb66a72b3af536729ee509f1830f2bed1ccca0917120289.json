{"ast":null,"code":"export default {\n  name: 'RecruitmentInfo'\n};","map":{"version":3,"names":["name"],"sources":["src/components/RecruitmentInfo.vue"],"sourcesContent":["<template>\r\n  <div class=\"recruitment-info-container\">\r\n    <h2 class=\"section-title\">招聘信息</h2>\r\n    \r\n    <div class=\"action-buttons\">\r\n      <router-link to=\"/recruitment-info\">\r\n        <el-button type=\"primary\">查看详细招聘信息</el-button>\r\n      </router-link>\r\n    </div>\r\n    \r\n    <div class=\"info-summary\">\r\n      <p>深圳市宝民职业技术学校现面向社会招聘各专业教师及行政管理人员。我们提供具有竞争力的薪资待遇和良好的职业发展平台。</p>\r\n      <p>招聘岗位包括：专业课教师、文化课教师、辅导员/班主任、教务管理人员等。</p>\r\n      <p>详情请点击上方按钮查看完整招聘信息。</p>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'RecruitmentInfo'\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.recruitment-info-container {\r\n  padding: 20px;\r\n  background-color: #fff;\r\n  border-radius: 4px;\r\n  box-shadow: 0 2px 12px 0 rgba(0, 0, 0, 0.1);\r\n}\r\n\r\n.section-title {\r\n  color: #0d47a1;\r\n  text-align: center;\r\n  margin-bottom: 20px;\r\n  font-size: 24px;\r\n}\r\n\r\n.action-buttons {\r\n  text-align: center;\r\n  margin-bottom: 30px;\r\n}\r\n\r\n.info-summary {\r\n  line-height: 1.8;\r\n}\r\n\r\n.info-summary p {\r\n  margin-bottom: 15px;\r\n}\r\n</style>"],"mappings":"AAmBA;EACAA,IAAA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}