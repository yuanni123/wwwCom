{"ast":null,"code":"//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n\nexport default {\n  name: 'CampusCulture',\n  props: {\n    currentView: {\n      type: String,\n      default: 'home'\n    }\n  },\n  data() {\n    return {\n      // 如果没有通过 props 传入 currentView，则使用 data 中的默认值\n      localCurrentView: this.currentView,\n      // HomeView 数据\n\n      // CampusActivities 数据\n      activities: [{\n        title: '校园艺术节',\n        date: '2023-05-15',\n        description: '一年一度的校园艺术节，展示学生艺术才华，包括音乐、舞蹈、戏剧等多种表演形式。',\n        image: '/images/art-festival.jpg'\n      }, {\n        title: '读书月活动',\n        date: '2023-04-23',\n        description: '为期一个月的读书活动，包括读书分享会、名著阅读竞赛、作家进校园等系列活动。',\n        image: '/images/reading-month.jpg'\n      }, {\n        title: '科技创新大赛',\n        date: '2023-03-18',\n        description: '鼓励学生进行科技创新，展示创新成果，培养学生的科学精神和创新能力。',\n        image: '/images/tech-innovation.jpg'\n      }, {\n        title: '校运会',\n        date: '2023-10-15',\n        description: '一年一度的校运会，各班级选手在田径场上展开激烈角逐，展示体育风采。',\n        image: '/images/sports-meeting.jpg'\n      }, {\n        title: '社团文化节',\n        date: '2023-11-20',\n        description: '各学生社团展示活动成果，招募新成员，促进校园社团文化的繁荣发展。',\n        image: '/images/club-festival.jpg'\n      }, {\n        title: '校园歌手大赛',\n        date: '2023-12-05',\n        description: '发掘校园音乐人才，为学生提供展示音乐才华的舞台，丰富校园文化生活。',\n        image: '/images/singing-contest.jpg'\n      }],\n      // StudentClubs 数据\n      categories: [{\n        id: 'all',\n        name: '全部社团'\n      }, {\n        id: 'academic',\n        name: '学术类'\n      }, {\n        id: 'arts',\n        name: '艺术类'\n      }, {\n        id: 'sports',\n        name: '体育类'\n      }, {\n        id: 'volunteer',\n        name: '志愿服务类'\n      }, {\n        id: 'technology',\n        name: '科技创新类'\n      }],\n      activeCategory: 'all',\n      clubs: [\n        // 这里添加社团数据\n      ],\n      clubActivities: [\n        // 这里添加社团活动数据\n      ],\n      // SchoolHistory 数据\n      historyEvents: [{\n        year: '1985年',\n        title: '学校成立',\n        description: '我校正式成立，开始招收第一批学生，设立基础学科专业。',\n        image: '/images/founding.jpg'\n      }, {\n        year: '1990年',\n        title: '首次校园扩建',\n        description: '随着学校规模扩大，进行了首次校园扩建，新增教学楼和实验室。',\n        image: '/images/expansion.jpg'\n      }, {\n        year: '1995年',\n        title: '获评省级重点学校',\n        description: '经过十年发展，学校教学质量获得认可，被判为省级重点学校。',\n        image: '/images/award.jpg'\n      }, {\n        year: '2000年',\n        title: '新校区启用',\n        description: '为满足教学需求，新校区正式启用，学校进入快速发展阶段。',\n        image: '/images/new-campus.jpg'\n      }, {\n        year: '2005年',\n        title: '二十周年校庆',\n        description: '学校迎来二十周年校庆，举办系列庆祝活动，回顾发展历程。',\n        image: '/images/anniversary.jpg'\n      }, {\n        year: '2010年',\n        title: '国家级示范学校',\n        description: '学校被判为国家级示范学校，教育教学质量达到新高度。',\n        image: '/images/national-award.jpg'\n      }, {\n        year: '2015年',\n        title: '三十周年校庆暨国际教育中心成立',\n        description: '学校迎来三十周年校庆，同时成立国际教育中心，开启国际化办学新篇章。',\n        image: '/images/international.jpg'\n      }, {\n        year: '2020年',\n        title: '智慧校园建设完成',\n        description: '学校完成智慧校园建设，实现教学、管理、服务全面信息化。',\n        image: '/images/smart-campus.jpg'\n      }],\n      achievements: [{\n        title: '国家级示范学校',\n        description: '2010年，学校被教育部评为\"国家级示范学校\"，成为全国教育系统的标杆。',\n        year: '2010年',\n        icon: '/images/award-icon1.svg'\n      }, {\n        title: '国家级教学成果奖',\n        description: '学校教学改革成果《创新人才培养模式的探索与实践》获国家级教学成果特等奖。',\n        year: '2012年',\n        icon: '/images/award-icon2.svg'\n      }, {\n        title: '省级文明校园',\n        description: '学校连续五年被判为\"省级文明校园\"，校园文化建设成果显著。',\n        year: '2015年',\n        icon: '/images/award-icon3.svg'\n      }, {\n        title: '国际教育示范基地',\n        description: '学校被判为\"国际教育示范基地\"，国际交流与合作成果丰硕。',\n        year: '2018年',\n        icon: '/images/award-icon4.svg'\n      }],\n      // MoralEducation 数据\n      tabs: [{\n        id: 'activities',\n        name: '德育活动'\n      }, {\n        id: 'mental-health',\n        name: '心理健康'\n      }, {\n        id: 'character',\n        name: '品德教育'\n      }, {\n        id: 'legal',\n        name: '法制教育'\n      }],\n      activeTab: 'activities',\n      moralActivities: [\n        // 这里添加德育活动数据\n      ],\n      themeClassMeetings: [\n        // 这里添加主题班会数据\n      ]\n    };\n  },\n  computed: {\n    // 使用计算属性来合并 props 和本地状态\n    activeView() {\n      return this.localCurrentView;\n    },\n    filteredClubs() {\n      if (this.activeCategory === 'all') {\n        return this.clubs;\n      } else {\n        return this.clubs.filter(club => club.categoryId === this.activeCategory);\n      }\n    }\n  },\n  methods: {\n    navigateTo(section) {\n      this.localCurrentView = section;\n    },\n    getCategoryName(categoryId) {\n      const category = this.categories.find(cat => cat.id === categoryId);\n      return category ? category.name : '';\n    }\n  },\n  watch: {\n    // 监听 props 变化，更新本地状态\n    currentView(newVal) {\n      this.localCurrentView = newVal;\n    }\n  }\n};","map":{"version":3,"names":["name","props","currentView","type","String","default","data","localCurrentView","activities","title","date","description","image","categories","id","activeCategory","clubs","clubActivities","historyEvents","year","achievements","icon","tabs","activeTab","moralActivities","themeClassMeetings","computed","activeView","filteredClubs","filter","club","categoryId","methods","navigateTo","section","getCategoryName","category","find","cat","watch","newVal"],"sources":["src/lsh/CampusCulture.vue"],"sourcesContent":["<template>\r\n  <div class=\"campus-culture\">\r\n    <div v-if=\"activeView === 'home'\">\r\n      <div class=\"home\">\r\n        <header class=\"welcome-header\">\r\n          <h1>欢迎访问校园文化网</h1>\r\n          <p>展示校园风采，传承校园文化</p>\r\n        </header>\r\n        \r\n        <div class=\"section-links\">\r\n          <div class=\"section-card\" @click=\"navigateTo('campus-activities')\">\r\n            <div class=\"card-icon\" style=\"background-image: url('/images/art-festival.svg')\"></div>\r\n            <h2>校园活动</h2>\r\n            <p>了解校园丰富多彩的活动</p>\r\n          </div>\r\n          \r\n          <div class=\"section-card\" @click=\"navigateTo('student-clubs')\">\r\n            <div class=\"card-icon\" style=\"background-image: url('/images/reading-month.svg')\"></div>\r\n            <h2>社团组织</h2>\r\n            <p>探索校园社团的精彩世界</p>\r\n          </div>\r\n          \r\n          <div class=\"section-card\" @click=\"navigateTo('school-history')\">\r\n            <div class=\"card-icon\" style=\"background-image: url('/images/tech-innovation.svg')\"></div>\r\n            <h2>校史馆</h2>\r\n            <p>回顾学校发展的光辉历程</p>\r\n          </div>\r\n          \r\n          <div class=\"section-card\" @click=\"navigateTo('moral-education')\">\r\n            <div class=\"card-icon\" style=\"background-image: url('/images/art-festival.svg')\"></div>\r\n            <h2>德育之窗</h2>\r\n            <p>培养学生良好品德，促进身心健康发展</p>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <div v-else-if=\"activeView === 'campus-activities'\">\r\n      <div class=\"campus-activities\">\r\n        <h1 class=\"section-title\">校园活动</h1>\r\n        <p class=\"section-desc\">展示我校丰富多彩的校园文化活动和体育比赛</p>\r\n        \r\n        <div class=\"activity-grid\">\r\n          <div v-for=\"(activity, index) in activities\" :key=\"index\" class=\"activity-card\">\r\n            <div class=\"activity-image\" :style=\"{ backgroundImage: `url(${activity.image})` }\">\r\n              <div class=\"activity-date\">{{ activity.date }}</div>\r\n            </div>\r\n            <div class=\"activity-content\">\r\n              <h3 class=\"activity-title\">{{ activity.title }}</h3>\r\n              <p class=\"activity-desc\">{{ activity.description }}</p>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <div v-else-if=\"currentView === 'student-clubs'\">\r\n      <div class=\"student-clubs\">\r\n        <h1 class=\"section-title\">社团组织</h1>\r\n        <p class=\"section-desc\">探索丰富多彩的校园社团，找到志同道合的伙伴</p>\r\n\r\n        <div class=\"club-categories\">\r\n          <button \r\n            v-for=\"category in categories\" \r\n            :key=\"category.id\"\r\n            :class=\"['category-btn', { active: activeCategory === category.id }]\"\r\n            @click=\"activeCategory = category.id\"\r\n          >\r\n            {{ category.name }}\r\n          </button>\r\n        </div>\r\n\r\n        <div class=\"clubs-container\">\r\n          <div v-for=\"club in filteredClubs\" :key=\"club.id\" class=\"club-card\">\r\n            <div class=\"club-header\">\r\n              <div class=\"club-logo\" :style=\"{ backgroundImage: `url(${club.logo})` }\"></div>\r\n              <div class=\"club-title\">\r\n                <h3>{{ club.name }}</h3>\r\n                <span class=\"club-category\">{{ getCategoryName(club.categoryId) }}</span>\r\n              </div>\r\n            </div>\r\n            <div class=\"club-content\">\r\n              <p class=\"club-desc\">{{ club.description }}</p>\r\n              <div class=\"club-info\">\r\n                <div class=\"info-item\">\r\n                  <span class=\"info-label\">成立时间</span>\r\n                  <span class=\"info-value\">{{ club.foundedYear }}</span>\r\n                </div>\r\n                <div class=\"info-item\">\r\n                  <span class=\"info-label\">成员数量</span>\r\n                  <span class=\"info-value\">{{ club.memberCount }}人</span>\r\n                </div>\r\n                <div class=\"info-item\">\r\n                  <span class=\"info-label\">指导老师</span>\r\n                  <span class=\"info-value\">{{ club.advisor }}</span>\r\n                </div>\r\n              </div>\r\n            </div>\r\n            <div class=\"club-footer\">\r\n              <button class=\"join-btn\">加入社团</button>\r\n              <button class=\"more-btn\">了解更多</button>\r\n            </div>\r\n          </div>\r\n        </div>\r\n\r\n        <div class=\"club-activities\">\r\n          <h2>最新社团活动</h2>\r\n          <div class=\"activity-timeline\">\r\n            <div v-for=\"(activity, index) in clubActivities\" :key=\"index\" class=\"timeline-item\">\r\n              <div class=\"timeline-date\">{{ activity.date }}</div>\r\n              <div class=\"timeline-content\">\r\n                <h3>{{ activity.title }}</h3>\r\n                <p>{{ activity.description }}</p>\r\n                <div class=\"timeline-meta\">\r\n                  <span>{{ activity.club }}</span>\r\n                  <span>{{ activity.location }}</span>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <div v-else-if=\"currentView === 'school-history'\">\r\n      <div class=\"school-history\">\r\n        <h1 class=\"section-title\">校史馆</h1>\r\n        <p class=\"section-desc\">了解我校的发展历程和辉煌成就</p>\r\n\r\n        <div class=\"history-timeline\">\r\n          <div class=\"timeline-header\">\r\n            <h2>学校发展历程</h2>\r\n          </div>\r\n          <div class=\"timeline\">\r\n            <div v-for=\"(event, index) in historyEvents\" :key=\"index\" class=\"timeline-item\">\r\n              <div class=\"timeline-dot\"></div>\r\n              <div class=\"timeline-content\">\r\n                <div class=\"timeline-year\">{{ event.year }}</div>\r\n                <div class=\"timeline-card\">\r\n                  <h3>{{ event.title }}</h3>\r\n                  <p>{{ event.description }}</p>\r\n                  <div class=\"timeline-image\" v-if=\"event.image\" :style=\"{ backgroundImage: `url(${event.image})` }\"></div>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n\r\n        <div class=\"achievements-section\">\r\n          <h2>历史成就</h2>\r\n          <div class=\"achievements-grid\">\r\n            <div v-for=\"(achievement, index) in achievements\" :key=\"index\" class=\"achievement-card\">\r\n              <div class=\"achievement-icon\" v-if=\"achievement.icon\" :style=\"{ backgroundImage: `url(${achievement.icon})` }\"></div>\r\n              <div class=\"achievement-content\">\r\n                <h3>{{ achievement.title }}</h3>\r\n                <p>{{ achievement.description }}</p>\r\n                <div class=\"achievement-year\">{{ achievement.year }}</div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <div v-else-if=\"currentView === 'moral-education'\">\r\n      <div class=\"moral-education\">\r\n        <h1 class=\"section-title\">德育之窗</h1>\r\n        <p class=\"section-desc\">培养学生良好品德，促进身心健康发展</p>\r\n\r\n        <div class=\"moral-tabs\">\r\n          <button \r\n            v-for=\"tab in tabs\" \r\n            :key=\"tab.id\"\r\n            :class=\"['tab-btn', { active: activeTab === tab.id }]\"\r\n            @click=\"activeTab = tab.id\"\r\n          >\r\n            {{ tab.name }}\r\n          </button>\r\n        </div>\r\n\r\n        <!-- 德育活动板块 -->\r\n        <div v-if=\"activeTab === 'activities'\" class=\"moral-activities\">\r\n          <h2>德育活动</h2>\r\n          <div class=\"activities-grid\">\r\n            <div v-for=\"(activity, index) in moralActivities\" :key=\"index\" class=\"activity-card\">\r\n              <div class=\"activity-image\" :style=\"{ backgroundImage: `url(${activity.image})` }\">\r\n                <div class=\"activity-date\">{{ activity.date }}</div>\r\n              </div>\r\n              <div class=\"activity-content\">\r\n                <h3 class=\"activity-title\">{{ activity.title }}</h3>\r\n                <p class=\"activity-desc\">{{ activity.description }}</p>\r\n                <div class=\"activity-info\">\r\n                  <span><i class=\"location-icon\"></i>{{ activity.location }}</span>\r\n                  <span><i class=\"time-icon\"></i>{{ activity.time }}</span>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n\r\n          <div class=\"theme-class-meetings\">\r\n            <h2>主题班会</h2>\r\n            <div class=\"meeting-timeline\">\r\n              <div v-for=\"(meeting, index) in themeClassMeetings\" :key=\"index\" class=\"timeline-item\">\r\n                <div class=\"timeline-dot\"></div>\r\n                <div class=\"timeline-content\">\r\n                  <div class=\"timeline-date\">{{ meeting.date }}</div>\r\n                  <h3 class=\"timeline-title\">{{ meeting.title }}</h3>\r\n                  <p class=\"timeline-desc\">{{ meeting.description }}</p>\r\n                  <div class=\"timeline-tags\">\r\n                    <span v-for=\"(tag, tagIndex) in meeting.tags\" :key=\"tagIndex\" class=\"tag\">{{ tag }}</span>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n\r\n        <!-- 心理健康板块 -->\r\n        <div v-else-if=\"activeTab === 'mental-health'\" class=\"mental-health\">\r\n          <h2>心理健康</h2>\r\n          \r\n          <!-- 这里添加心理健康相关内容 -->\r\n        </div>\r\n\r\n        <!-- 其他德育相关内容 -->\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"back-button\" v-if=\"activeView !== 'home'\">\r\n      <button @click=\"localCurrentView = 'home'\">返回首页</button>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'CampusCulture',\r\n  props: {\r\n    currentView: {\r\n      type: String,\r\n      default: 'home'\r\n    }\r\n  },\r\n  data() {\r\n    return {\r\n      // 如果没有通过 props 传入 currentView，则使用 data 中的默认值\r\n      localCurrentView: this.currentView,\r\n      \r\n      // HomeView 数据\r\n      \r\n      // CampusActivities 数据\r\n      activities: [\r\n        {\r\n          title: '校园艺术节',\r\n          date: '2023-05-15',\r\n          description: '一年一度的校园艺术节，展示学生艺术才华，包括音乐、舞蹈、戏剧等多种表演形式。',\r\n          image: '/images/art-festival.jpg'\r\n        },\r\n        {\r\n          title: '读书月活动',\r\n          date: '2023-04-23',\r\n          description: '为期一个月的读书活动，包括读书分享会、名著阅读竞赛、作家进校园等系列活动。',\r\n          image: '/images/reading-month.jpg'\r\n        },\r\n        {\r\n          title: '科技创新大赛',\r\n          date: '2023-03-18',\r\n          description: '鼓励学生进行科技创新，展示创新成果，培养学生的科学精神和创新能力。',\r\n          image: '/images/tech-innovation.jpg'\r\n        },\r\n        {\r\n          title: '校运会',\r\n          date: '2023-10-15',\r\n          description: '一年一度的校运会，各班级选手在田径场上展开激烈角逐，展示体育风采。',\r\n          image: '/images/sports-meeting.jpg'\r\n        },\r\n        {\r\n          title: '社团文化节',\r\n          date: '2023-11-20',\r\n          description: '各学生社团展示活动成果，招募新成员，促进校园社团文化的繁荣发展。',\r\n          image: '/images/club-festival.jpg'\r\n        },\r\n        {\r\n          title: '校园歌手大赛',\r\n          date: '2023-12-05',\r\n          description: '发掘校园音乐人才，为学生提供展示音乐才华的舞台，丰富校园文化生活。',\r\n          image: '/images/singing-contest.jpg'\r\n        }\r\n      ],\r\n      \r\n      // StudentClubs 数据\r\n      categories: [\r\n        { id: 'all', name: '全部社团' },\r\n        { id: 'academic', name: '学术类' },\r\n        { id: 'arts', name: '艺术类' },\r\n        { id: 'sports', name: '体育类' },\r\n        { id: 'volunteer', name: '志愿服务类' },\r\n        { id: 'technology', name: '科技创新类' }\r\n      ],\r\n      activeCategory: 'all',\r\n      clubs: [\r\n        // 这里添加社团数据\r\n      ],\r\n      clubActivities: [\r\n        // 这里添加社团活动数据\r\n      ],\r\n      \r\n      // SchoolHistory 数据\r\n      historyEvents: [\r\n        {\r\n          year: '1985年',\r\n          title: '学校成立',\r\n          description: '我校正式成立，开始招收第一批学生，设立基础学科专业。',\r\n          image: '/images/founding.jpg'\r\n        },\r\n        {\r\n          year: '1990年',\r\n          title: '首次校园扩建',\r\n          description: '随着学校规模扩大，进行了首次校园扩建，新增教学楼和实验室。',\r\n          image: '/images/expansion.jpg'\r\n        },\r\n        {\r\n          year: '1995年',\r\n          title: '获评省级重点学校',\r\n          description: '经过十年发展，学校教学质量获得认可，被判为省级重点学校。',\r\n          image: '/images/award.jpg'\r\n        },\r\n        {\r\n          year: '2000年',\r\n          title: '新校区启用',\r\n          description: '为满足教学需求，新校区正式启用，学校进入快速发展阶段。',\r\n          image: '/images/new-campus.jpg'\r\n        },\r\n        {\r\n          year: '2005年',\r\n          title: '二十周年校庆',\r\n          description: '学校迎来二十周年校庆，举办系列庆祝活动，回顾发展历程。',\r\n          image: '/images/anniversary.jpg'\r\n        },\r\n        {\r\n          year: '2010年',\r\n          title: '国家级示范学校',\r\n          description: '学校被判为国家级示范学校，教育教学质量达到新高度。',\r\n          image: '/images/national-award.jpg'\r\n        },\r\n        {\r\n          year: '2015年',\r\n          title: '三十周年校庆暨国际教育中心成立',\r\n          description: '学校迎来三十周年校庆，同时成立国际教育中心，开启国际化办学新篇章。',\r\n          image: '/images/international.jpg'\r\n        },\r\n        {\r\n          year: '2020年',\r\n          title: '智慧校园建设完成',\r\n          description: '学校完成智慧校园建设，实现教学、管理、服务全面信息化。',\r\n          image: '/images/smart-campus.jpg'\r\n        }\r\n      ],\r\n      achievements: [\r\n        {\r\n          title: '国家级示范学校',\r\n          description: '2010年，学校被教育部评为\"国家级示范学校\"，成为全国教育系统的标杆。',\r\n          year: '2010年',\r\n          icon: '/images/award-icon1.svg'\r\n        },\r\n        {\r\n          title: '国家级教学成果奖',\r\n          description: '学校教学改革成果《创新人才培养模式的探索与实践》获国家级教学成果特等奖。',\r\n          year: '2012年',\r\n          icon: '/images/award-icon2.svg'\r\n        },\r\n        {\r\n          title: '省级文明校园',\r\n          description: '学校连续五年被判为\"省级文明校园\"，校园文化建设成果显著。',\r\n          year: '2015年',\r\n          icon: '/images/award-icon3.svg'\r\n        },\r\n        {\r\n          title: '国际教育示范基地',\r\n          description: '学校被判为\"国际教育示范基地\"，国际交流与合作成果丰硕。',\r\n          year: '2018年',\r\n          icon: '/images/award-icon4.svg'\r\n        }\r\n      ],\r\n      \r\n      // MoralEducation 数据\r\n      tabs: [\r\n        { id: 'activities', name: '德育活动' },\r\n        { id: 'mental-health', name: '心理健康' },\r\n        { id: 'character', name: '品德教育' },\r\n        { id: 'legal', name: '法制教育' }\r\n      ],\r\n      activeTab: 'activities',\r\n      moralActivities: [\r\n        // 这里添加德育活动数据\r\n      ],\r\n      themeClassMeetings: [\r\n        // 这里添加主题班会数据\r\n      ]\r\n    }\r\n  },\r\n  computed: {\r\n    // 使用计算属性来合并 props 和本地状态\r\n    activeView() {\r\n      return this.localCurrentView;\r\n    },\r\n    filteredClubs() {\r\n      if (this.activeCategory === 'all') {\r\n        return this.clubs;\r\n      } else {\r\n        return this.clubs.filter(club => club.categoryId === this.activeCategory);\r\n      }\r\n    }\r\n  },\r\n  methods: {\r\n    navigateTo(section) {\r\n      this.localCurrentView = section;\r\n    },\r\n    getCategoryName(categoryId) {\r\n      const category = this.categories.find(cat => cat.id === categoryId);\r\n      return category ? category.name : '';\r\n    }\r\n  },\r\n  watch: {\r\n    // 监听 props 变化，更新本地状态\r\n    currentView(newVal) {\r\n      this.localCurrentView = newVal;\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n/* 通用样式 */\r\n.campus-culture {\r\n  font-family: 'Microsoft YaHei', sans-serif;\r\n  color: #333;\r\n}\r\n\r\n.section-title {\r\n  color: #1e3c72;\r\n  font-size: 2.5rem;\r\n  margin-bottom: 0.5rem;\r\n  text-align: center;\r\n}\r\n\r\n.section-desc {\r\n  color: #666;\r\n  text-align: center;\r\n  margin-bottom: 2rem;\r\n  font-size: 1.2rem;\r\n}\r\n\r\n.back-button {\r\n  margin-top: 2rem;\r\n  text-align: center;\r\n}\r\n\r\n.back-button button {\r\n  background-color: #1e3c72;\r\n  color: white;\r\n  border: none;\r\n  padding: 0.8rem 1.5rem;\r\n  border-radius: 4px;\r\n  cursor: pointer;\r\n  font-size: 1rem;\r\n  transition: background-color 0.3s;\r\n}\r\n\r\n.back-button button:hover {\r\n  background-color: #2a5298;\r\n}\r\n\r\n/* HomeView 样式 */\r\n.home {\r\n  padding: 2rem;\r\n  max-width: 1200px;\r\n  margin: 0 auto;\r\n}\r\n\r\n.welcome-header {\r\n  text-align: center;\r\n  margin-bottom: 3rem;\r\n}\r\n\r\n.welcome-header h1 {\r\n  color: #1e3c72;\r\n  font-size: 2.5rem;\r\n  margin-bottom: 0.5rem;\r\n}\r\n\r\n.welcome-header p {\r\n  color: #666;\r\n  font-size: 1.2rem;\r\n}\r\n\r\n.section-links {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));\r\n  gap: 2rem;\r\n}\r\n\r\n.section-card {\r\n  background-color: white;\r\n  border-radius: 8px;\r\n  padding: 2rem;\r\n  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);\r\n  text-align: center;\r\n  cursor: pointer;\r\n  transition: transform 0.3s ease, box-shadow 0.3s ease;\r\n}\r\n\r\n.section-card:hover {\r\n  transform: translateY(-5px);\r\n  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);\r\n}\r\n\r\n.card-icon {\r\n  width: 80px;\r\n  height: 80px;\r\n  margin: 0 auto 1.5rem;\r\n  background-size: contain;\r\n  background-position: center;\r\n  background-r