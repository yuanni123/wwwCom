"content-container\">\r\n      <!-- 导航标签 -->\r\n      <el-tabs v-model=\"activeTab\" type=\"card\" class=\"moral-tabs\">\r\n        <el-tab-pane label=\"德育活动\" name=\"activities\">\r\n          <div class=\"section-content\">\r\n            <h2 class=\"section-title\">丰富多彩的德育活动</h2>\r\n            \r\n            <el-timeline>\r\n              <el-timeline-item\r\n                v-for=\"activity in moralActivities\"\r\n                :key=\"activity.id\"\r\n                :timestamp=\"activity.date\"\r\n                :color=\"activity.color\"\r\n                placement=\"top\"\r\n              >\r\n                <el-card>\r\n                  <div class=\"activity-card\">\r\n                    <div class=\"activity-image\">\r\n                      <el-image :src=\"activity.image\" :alt=\"activity.title\" fit=\"cover\"></el-image>\r\n                    </div>\r\n                    <div class=\"activity-info\">\r\n                      <h3>{{ activity.title }}</h3>\r\n                      <p>{{ activity.description }}</p>\r\n                      <div class=\"activity-tags\">\r\n                        <el-tag size=\"small\" :type=\"activity.type\">{{ activity.category }}</el-tag>\r\n                      </div>\r\n                    </div>\r\n                  </div>\r\n                </el-card>\r\n              </el-timeline-item>\r\n            </el-timeline>\r\n          </div>\r\n        </el-tab-pane>\r\n        \r\n        <el-tab-pane label=\"心理健康\" name=\"mental-health\">\r\n          <div class=\"section-content\">\r\n            <h2 class=\"section-title\">心理健康教育</h2>\r\n            <!-- 心理健康内容 -->\r\n          </div>\r\n        </el-tab-pane>\r\n        \r\n        <el-tab-pane label=\"学生风采\" name=\"student-showcase\">\r\n          <div class=\"section-content\">\r\n            <h2 class=\"section-title\">学生风采展示</h2>\r\n            <!-- 学生风采内容 -->\r\n          </div>\r\n        </el-tab-pane>\r\n      </el-tabs>\r\n    </div>\r\n    \r\n   