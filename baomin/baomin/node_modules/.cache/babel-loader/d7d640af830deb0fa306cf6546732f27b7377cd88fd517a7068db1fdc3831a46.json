      <h2 class=\"section-title\">教学动态</h2>\r\n          <el-tabs type=\"border-card\">\r\n            <el-tab-pane label=\"教学计划\">\r\n              <el-timeline>\r\n                <el-timeline-item\r\n                  v-for=\"item in teachingPlans\"\r\n                  :key=\"item.id\"\r\n                  :timestamp=\"item.date\"\r\n                  placement=\"top\"\r\n                >\r\n                  <el-card>\r\n                    <h4>{{ item.title }}</h4>\r\n                    <p>{{ item.content }}</p>\r\n                  </el-card>\r\n                </el-timeline-item>\r\n              </el-timeline>\r\n            </el-tab-pane>\r\n            \r\n            <el-tab-pane label=\"课程安排\">\r\n              <el-table :data=\"courseSchedule\" stripe style=\"width: 100%\">\r\n                <el-table-column prop=\"time\" label=\"时间\" width=\"180\" />\r\n                <el-table-column prop=\"course\" label=\"课程名称\" />\r\n                <el-table-column prop=\"teacher\" label=\"授课教师\" width=\"180\" />\r\n                <el-table-column prop=\"location\" label=\"地点\" width=\"180\" />\r\n              </el-table>\r\n            </el-tab-pane>\r\n\r\n            <el-tab-pane label=\"教学成果\">\r\n              <el-row :gutter=\"20\">\r\n                <el-col :span=\"8\" v-for=\"item in achievements\" :key=\"item.id\">\r\n                  <el-card class=\"achievement-card\">\r\n                    <template #header>\r\n                      <div class=\"card-header\">\r\n                        <span>{{ item.title }}</span>\r\n                        <el-tag size=\"small\">{{ item.type }}</el-tag>\r\n                      </div>\r\n                    </template>\r\n                    <div class=\"card-content\">{{ item.description }}</div>\r\n                  </el-card>\r\n                </el-col>\r\n              </el-row>\r\n            </el-tab-pane>\r\n          </el-tabs>\r\n        </div>\r\n\r\n        <!-- 教研活动部分 -->\r\n        <div class=\"section\">\r\n          <!-- 保留原有内容 -->\r\n          <h2 class=\"section-title\">教研活动</h2>\r\n          <el-row :gutter=\"20\">\r\n            <el-col :span=\"16\">\r\n              <el-calendar v-model=\"currentDate\">\r\n                <template #dateCell=\"{ data }\">\r\n                  <div class=\"calendar-cell\">\r\n                    <p :class=\"{ 'is-selected': isActivityDay(data.day) }\">\r\n                      {{ data.day.split('-').slice(2).join('') }}\r\n                      <el-badge v-if=\"isActivityDay(data.day)\" is-dot />\r\n                    </p>\r\n                  </div>\r\n                </template>\r\n              </el-calendar>\r\n            </el-col>\r\n            <el-col :span=\"8\">\r\n              <el-card class=\"activity-list\">\r\n                <template #header>\r\n                  <div class=\"card-header\">\r\n                    <span>近期活动</span>\r\n                  </div>\r\n                </template>\r\n                <el-timeline>\r\n                  <el-timeline-item\r\n                    v-for=\"activity in recentActivities\"\r\n                    :key=\"activity.id\"\r\n                    :type=\"activity.type\"\r\n                    :timestamp=\"activity.date\"\r\n                    :color=\"activity.color\"\r\n                  >\r\n                    {{ activity.title }}\r\n                  </el-timeline-item>\r\n                </el-timeline>\r\n              </el-card>\r\n            </el-col>\r\n          </el-row>\r\n        </div>\r\n      </el-main>\r\n    </el-container>\r\n    \r\n    <!-- 添加页脚 -->\r\n    <el-footer class=\"footer\">\r\n      <div class=\"footer-content\">\r\n        <p>地址：深圳市宝安区石岩石龙仔路宝民学校</p>\r\n        <div class=\"copyright\">\r\n          © 2023 深圳市宝民职业技术学校 版权所有\r\n          <p>技术支持：dxh</p>\r\n        </div>\r\n      </div>\r\n    </el-footer>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'TeachingPage',\r\n  data() {\r\n    // 保留原有数据\r\n    return {\r\n      currentDate: new Date(),\r\n      teachingPlans: [\r\n        // 保留原有数据\r\n      ],\r\n      courseSchedule: [\r\n        // 保留原有数据\r\n      ],\r\n      achievements: [\r\n        // 保留原有数据\r\n      ],\r\n      recentActivities: [\r\n        // 保留原有数据\r\n      ],\r\n      activityDays: ['2024-03-20', '2024-03-25', '2024-03-30']\r\n    }\r\n  },\r\n  methods: {\r\n    isActivityDay(day) {\r\n      return this.activityDays.includes(day)\r\n    },\r\n    // 添加返回首页方法\r\n    backToHome() {\r\n      this.$router.push('/');\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.teaching-container {\r\n  display: flex;\r\n  flex-direction: column;\r\n  min-height: 100vh;\r\n}\r\n\r\n.header {\r\n  background-color: #0d47a1;\r\n  color: white;\r\n  padding: 10px 20px;\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n.logo-container {\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n.school-name h1 {\r\n  margin: 0;\r\n  font-size: 24px;\r\n}\r\n\r\n.school-name p {\r\n  margin: 0;\r\n  font-size: 12px;\r\n}\r\n\r\n/* 保留原有样式 */\r\n.section {\r\n  margin-bottom: 30px;\r\n}\r\n\r\n.section-title {\r\n  margin-bottom: 20px;\r\n  padding-left: 10px;\r\n  border-left: 4px solid #409EFF;\r\n}\r\n\r\n/* 添加页脚样式 */\r\n.footer {\r\n  background-color: #535353;\r\n  color: white;\r\n  padding: 40px 0;\r\n  height: 160% !important;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n}\r\n\r\n.footer-content {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  justify-content: center;\r\n  text-align: center;\r\n  font-size: 14px;\r\n}\r\n\r\n.footer-content p {\r\n  margin: 5px 0;\r\n  font-size: 14px;\r\n}\r\n\r\n.copyright {\r\n  margin-top: 5px;\r\n  font-size: 14px;\r\n}\r\n\r\n.copyright p {\r\n  font-size: 12px;\r\n  margin: 3px 0;\r\n}\r\n\r\n.back-to-home {\r\n  margin: 15px;\r\n  text-align: right;\r\n  padding-right: 20px;\r\n}\r\n\r\n/* 保留其他原有样式 */\r\n</style>"],"mappings":";