      campusImages: [{\n        url: 'https://via.placeholder.com/400x300?text=教学楼',\n        title: '教学楼'\n      }, {\n        url: 'https://via.placeholder.com/400x300?text=实训中心',\n        title: '实训中心'\n      }, {\n        url: 'https://via.placeholder.com/400x300?text=图书馆',\n        title: '图书馆'\n      }, {\n        url: 'https://via.placeholder.com/400x300?text=运动场',\n        title: '运动场'\n      }, {\n        url: 'https://via.placeholder.com/400x300?text=学生宿舍',\n        title: '学生宿舍'\n      }, {\n        url: 'https://via.placeholder.com/400x300?text=校园景观',\n        title: '校园景观'\n      }]\n    };\n  },\n  created() {\n    // 根据URL查询参数设置当前活动的标签页\n    const tab = this.$route.query.tab;\n    if (tab) {\n      this.activeTab = tab;\n    }\n  },\n  watch: {\n    // 监听路由变化，更新活动标签页\n    '$route.query.tab': function (newTab) {\n      if (newTab) {\n        this.activeTab = newTab;\n      } else {\n        this.activeTab = 'intro';\n      }\n    }\n  },\n  methods: {\n    handleSelect(key) {\n      this.activeTab = key;\n      // 更新URL查询参数，但不触发路由变化\n      if (key === 'intro') {\n        this.$router.push({\n          path: '/school-overview'\n        });\n      } else {\n        this.$router.push({\n          path: '/school-overview',\n          query: {\n            tab: key\n          }\n        });\n      }\n    }\n  }\n};","map":{"version":3,"names":["MainNavigation","name","components","data","activeTab","schoolImages","leadershipTeam","id","title","description","avatar","honors","year","color","image","campusImages","url","created","tab","$route","query","watch","$route.query.tab","newTab","methods","handleSelect","key","$router","push","path"],"sources":["src/views/SchoolOverview.vue"],"sourcesContent":["<template>\r\n  <div class=\"school-overview-page\">\r\n    <el-header class=\"header\">\r\n      <div class=\"logo-container\">\r\n        <div class=\"school-name\">\r\n          <h1>深圳市宝民职业技术学校</h1>\r\n          <p>SHENZHEN BAOMIN VOCATIONAL TECHNICAL SCHOOL