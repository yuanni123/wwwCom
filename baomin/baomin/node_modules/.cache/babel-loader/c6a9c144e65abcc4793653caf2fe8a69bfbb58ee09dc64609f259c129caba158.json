{"ast":null,"code":"import AdmissionInfo from '../components/AdmissionInfo.vue';\nimport RecruitmentInfo from '../components/RecruitmentInfo.vue';\nimport OnlineRegistration from '../components/OnlineRegistration.vue';\nimport ContactUs from '../components/ContactUs.vue';\nexport default {\n  name: 'RecruitmentPage',\n  components: {\n    AdmissionInfo,\n    RecruitmentInfo,\n    OnlineRegistration,\n    ContactUs\n  },\n  props: {\n    activeTab: {\n      type: String,\n      default: 'recruitment'\n    }\n  },\n  data() {\n    return {\n      // 使用props中的activeTab作为默认值\n      activeTabData: this.activeTab\n    };\n  },\n  computed: {\n    activeMenuItem() {\n      const mapping = {\n        'admission': '/admission',\n        'recruitment': '/recruitment',\n        'registration': '/registration',\n        'contact': '/contact'\n      };\n      return mapping[this.activeTabData];\n    }\n  },\n  methods: {\n    handleMenuSelect(index) {\n      const tabMapping = {\n        '1': 'admission',\n        '2': 'recruitment',\n        '3': 'registration',\n        '4': 'contact'\n      };\n      this.activeTab = tabMapping[index];\n    },\n    handleTabClick(tab) {\n      const menuMapping = {\n        'admission': '1',\n        'recruitment': '2',\n        'registration': '3',\n        'contact': '4'\n      };\n      this.$refs.menu.activeIndex = menuMapping[tab.name];\n    }\n  }\n};","map":{"version":3,"names":["AdmissionInfo","RecruitmentInfo","OnlineRegistration","ContactUs","name","components","props","activeTab","type","String","default","data","activeTabData","computed","activeMenuItem","mapping","methods","handleMenuSelect","index","tabMapping","handleTabClick","tab","menuMapping","$refs","menu","activeIndex"],"sources":["src/views/RecruitmentPage.vue"],"sourcesContent":["<template>\r\n  <div class=\"recruitment-container\">\r\n    <el-header class=\"header\">\r\n      <div class=\"logo-container\">\r\n        <div class=\"school-name\">\r\n          <h1>深圳市宝民职业技术学校</h1>\r\n          <p>SHENZHEN FENDA VOCATIONAL TECHNICAL SCHOOL</p>\r\n        </div>\r\n      </div>\r\n    </el-header>\r\n    \r\n    <el-container class=\"main-container\">\r\n      <el-aside width=\"220px\" class=\"sidebar\">\r\n        <el-menu\r\n          :default-active=\"activeMenuItem\"\r\n          class=\"menu\"\r\n          background-color=\"#0d47a1\"\r\n          text-color=\"#fff\"\r\n          active-text-color=\"#ffd04b\"\r\n          router>\r\n          <el-menu-item index=\"/admission\">\r\n            <span>招生信息</span>\r\n          </el-menu-item>\r\n          <el-menu-item index=\"/recruitment\">\r\n            <span>招聘信息</span>\r\n          </el-menu-item>\r\n          <el-menu-item index=\"/registration\">\r\n            <span>在线报名</span>\r\n          </el-menu-item>\r\n          <el-menu-item index=\"/contact\">\r\n            <span>联系我们</span>\r\n          </el-menu-item>\r\n        </el-menu>\r\n      </el-aside>\r\n      \r\n      <el-main class=\"main-content\">\r\n        <el-tabs v-model=\"activeTab\" type=\"card\" @tab-click=\"handleTabClick\">\r\n          <el-tab-pane label=\"招生信息\" name=\"admission\">\r\n            <admission-info></admission-info>\r\n          </el-tab-pane>\r\n          <el-tab-pane label=\"招聘信息\" name=\"recruitment\">\r\n            <recruitment-info></recruitment-info>\r\n          </el-tab-pane>\r\n          <el-tab-pane label=\"在线报名\" name=\"registration\">\r\n            <online-registration></online-registration>\r\n          </el-tab-pane>\r\n          <el-tab-pane label=\"联系我们\" name=\"contact\">\r\n            <contact-us></contact-us>\r\n          </el-tab-pane>\r\n        </el-tabs>\r\n      </el-main>\r\n    </el-container>\r\n    \r\n    <el-footer class=\"footer\">\r\n      © 2023 深圳市宝民职业技术学校 版权所有\r\n    </el-footer>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport AdmissionInfo from '../components/AdmissionInfo.vue'\r\nimport RecruitmentInfo from '../components/RecruitmentInfo.vue'\r\nimport OnlineRegistration from '../components/OnlineRegistration.vue'\r\nimport ContactUs from '../components/ContactUs.vue'\r\n\r\nexport default {\r\n  name: 'RecruitmentPage',\r\n  components: {\r\n    AdmissionInfo,\r\n    RecruitmentInfo,\r\n    OnlineRegistration,\r\n    ContactUs\r\n  },\r\n  props: {\r\n    activeTab: {\r\n      type: String,\r\n      default: 'recruitment'\r\n    }\r\n  },\r\n  data() {\r\n    return {\r\n      // 使用props中的activeTab作为默认值\r\n      activeTabData: this.activeTab\r\n    }\r\n  },\r\n  computed: {\r\n    activeMenuItem() {\r\n      const mapping = {\r\n        'admission': '/admission',\r\n        'recruitment': '/recruitment',\r\n        'registration': '/registration',\r\n        'contact': '/contact'\r\n      };\r\n      return mapping[this.activeTabData];\r\n    }\r\n  },\r\n  methods: {\r\n    handleMenuSelect(index) {\r\n      const tabMapping = {\r\n        '1': 'admission',\r\n        '2': 'recruitment',\r\n        '3': 'registration',\r\n        '4': 'contact'\r\n      };\r\n      this.activeTab = tabMapping[index];\r\n    },\r\n    handleTabClick(tab) {\r\n      const menuMapping = {\r\n        'admission': '1',\r\n        'recruitment': '2',\r\n        'registration': '3',\r\n        'contact': '4'\r\n      };\r\n      this.$refs.menu.activeIndex = menuMapping[tab.name];\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.recruitment-container {\r\n  display: flex;\r\n  flex-direction: column;\r\n  min-height: 100vh;\r\n}\r\n\r\n.header {\r\n  background-color: #0d47a1;\r\n  color: white;\r\n  padding: 10px 20px;\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n.logo-container {\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n.school-name h1 {\r\n  margin: 0;\r\n  font-size: 24px;\r\n}\r\n\r\n.school-name p {\r\n  margin: 0;\r\n  font-size: 12px;\r\n}\r\n\r\n.main-container {\r\n  flex: 1;\r\n}\r\n\r\n.sidebar {\r\n  background-color: #0d47a1;\r\n}\r\n\r\n.menu {\r\n  border-right: none;\r\n}