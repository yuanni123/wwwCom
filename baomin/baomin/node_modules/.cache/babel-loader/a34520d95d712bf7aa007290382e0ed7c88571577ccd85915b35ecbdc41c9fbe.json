       color: '#409EFF'\n      }, {\n        id: 2,\n        title: '专业建设研讨会',\n        date: '2024-03-25',\n        type: 'success',\n        color: '#67C23A'\n      }, {\n        id: 3,\n        title: '教师技能培训',\n        date: '2024-03-30',\n        type: 'warning',\n        color: '#E6A23C'\n      }],\n      activityDays: ['2024-03-20', '2024-03-25', '2024-03-30']\n    };\n  },\n  created() {\n    // 根据URL查询参数设置当前活动的标签页\n    const tab = this.$route.query.tab;\n    if (tab) {\n      this.activeTab = tab;\n    }\n\n    // 如果是教研活动标签，滚动到教研活动部分\n    if (tab === 'research') {\n      this.$nextTick(() => {\n        const researchSection = document.getElementById('research-section');\n        if (researchSection) {\n          researchSection.scrollIntoView({\n            behavior: 'smooth'\n          });\n        }\n      });\n    }\n  },\n  watch: {\n    // 监听路由变化，更新活动标签页\n    '$route.query.tab': function (newTab) {\n      if (newTab) {\n        this.activeTab = newTab;\n\n        // 如果是教研活动标签，滚动到教研活动部分\n        if (newTab === 'research') {\n          this.$nextTick(() => {\n            const researchSection = document.getElementById('research-section');\n            if (researchSection) {\n              researchSection.scrollIntoView({\n                behavior: 'smooth'\n              });\n            }\n          });\n        }\n      }\n    }\n  },\n  methods: {\n    isActivityDay(day) {\n      return this.activityDays.includes(day);\n    },\n    // 保留返回首页方法，以防需要\n    backToHome() {\n      this.$router.push('/');\n    }\n  }\n};","map":{"version":3,"names":["MainNavigation","name","components","data","activeTab","currentDate","Date","teachingPlans","id","title","content","date","courseSchedule","time","course","teacher","location","achievements","type","description","recentActivities","color","activityDays","created","tab","$route","query","$nextTick","researchSection","document","getElementById","scrollIntoView","behavior","watch","$route.query.tab","newTab","metho