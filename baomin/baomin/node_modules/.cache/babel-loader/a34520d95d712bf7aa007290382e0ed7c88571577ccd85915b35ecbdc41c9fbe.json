if (tab === 'research') {\r\n      this.$nextTick(() => {\r\n        const researchSection = document.getElementById('research-section');\r\n        if (researchSection) {\r\n          researchSection.scrollIntoView({ behavior: 'smooth' });\r\n        }\r\n      });\r\n    }\r\n  },\r\n  watch: {\r\n    // 监听路由变化，更新活动标签页\r\n    '$route.query.tab': function(newTab) {\r\n      if (newTab) {\r\n        this.activeTab = newTab;\r\n        \r\n        // 如果是教研活动标签，滚动到教研活动部分\r\n        if (newTab === 'research') {\r\n          this.$nextTick(() => {\r\n            const researchSection = document.getElementById('research-section');\r\n            if (researchSection) {\r\n              researchSection.scrollIntoView({ behavior: 'smooth' });\r\n            }\r\n          });\r\n        }\r\n      }\r\n    }\r\n  },\r\n  methods: {\r\n    isActivityDay(day) {\r\n      return this.activityDays.includes(day)\r\n    },\r\n    // 保留返回首页方法，以防需要\r\n    backToHome() {\r\n      this.$router.push('/');\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.teaching-container {\r\n  display: flex;\r\n  flex-direction: column;\r\n  min-height: 100vh;\r\n}\r\n\r\n.header {\r\n  background-color: #0d47a1;\r\n  color: white;\r\n  padding: 10px 20px;\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n.logo-container {\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n.school-name h1 {\r\n  margin: 0;\r\n  font-size: 24px;\r\n}\r\n\r\n.school-name p {\r\n  margin: 0;\r\n  font-size: 12px;\r\n}\r\n\r\n/* 添加导航栏样式 */\r\n.main-nav {\r\n  display: flex;\r\n  justify-content: center;\r\n}\r\n\r\n.el-submenu .el-menu {\r\n  min-width: 150px;\r\n}\r\n\r\n.el-submenu .el-menu-item {\r\n  padding: 0 20px;\r\n  height: 40px;\r\n  line-height: 40px;\r\n}\r\n\r\n.el-submenu__title {\r\n  font-size: 16px;\r\n}\r\n\r\n.el-submenu .el-menu-item:hover {\r\n  background-color: #1565c0 !important;\r\n}\r\n\r\n/* 其他样式保持不变 */\r\n.section {\r\n  margin-bottom: 30px;\r\n}\r\n\r\n.section-titl