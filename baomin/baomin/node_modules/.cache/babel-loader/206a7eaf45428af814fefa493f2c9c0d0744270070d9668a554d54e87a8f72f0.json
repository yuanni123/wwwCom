{"ast":null,"code":"//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n\nimport { ref, computed } from 'vue';\nconst activeTab = ref('activities');\nconst activeWorkCategory = ref('all');\nconst tabs = ref([{\n  id: 'activities',\n  name: '德育活动'\n}, {\n  id: 'mental-health',\n  name: '心理健康'\n}, {\n  id: 'student-showcase',\n  name: '学生风采'\n}]);\n\n// 德育活动数据\nconst moralActivities = ref([{\n  title: '爱国主义教育展览',\n  description: '通过图片、文物展示和互动体验，深入开展爱国主义教育，增强学生的爱国情怀。',\n  date: '2023-09-28',\n  time: '09:00 - 16:00',\n  location: '学校展览馆',\n  image: '/images/art-festival.svg'\n}, {\n  title: '感恩教育主题活动',\n  description: '通过演讲、分享和实践活动，培养学生感恩意识，学会感恩父母、老师和社会。',\n  date: '2023-10-12',\n  time: '14:30 - 16:30',\n  location: '学校礼堂',\n  image: '/images/reading-month.svg'\n}, {\n  title: '诚信教育系列讲座',\n  description: '邀请专家学者开展诚信教育讲座，引导学生树立正确的诚信观念。',\n  date: '2023-11-05',\n  time: '15:00 - 16:30',\n  location: '学术报告厅',\n  image: '/images/tech-innovation.svg'\n}, {\n  title: '文明礼仪培训',\n  description: '开展文明礼仪培训，提高学生的文明素养和行为规范。',\n  date: '2023-11-20',\n  time: '13:30 - 15:30',\n  location: '多功能厅',\n  image: '/images/art-festival.svg'\n}]);\nconst themeClassMeetings = ref([{\n  title: '传承中华美德',\n  description: '探讨中华传统美德的现代价值，引导学生传承和弘扬中华优秀传统文化。',\n  date: '2023-09-15',\n  tags: ['传统文化', '道德教育']\n}, {\n  title: '网络文明与安全',\n  description: '讨论网络使用中的文明行为和安全问题，培养学生良好的网络素养。',\n  date: '2023-10-08',\n  tags: ['网络安全', '文明上网']\n}, {\n  title: '生命教育',\n  description: '通过案例分享和讨论，引导学生珍爱生命，尊重生命。',\n  date: '2023-10-22',\n  tags: ['生命价值', '心理健康']\n}, {\n  title: '环保意识与行动',\n  description: '讨论环境保护的重要性，鼓励学生从小事做起，保护环境。',\n  date: '2023-11-12',\n  tags: ['环保', '可持续发展']\n}]);\n\n// 心理健康数据\nconst mentalHealthWorkshops = ref([{\n  title: '青少年压力管理与情绪调节',\n  date: '2023-12-05',\n  speaker: '张心理 教授'\n}, {\n  title: '如何建立健康的人际关系',\n  date: '2023-12-15',\n  speaker: '李咨询 老师'\n}, {\n  title: '考试焦虑的应对策略',\n  date: '2023-12-25',\n  speaker: '王辅导 心理咨询师'\n}]);\nconst resourceCategories = ref([{\n  name: '心理健康书籍',\n  description: '精选心理健康相关书籍推荐，涵盖自我认知、情绪管理等多个方面。'\n}, {\n  name: '心理健康视频',\n  description: '提供心理健康教育视频，包括专家讲座、案例分析等内容。'\n}, {\n  name: '心理健康文章',\n  description: '收集心理健康相关文章，帮助学生了解心理健康知识。'\n}]);\nconst selfHelpTools = ref([{\n  name: '情绪日记',\n  description: '记录每日情绪变化，帮助识别情绪模式和触发因素。'\n}, {\n  name: '放松训练',\n  description: '提供呼吸放松、肌肉放松等训练方法，帮助缓解压力和焦虑。'\n}, {\n  name: '认知重构',\n  description: '学习识别和挑战消极思维模式，建立更健康的思维方式。'\n}, {\n  name: '目标设定',\n  description: '帮助设定明确、可行的目标，增强成就感和自信心。'\n}]);\n\n// 学生风采数据\nconst outstandingStudents = ref([{\n  name: '李明',\n  class: '高二(3)班',\n  achievement: '全国数学奥林匹克竞赛一等奖',\n  story: '李明同学自小对数学有浓厚兴趣，通过刻苦学习和不懈努力，在全国数学奥林匹克竞赛中获得一等奖。他不仅学习成绩优异，还积极参与学校各项活动，是同学们学习的榜样。',\n  image: '/images/art-festival.svg'\n}, {\n  name: '张华',\n  class: '高三(1)班',\n  achievement: '省级三好学生、校学生会主席',\n  story: '张华同学品学兼优，担任校学生会主席期间，组织了多项有意义的校园活动，展现了出色的领导能力和组织能力。她关心集体，乐于助人，深受师生喜爱。',\n  image: '/images/reading-month.svg'\n}, {\n  name: '王强',\n  class: '高一(5)班',\n  achievement: '校园歌手大赛冠军、志愿服务先进个人',\n  story: '王强同学多才多艺，在校园歌手大赛中获得冠军。同时，他积极参与志愿服务活动，利用周末时间到敬老院陪伴老人，展现了当代青年的责任感和爱心。',\n  image: '/images/tech-innovation.svg'\n}]);\nconst workCategories = ref([{\n  id: 'all',\n  name: '全部作品'\n}, {\n  id: 'writing',\n  name: '文学创作'\n}, {\n  id: 'art',\n  name: '美术作品'\n}, {\n  id: 'science',\n  name: '科技创新'\n}, {\n  id: 'photography',\n  name: '摄影作品'\n}]);\nconst studentWorks = ref([{\n  title: '《我的家乡》',\n  author: '刘芳',\n  class: '高一(2)班',\n  description: '这篇散文描绘了作者家乡的自然风光和人文风情，语言优美，情感真挚。',\n  image: '/images/art-festival.svg',\n  category: 'writing',\n  tags: ['散文', '乡土情怀']\n}, {\n  title: '《春天》',\n  author: '张明',\n  class: '高二(4)班',\n  description: '这幅水彩画生动地表现了春天的生机和活力，色彩明快，构图和谐。',\n  image: '/images/reading-month.svg',\n  category: 'art',\n  tags: ['水彩画', '风景']\n}, {\n  title: '智能垃圾分类系统',\n  author: '李强',\n  class: '高三(5)班',\n  description: '这个科技创新项目利用图像识别技术实现垃圾自动分类，具有很高的实用价值。',\n  image: '/images/tech-innovation.svg',\n  category: 'science',\n  tags: ['人工智能', '环保']\n}, {\n  title: '《瞬间》',\n  author: '王丽',\n  class: '高二(1)班',\n  description: '这组摄影作品捕捉了校园生活中的精彩瞬间，画面真实，情感丰富。',\n  image: '/images/art-festival.svg',\n  category: 'photography',\n  tags: ['校园生活', '纪实摄影']\n}, {\n  title: '《未来城市》',\n  author: '赵阳',\n  class: '高一(3)班',\n  description: '这幅科幻画描绘了作者心目中的未来城市，想象力丰富，技法娴熟。',\n  image: '/images/reading-month.svg',\n  category: 'art',\n  tags: ['科幻', '创意']\n}, {\n  title: '《成长的烦恼》',\n  author: '陈静',\n  class: '高二(2)班',\n  description: '这篇小说真实地描写了青少年成长过程中面临的困惑和挑战，情节生动，人物形象鲜明。',\n  image: '/images/tech-innovation.svg',\n  category: 'writing',\n  tags: ['小说', '青春']\n}]);\nconst competitionAwards = ref([{\n  competition: '全国中学生物理竞赛',\n  student: '张伟',\n  prize: '一等奖',\n  teacher: '李教授',\n  date: '2023-05-15'\n}, {\n  competition: '省级英语演讲比赛',\n  student: '王丽',\n  prize: '二等奖',\n  teacher: '陈老师',\n  date: '2023-06-20'\n}, {\n  competition: '全国青少年科技创新大赛',\n  student: '李明、赵阳',\n  prize: '特等奖',\n  teacher: '张教授',\n  date: '2023-07-10'\n}, {\n  competition: '市级书法比赛',\n  student: '刘芳',\n  prize: '一等奖',\n  teacher: '王老师',\n  date: '2023-09-05'\n}, {\n  competition: '全国中学生化学实验技能大赛',\n  student: '陈强',\n  prize: '三等奖',\n  teacher: '黄教授',\n  date: '2023-10-18'\n}]);\nconst filteredWorks = computed(() => {\n  if (activeWorkCategory.value === 'all') {\n    return studentWorks.value;\n  } else {\n    return studentWorks.value.filter(work => work.category === activeWorkCategory.value);\n  }\n});","map":{"version":3,"names":["ref","computed","activeTab","activeWorkCategory","tabs","id","name","moralActivities","title","description","date","time","location","image","themeClassMeetings","tags","mentalHealthWorkshops","speaker","resourceCategories","selfHelpTools","outstandingStudents","class","achievement","story","workCategories","studentWorks","author","category","competitionAwards","competition","student","prize","teacher","filteredWorks","value","filter","work"],"sources":["src/lsh/MoralEducation.vue"],"sourcesContent":["<template>\r\n  <div class=\"moral-education\">\r\n    <h1 class=\"section-title\">德育之窗</h1>\r\n    <p class=\"section-desc\">培养学生良好品德，促进身心健康发展</p>\r\n\r\n    <div class=\"moral-tabs\">\r\n      <button \r\n        v-for=\"tab in tabs\" \r\n        :key=\"tab.id\"\r\n        :class=\"['tab-btn', { active: activeTab === tab.id }]\"\r\n        @click=\"activeTab = tab.id\"\r\n      >\r\n        {{ tab.name }}\r\n      </button>\r\n    </div>\r\n\r\n    <!-- 德育活动板块 -->\r\n    <div v-if=\"activeTab === 'activities'\" class=\"moral-activities\">\r\n      <h2>德育活动</h2>\r\n      <div class=\"activities-grid\">\r\n        <div v-for=\"(activity, index) in moralActivities\" :key=\"index\" class=\"activity-card\">\r\n          <div class=\"activity-image\" :style=\"{ backgroundImage: `url(${activity.image})` }\">\r\n            <div class=\"activity-date\">{{ activity.date }}</div>\r\n          </div>\r\n          <div class=\"activity-content\">\r\n            <h3 class=\"activity-title\">{{ activity.title }}</h3>\r\n            <p class=\"activity-desc\">{{ activity.description }}</p>\r\n            <div class=\"activity-info\">\r\n              <span><i class=\"location-icon\"></i>{{ activity.location }}</span>\r\n              <span><i class=\"time-icon\"></i>{{ activity.time }}</span>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <div class=\"theme-class-meetings\">\r\n        <h2>主题班会</h2>\r\n        <div class=\"meeting-timeline\">\r\n          <div v-for=\"(meeting, index) in themeClassMeetings\" :key=\"index\" class=\"timeline-item\">\r\n            <div class=\"timeline-dot\"></div>\r\n            <div class=\"timeline-content\">\r\n              <div class=\"timeline-date\">{{ meeting.date }}</div>\r\n              <h3 class=\"timeline-title\">{{ meeting.title }}</h3>\r\n              <p class=\"timeline-desc\">{{ meeting.description }}</p>\r\n              <div class=\"timeline-tags\">\r\n                <span v-for=\"(tag, tagIndex) in meeting.tags\" :key=\"tagIndex\" class=\"tag\">{{ tag }}</span>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 心理健康板块 -->\r\n    <div v-else-if=\"activeTab === 'mental-health'\" class=\"mental-health\">\r\n      <h2>心理健康</h2>\r\n      \r\n      <div class=\"mental-health-services\">\r\n        <div class=\"service-card\">\r\n          <div class=\"service-icon counseling\"></div>\r\n          <h3>心理咨询服务</h3>\r\n          <p>提供专业的心理咨询服务，帮助学生解决心理困扰，促进心理健康发展。</p>\r\n          <div class=\"service-details\">\r\n            <p><strong>咨询时间：</strong>周一至周五 14:00-17:00</p>\r\n            <p><strong>咨询地点：</strong>心理咨询中心（教学楼B区3楼）</p>\r\n            <p><strong>预约方式：</strong>线上预约系统或现场预约</p>\r\n          </div>\r\n          <button class=\"service-btn\">在线预约</button>\r\n        </div>\r\n\r\n        <div class=\"service-card\">\r\n          <div class=\"service-icon workshop\"></div>\r\n          <h3>心理健康讲座</h3>\r\n          <p>定期举办心理健康讲座，邀请专业心理学家分享心理健康知识。</p>\r\n          <div class=\"upcoming-workshops\">\r\n            <h4>近期讲座</h4>\r\n            <ul>\r\n              <li v-for=\"(workshop, index) in mentalHealthWorkshops\" :key=\"index\">\r\n                <span class=\"workshop-date\">{{ workshop.date }}</span>\r\n                <span class=\"workshop-title\">{{ workshop.title }}</span>\r\n                <span class=\"workshop-speaker\">主讲：{{ workshop.speaker }}</span>\r\n              </li>\r\n            </ul>\r\n          </div>\r\n          <button class=\"service-btn\">查看更多</button>\r\n        </div>\r\n\r\n        <div class=\"service-card\">\r\n          <div class=\"service-icon resources\"></div>\r\n          <h3>心理健康资源</h3>\r\n          <p>提供丰富的心理健康学习资源，包括书籍、视频、文章等。</p>\r\n          <div class=\"resource-categories\">\r\n            <div v-for=\"(category, index) in resourceCategories\" :key=\"index\" class=\"resource-category\">\r\n              <h4>{{ category.name }}</h4>\r\n              <p>{{ category.description }}</p>\r\n              <a href=\"#\" class=\"resource-link\">浏览资源</a>\r\n            </div>\r\n          </div>\r\n          <button class=\"service-btn\">资源中心</button>\r\n        </div>\r\n      </div>\r\n\r\n      <div class=\"self-help-tools\">\r\n        <h2>自助心理调适工具</h2>\r\n        <div class=\"tools-grid\">\r\n          <div v-for=\"(tool, index) in selfHelpTools\" :key=\"index\" class=\"tool-card\">\r\n            <h3>{{ tool.name }}</h3>\r\n            <p>{{ tool.description }}</p>\r\n            <button class=\"service-btn\">开始使用</button>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 学生风采板块 -->\r\n    <div v-else-if=\"activeTab === 'student-showcase'\" class=\"student-showcase\">\r\n      <h2>学生风采</h2>\r\n      \r\n      <div class=\"outstanding-students\">\r\n        <h3>优秀学生事迹</h3>\r\n        <div class=\"students-grid\">\r\n          <div v-for=\"(student, index) in outstandingStudents\" :key=\"index\" class=\"student-card\">\r\n            <div class=\"student-image\">\r\n              <img :src=\"student.image\" :alt=\"student.name\">\r\n            </div>\r\n            <div class=\"student-info\">\r\n              <h4>{{ student.name }}</h4>\r\n              <p class=\"student-class\">{{ student.class }}</p>\r\n              <p class=\"student-achievement\">{{ student.achievement }}</p>\r\n              <p class=\"student-story\">{{ student.story }}</p>\r\n              <button class=\"service-btn\">阅读全文</button>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <div class=\"student-works\">\r\n        <h3>学生作品展示</h3>\r\n        <div class=\"works-categories\">\r\n          <button \r\n            v-for=\"category in workCategories\" \r\n            :key=\"category.id\"\r\n            :class=\"['category-btn', { active: activeWorkCategory === category.id }]\"\r\n            @click=\"activeWorkCategory = category.id\"\r\n          >\r\n            {{ category.name }}\r\n          </button>\r\n        </div>\r\n\r\n\r\n\r\n        <div class=\"works-gallery\">\r\n          <div v-for=\"(work, index) in filteredWorks\" :key=\"index\" class=\"work-item\">\r\n            <div class=\"work-image\">\r\n              <img :src=\"work.image\" :alt=\"work.title\">\r\n            </div>\r\n            <div class=\"work-info\">\r\n              <h4>{{ work.title }}</h4>\r\n              <p class=\"work-author\">作者：{{ work.author }} | {{ work.class }}</p>\r\n              <p class=\"work-desc\">{{ work.description }}</p>\r\n              <div class=\"work-tags\">\r\n                <span v-for=\"(tag, tagIndex) in work.tags\" :key=\"tagIndex\" class=\"tag\">{{ tag }}</span>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <div class=\"competition-awards\">\r\n        <h3>竞赛获奖</h3>\r\n        <div class=\"awards-table\">\r\n          <table>\r\n            <thead>\r\n              <tr>\r\n                <th>竞赛名称</th>\r\n                <th>获奖学生</th>\r\n                <th>奖项</th>\r\n                <th>指导教师</th>\r\n                <th>获奖日期</th>\r\n              </tr>\r\n            </thead>\r\n            <tbody>\r\n              <tr v-for=\"(award, index) in competitionAwards\" :key=\"index\">\r\n                <td>{{ award.competition }}</td>\r\n                <td>{{ award.student }}</td>\r\n                <td>{{ award.prize }}</td>\r\n                <td>{{ award.teacher }}</td>\r\n                <td>{{ award.date }}</td>\r\n              </tr>\r\n            </tbody>\r\n          </table>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script setup>\r\nimport { ref, computed } from 'vue';\r\n\r\nconst activeTab = ref('activities');\r\nconst activeWorkCategory = ref('all');\r\n\r\nconst tabs = ref([\r\n  { id: 'activities', name: '德育活动' },\r\n  { id: 'mental-health', name: '心理健康' },\r\n  { id: 'student-showcase', name: '学生风采' }\r\n]);\r\n\r\n// 德育活动数据\r\nconst moralActivities = ref([\r\n  {\r\n    title: '爱国主义教育展览',\r\n    description: '通过图片、文物展示和互动体验，深入开展爱国主义教育，增强学生的爱国情怀。',\r\n    date: '2023-09-28',\r\n    time: '09:00 - 16:00',\r\n    location: '学校展览馆',\r\n    image: '/images/art-festival.svg'\r\n  },\r\n  {\r\n    title: '感恩教育主题活动',\r\n    description: '通过演讲、分享和实践活动，培养学生感恩意识，学会感恩父母、老师和社会。',\r\n    date: '2023-10-12',\r\n    time: '14:30 - 16:30',\r\n    location: '学校礼堂',\r\n    image: '/images/reading-month.svg'\r\n  },\r\n  {\r\n    title: '诚信教育系列讲座',\r\n    description: '邀请专家学者开展诚信教育讲座，引导学生树立正确的诚信观念。',\r\n    date: '2023-11-05',\r\n    time: '15:00 - 16:30',\r\n    location: '学术报告厅',\r\n    image: '/images/tech-innovation.svg'\r\n  },\r\n  {\r\n    title: '文明礼仪培训',\r\n    description: '开展文明礼仪培训，提高学生的文明素养和行为规范。',\r\n    date: '2023-11-20',\r\n    time: '13:30 - 15:30',\r\n    location: '多功能厅',\r\n    image: '/images/art-festival.svg'\r\n  }\r\n]);\r\n\r\nconst themeClassMeetings = ref([\r\n  {\r\n    title: '传承中华美德',\r\n    description: '探讨中华传统美德的现代价值，引导学生传承和弘扬中华优秀传统文化。',\r\n    date: '2023-09-15',\r\n    tags: ['传统文化', '道德教育']\r\n  },\r\n  {\r\n    title: '网络文明与安全',\r\n    description: '讨论网络使用中的文明行为和安全问题，培养学生良好的网络素养。',\r\n    date: '2023-10-08',\r\n    tags: ['网络安全', '文明上网']\r\n  },\r\n  {\r\n    title: '生命教育',\r\n    description: '通过案例分享和讨论，引导学生珍爱生命，尊重生命。',\r\n    date: '2023-10-22',\r\n    tags: ['生命价值', '心理健康']\r\n  },\r\n  {\r\n    title: '环保意识与行动',\r\n    description: '讨论环境保护的重要性，鼓励学生从小事做起，保护环境。',\r\n    date: '2023-11-12',\r\n    tags: ['环保', '可持续发展']\r\n  }\r\n]);\r\n\r\n// 心理健康数据\r\nconst mentalHealthWorkshops = ref([\r\n  {\r\n    title: '青少年压力管理与情绪调节',\r\n    date: '2023-12-05',\r\n    speaker: '张心理 教授'\r\n  },\r\n  {\r\n    title: '如何建立健康的人际关系',\r\n    date: '2023-12-15',\r\n    speaker: '李咨询 老师'\r\n  },\r\n  {\r\n    title: '考试焦虑的应对策略',\r\n    date: '2023-12-25',\r\n    speaker: '王辅导 心理咨询师'\r\n  }\r\n]);\r\n\r\nconst resourceCategories = ref([\r\n  {\r\n    name: '心理健康书籍',\r\n    description: '精选心理健康相关书籍推荐，涵盖自我认知、情绪管理等多个方面。'\r\n  },\r\n  {\r\n    name: '心理健康视频',\r\n    description: '提供心理健康教育视频，包括专家讲座、案例分析等内容。'\r\n  },\r\n  {\r\n    name: '心理健康文章',\r\n    description: '收集心理健康相关文章，帮助学生了解心理健康知识。'\r\n  }\r\n]);\r\n\r\nconst selfHelpTools = ref([\r\n  {\r\n    name: '情绪日记',\r\n    description: '记录每日情绪变化，帮助识别情绪模式和触发因素。'\r\n  },\r\n  {\r\n    name: '放松训练',\r\n    description: '提供呼吸放松、肌肉放松等训练方法，帮助缓解压力和焦虑。'\r\n  },\r\n  {\r\n    name: '认知重构',\r\n    description: '学习识别和挑战消极思维模式，建立更健康的思维方式。'\r\n  },\r\n  {\r\n    name: '目标设定',\r\n    description: '帮助设定明确、可行的目标，增强成就感和自信心。'\r\n  }\r\n]);\r\n\r\n// 学生风采数据\r\nconst outstandingStudents = ref([\r\n  {\r\n    name: '李明',\r\n    class: '高二(3)班',\r\n    achievement: '全国数学奥林匹克竞赛一等奖',\r\n    story: '李明同学自小对数学有浓厚兴趣，通过刻苦学习和不懈努力，在全国数学奥林匹克竞赛中获得一等奖。他不仅学习成绩优异，还积极参与学校各项活动，是同学们学习的榜样。',\r\n    image: '/images/art-festival.svg'\r\n  },\r\n  {\r\n    name: '张华',\r\n    class: '高三(1)班',\r\n    achievement: '省级三好学生、校学生会主席',\r\n    story: '张华同学品学兼优，担任校学生会主席期间，组织了多项有意义的校园活动，展现了出色的领导能力和组织能力。她关心集体，乐于助人，深受师生喜爱。',\r\n    image: '/images/reading-month.svg'\r\n  },\r\n  {\r\n    name: '王强',\r\n    class: '高一(5)班',\r\n    achievement: '校园歌手大赛冠军、志愿服务先进个人',\r\n    story: '王强同学多才多艺，在校园歌手大赛中获得冠军。同时，他积极参与志愿服务活动，利用周末时间到敬老院陪伴老人，展现了当代青年的责任感和爱心。',\r\n    image: '/images/tech-innovation.svg'\r\n  }\r\n]);\r\n\r\nconst workCategories = ref([\r\n  { id: 'all', name: '全部作品' },\r\n  { id: 'writing', name: '文学创作' },\r\n  { id: 'art', name: '美术作品' },\r\n  { id: 'science', name: '科技创新' },\r\n  { id: 'photography', name: '摄影作品' }\r\n]);\r\n\r\nconst studentWorks = ref([\r\n  {\r\n    title: '《我的家乡》',\r\n    author: '刘芳',\r\n    class: '高一(2)班',\r\n    description: '这篇散文描绘了作者家乡的自然风光和人文风情，语言优美，情感真挚。',\r\n    image: '/images/art-festival.svg',\r\n    category: 'writing',\r\n    tags: ['散文', '乡土情怀']\r\n  },\r\n  {\r\n    title: '《春天》',\r\n    author: '张明',\r\n    class: '高二(4)班',\r\n    description: '这幅水彩画生动地表现了春天的生机和活力，色彩明快，构图和谐。',\r\n    image: '/images/reading-month.svg',\r\n    category: 'art',\r\n    tags: ['水彩画', '风景']\r\n  },\r\n  {\r\n    title: '智能垃圾分类系统',\r\n    author: '李强',\r\n    class: '高三(5)班',\r\n    description: '这个科技创新项目利用图像识别技术实现垃圾自动分类，具有很高的实用价值。',\r\n    image: '/images/tech-innovation.svg',\r\n    category: 'science',\r\n    tags: ['人工智能', '环保']\r\n  },\r\n  {\r\n    title: '《瞬间》',\r\n    author: '王丽',\r\n    class: '高二(1)班',\r\n    description: '这组摄影作品捕捉了校园生活中的精彩瞬间，画面真实，情感丰富。',\r\n    image: '/images/art-festival.svg',\r\n    category: 'photography',\r\n    tags: ['校园生活', '纪实摄影']\r\n  },\r\n  {\r\n    title: '《未来城市》',\r\n    author: '赵阳',\r\n    class: '高一(3)班',\r\n    description: '这幅科幻画描绘了作者心目中的未来城市，想象力丰富，技法娴熟。',\r\n    image: '/images/reading-month.svg',\r\n    category: 'art',\r\n    tags: ['科幻', '创意']\r\n  },\r\n  {\r\n    title: '《成长的烦恼》',\r\n    author: '陈静',\r\n    class: '高二(2)班',\r\n    description: '这篇小说真实地描写了青少年成长过程中面临的困惑和挑战，情节生动，人物形象鲜明。',\r\n    image: '/images/tech-innovation.svg',\r\n    category: 'writing',\r\n    tags: ['小说', '青春']\r\n  }\r\n]);\r\n\r\nconst competitionAwards = ref([\r\n  {\r\n    competition: '全国中学生物理竞赛',\r\n    student: '张伟',\r\n    prize: '一等奖',\r\n    teacher: '李教授',\r\n    date: '2023-05-15'\r\n  },\r\n  {\r\n    competition: