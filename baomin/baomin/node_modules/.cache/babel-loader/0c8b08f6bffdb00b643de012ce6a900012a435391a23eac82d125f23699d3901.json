{"ast":null,"code":"export default {\n  name: 'SchoolInfo',\n  data() {\n    return {\n      majors: [{\n        name: '计算机应用技术',\n        description: '培养具备计算机应用基础知识和专业技能的技术人才'\n      }, {\n        name: '电子商务',\n        description: '培养能够从事电子商务运营、网络营销的专业人才'\n      }, {\n        name: '会计',\n        description: '培养掌握现代会计理论与实务的专业人才'\n      }, {\n        name: '机电一体化技术',\n        description: '培养具备机电设备操作维护能力的技术人才'\n      }, {\n        name: '汽车运用与维修',\n        description: '培养从事汽车检测、维修与服务的专业人才'\n      }, {\n        name: '幼儿教育',\n        description: '培养具备学前教育专业知识与能力的师资人才'\n      }],\n      campusImages: [{\n        url: require('../assets/img/sy/carousel1.jpg'),\n        desc: '校园环境1'\n      }, {\n        url: require('../assets/img/sy/carousel2.jpg'),\n        desc: '校园环境2'\n      }, {\n        url: require('../assets/img/sy/carousel3.jpg'),\n        desc: '校园环境3'\n      }]\n    };\n  }\n};","map":{"version":3,"names":["name","data","majors","description","campusImages","url","require","desc"],"sources":["src/components/SchoolInfo.vue"],"sourcesContent":["<template>\r\n  <div class=\"school-info-container\">\r\n    <h2 class=\"section-title\">学校概况</h2>\r\n    \r\n    <div class=\"section\">\r\n      <h3>学校简介</h3>\r\n      <div class=\"content\">\r\n        <p>深圳市宝民职业技术学校创建于2005年，是一所经深圳市教育局批准成立的全日制中等职业学校。学校位于深圳市宝安区石岩街道，占地面积约30000平方米，建筑面积20000平方米。</p>\r\n        <p>学校秉承\"以人为本，德技并修\"的办学理念，致力于培养具有良好职业道德、扎实专业技能和创新精神的高素质技能型人才。多年来，学校坚持产教融合、校企合作的办学模式，为深圳地区的经济建设和社会发展输送了大量优秀毕业生。</p>\r\n      </div>\r\n    </div>\r\n    \r\n    <div class=\"section\">\r\n      <h3>办学特色</h3>\r\n      <div class=\"content\">\r\n        <div class=\"feature-item\">\r\n          <h4>产教融合</h4>\r\n          <p>学校与100多家企业建立了稳定的合作关系，开展订单培养、实习就业、师资培训等多种形式的校企合作。</p>\r\n        </div>\r\n        <div class=\"feature-item\">\r\n          <h4>双师型教师队伍</h4>\r\n          <p>学校拥有一支专业素质高、实践能力强的\"双师型\"教师队伍，90%以上的专业教师具有企业工作经验。</p>\r\n        </div>\r\n        <div class=\"feature-item\">\r\n          <h4>现代化实训设施</h4>\r\n          <p>学校建有30多个专业实训室，配备先进的教学设备和软件，为学生提供良好的实践环境。</p>\r\n        </div>\r\n      </div>\r\n    </div>\r\n    \r\n    <div class=\"section\">\r\n      <h3>专业设置</h3>\r\n      <div class=\"content\">\r\n        <el-row :gutter=\"20\">\r\n          <el-col :span=\"8\" v-for=\"(major, index) in majors\" :key=\"index\">\r\n            <el-card class=\"major-card\" shadow=\"hover\">\r\n              <div class=\"major-name\">{{ major.name }}</div>\r\n              <div class=\"major-desc\">{{ major.description }}</div>\r\n            </el-card>\r\n          </el-col>\r\n        </el-row>\r\n      </div>\r\n    </div>\r\n    \r\n    <div class=\"section\">\r\n      <h3>校园环境</h3>\r\n      <div class=\"content\">\r\n        <el-carousel :interval=\"4000\" type=\"card\" height=\"300px\">\r\n          <el-carousel-item v-for=\"(item, index) in campusImages\" :key=\"index\">\r\n            <img :src=\"item.url\" :alt=\"item.desc\" class=\"campus-img\">\r\n          </el-carousel-item>\r\n        </el-carousel>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'SchoolInfo',\r\n  data() {\r\n    return {\r\n      majors: [\r\n        {\r\n          name: '计算机应用技术',\r\n          description: '培养具备计算机应用基础知识和专业技能的技术人才'\r\n        },\r\n        {\r\n          name: '电子商务',\r\n          description: '培养能够从事电子商务运营、网络营销的专业人才'\r\n        },\r\n        {\r\n          name: '会计',\r\n          description: '培养掌握现代会计理论与实务的专业人才'\r\n        },\r\n        {\r\n          name: '机电一体化技术',\r\n          description: '培养具备机电设备操作维护能力的技术人才'\r\n        },\r\n        {\r\n          name: '汽车运用与维修',\r\n          description: '培养从事汽车检测、维修与服务的专业人才'\r\n        },\r\n        {\r\n          name: '幼儿教育',\r\n          description: '培养具备学前教育专业知识与能力的师资人才'\r\n        }\r\n      ],\r\n      campusImages: [\r\n        { url: require('../assets/img/sy/carousel1.jpg'), desc: '校园环境1' },\r\n        { url: require('../assets/img/sy/carousel2.jpg'), desc: '校园环境2' },\r\n        { url: require('../assets/img/sy/carousel3.jpg'), desc: '校园环境3' }\r\n      ]\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.school-info-container {\r\n  padding: 20px;\r\n  background-color: #fff;\r\n  border-radius: 4px;\r\n  box-shadow: 0 2px 12px 0 rgba(0, 0, 0, 0.1);\r\n}\r\n\r\n.section-title {\r\n  color: #0d47a1;\r\n  text-align: center;\r\n  margin-bottom: 30px;\r\n  font-size: 24px;\r\n}\r\n\r\n.section {\r\n  margin-bottom: 40px;\r\n}\r\n\r\nh3 {\r\n  color: #0d47a1;\r\n  border-left: 4px solid #0d47a1;\r\n  padding-left: 10px;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.content {\r\n  line-height: 1.8;\r\n  color: #333;\r\n}\r\n\r\n.feature-item {\r\n  margin-bottom: 20px;\r\n}\r\n\r\nh4 {\r\n  color: #0d47a1;\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.major-card {\r\n  height: 150px;\r\n  margin-bottom: 20px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  justify-content: center;\r\n}\r\n\r\n.major-name {\r\n  font-size: 18px;\r\n  font-weight: bold;\r\n  color: #0d47a1;\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.major-desc {\r\n  color: #666;\r\n  line-height: 1.5;\r\n}\r\n\r\n.campus-img {\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: cover;\r\n}\r\n</style>"],"mappings":"AA0DA;EACAA,IAAA;EACAC,KAAA;IACA;MACAC,MAAA,GACA;QACAF,IAAA;QACAG,WAAA;MACA,GACA;QACAH,IAAA;QACAG,WAAA;MACA,GACA;QACAH,IAAA;QACAG,WAAA;MACA,GACA;QACAH,IAAA;QACAG,WAAA;MACA,GACA;QACAH,IAAA;QACAG,WAAA;MACA,GACA;QACAH,IAAA;QACAG,WAAA;MACA,EACA;MACAC,YAAA,GACA;QAAAC,GAAA,EAAAC,OAAA;QAAAC,IAAA;MAAA,GACA;QAAAF,GAAA,EAAAC,OAAA;QAAAC,IAAA;MAAA,GACA;QAAAF,GAAA,EAAAC,OAAA;QAAAC,IAAA;MAAA;IAEA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}