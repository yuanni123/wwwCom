{"ast":null,"code":"//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n\nimport MainNavigation from '../components/MainNavigation.vue';\nexport default {\n  name: 'NewsCenter',\n  components: {\n    MainNavigation\n  },\n  data() {\n    return {\n      activeTab: 'school-news',\n      // 学校新闻数据，添加图片字段\n      schoolNews: [{\n        id: 1,\n        title: '我校举行2024年春季开学典礼',\n        date: '2024-03-01',\n        content: '3月1日上午，我校在操场隆重举行2024年春季开学典礼。校领导、全体教职工及学生参加了此次典礼。校长在典礼上发表了热情洋溢的讲话，对新学期提出了新的要求和期望。',\n        // 使用require引入图片\n        image: require('@/assets/img/news/开学典礼.jpg')\n      }, {\n        id: 2,\n        title: '我校学生在市技能大赛中获得佳绩',\n        date: '2024-02-15',\n        content: '在近日举行的深圳市职业技能大赛中，我校学生表现优异，共获得金牌3枚、银牌5枚、铜牌7枚的好成绩。这充分展示了我校职业教育的教学成果和学生的专业技能水平。',\n        image: require('@/assets/img/news/技能大赛.jpg')\n      }, {\n        id: 3,\n        title: '校企合作签约仪式成功举行',\n        date: '2024-01-20',\n        content: '1月20日，我校与多家知名企业举行校企合作签约仪式。此次合作将为学生提供更多实习和就业机会，也将促进学校教学与企业需求的深度融合，实现校企双赢。',\n        image: require('@/assets/img/news/校企合作.jpg')\n      }],\n      // 通知公告数据，添加图片字段\n      announcements: [{\n        id: 1,\n        title: '关于2024年春季学期学费缴纳的通知',\n        date: '2024-02-20',\n        content: '请各位同学于2024年2月25日前完成学费缴纳。可通过学校官方网站在线支付系统或到学校财务处现场缴纳。逾期未缴纳者，将按学校相关规定处理。',\n        image: require('@/assets/img/news/学费通知.jpg')\n      }, {\n        id: 2,\n        title: '2024年春季学期教材发放安排',\n        date: '2024-02-22',\n        content: '2024年春季学期教材将于3月1日至3月3日在各班级教室发放，请各班班长按照安排时间到教材科领取并组织发放。',\n        image: require('@/assets/img/news/教材发放.jpg')\n      }, {\n        id: 3,\n        title: '关于开展校园文化节活动的通知',\n        date: '2024-03-05',\n        content: '为丰富校园文化生活，展示学生才艺，学校将于3月15日至3月25日举办校园文化节。活动包括歌唱比赛、演讲比赛、书法展览等多项内容，欢迎广大师生积极参与。',\n        image: require('@/assets/img/news/文化节.jpg')\n      }],\n      // 招生信息数据，添加图片字段\n      admissionInfo: [{\n        id: 1,\n        title: '2024年秋季招生简章',\n        date: '2024-03-10',\n        content: '2024年秋季招生工作即将开始，我校计划招收新生1200名。招生专业包括计算机应用、电子商务、幼儿教育等。详细招生要求和报名方式请查看招生简章。',\n        image: require('@/assets/img/news/招生简章.jpg')\n      }, {\n        id: 2,\n        title: '2024年春季招生咨询会安排',\n        date: '2024-01-15',\n        content: '我校将于1月20日至2月10日在各区举办多场招生咨询会，为考生和家长提供专业咨询服务。具体时间和地点请关注学校官网或咨询招生办电话。',\n        image: require('@/assets/img/news/招生咨询.jpg')\n      }, {\n        id: 3,\n        title: '关于接受中职学校转学生的通知',\n        date: '2024-02-25',\n        content: '我校现接受部分中职学校转学生，名额有限。有意向的学生请携带相关材料到学校招生办公室咨询和办理相关手续。',\n        image: require('@/assets/img/news/转学通知.jpg')\n      }]\n    };\n  },\n  created() {\n    // 根据URL查询参数设置当前活动的标签页\n    const tab = this.$route.query.tab;\n    if (tab) {\n      this.activeTab = tab;\n    } else {\n      this.activeTab = 'news';\n    }\n  },\n  watch: {\n    // 监听路由变化，更新活动标签页\n    '$route.query.tab': function (newTab) {\n      if (newTab) {\n        this.activeTab = newTab;\n      } else {\n        this.activeTab = 'news';\n      }\n    }\n  },\n  methods: {\n    handleSelect(key) {\n      this.activeTab = key;\n\n      // 修复路由导航错误\n      const currentQuery = this.$route.query.tab;\n      try {\n        if (key === 'news') {\n          if (currentQuery) {\n            // 只有当需要移除查询参数时才导航\n            this.$router.push({\n              path: '/news-center',\n              query: {}\n            }).catch(err => {\n              if (err.name !== 'NavigationDuplicated') {\n                throw err;\n              }\n            });\n          }\n        } else if (key !== currentQuery) {\n          // 只有当切换到不同的标签页时才导航\n          this.$router.push({\n            path: '/news-center',\n            query: {\n              tab: key\n            }\n          }).catch(err => {\n            if (err.name !== 'NavigationDuplicated') {\n              throw err;\n            }\n          });\n        }\n      } catch (err) {\n        // 忽略导航重复错误\n        if (err.name !== 'NavigationDuplicated') {\n          console.error(err);\n        }\n      }\n    },\n    viewNewsDetail(id) {\n      console.log('查看新闻详情:', id);\n      // 这里可以跳转到新闻详情页\n      // this.$router.push({ path: `/news-detail/${id}` });\n    },\n    viewNoticeDetail(id) {\n      console.log('查看通知详情:', id);\n      // 这里可以跳转到通知详情页或显示弹窗\n    },\n    viewMediaDetail(id) {\n      console.log('查看媒体报道详情:', id);\n      // 这里可以跳转到媒体报道详情页\n    }\n  }\n};","map":{"version":3,"names":["MainNavigation","name","components","data","activeTab","schoolNews","id","title","date","content","image","require","announcements","admissionInfo","created","tab","$route","query","watch","$route.query.tab","newTab","methods","handleSelect","key","currentQuery","$router","push","path","catch","err","console","error","viewNewsDetail","log","viewNoticeDetail","viewMediaDetail"],"sources":["src/views/NewsCenter.vue"],"sourcesContent":["<template>\r\n  <div class=\"news-center-page\">\r\n    <!-- 使用导航栏组件 -->\r\n    <main-navigation active-index=\"2\"></main-navigation>\r\n    \r\n    <!-- 添加横幅图片 -->\r\n    <div class=\"banner-container\">\r\n      <el-image \r\n        src=\"https://via.placeholder.com/1920x400?text=宝民技工学校新闻中心\" \r\n        fit=\"cover\" \r\n        class=\"banner-image\">\r\n      </el-image>\r\n      <div class=\"banner-overlay\">\r\n        <h1>新闻中心</h1>\r\n        <p>了解学校最新动态与公告</p>\r\n      </div>\r\n    </div>\r\n    \r\n    <el-container class=\"main-container\">\r\n      <el-aside width=\"220px\" class=\"sidebar\">\r\n        <!-- 自定义菜单 -->\r\n        <div class=\"custom-menu\">\r\n          <div class=\"menu-header\">\r\n            <h2>新闻中心</h2>\r\n          </div>\r\n          <div class=\"menu-items\">\r\n            <div \r\n              class=\"menu-item\" \r\n              :class=\"{ 'active': activeTab === 'news' }\"\r\n              @click=\"handleSelect('news')\">\r\n              校园新闻\r\n              <div v-if=\"activeTab === 'news'\" class=\"active-indicator\"></div>\r\n            </div>\r\n            <div \r\n              class=\"menu-item\" \r\n              :class=\"{ 'active': activeTab === 'notice' }\"\r\n              @click=\"handleSelect('notice')\">\r\n              通知公告\r\n              <div v-if=\"activeTab === 'notice'\" class=\"active-indicator\"></div>\r\n            </div>\r\n            <div \r\n              class=\"menu-item\" \r\n              :class=\"{ 'active': activeTab === 'media' }\"\r\n              @click=\"handleSelect('media')\">\r\n              媒体报道\r\n              <div v-if=\"activeTab === 'media'\" class=\"active-indicator\"></div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </el-aside>\r\n      \r\n      <el-main class=\"main-content\">\r\n        <!-- 校园新闻 -->\r\n        <div v-show=\"activeTab === 'news'\" class=\"content-section\">\r\n          <section class=\"section news\">\r\n            <div class=\"section-title\">\r\n              <h2>校园新闻</h2>\r\n            </div>\r\n            <div class=\"news-content\">\r\n              <el-timeline>\r\n                <el-timeline-item\r\n                  v-for=\"news in newsList\"\r\n                  :key=\"news.id\"\r\n                  :timestamp=\"news.date\"\r\n                  placement=\"top\"\r\n                >\r\n                  <el-card class=\"news-card\">\r\n                    <h3>{{ news.title }}</h3>\r\n                    <p>{{ news.summary }}</p>\r\n                    <div class=\"news-image\" v-if=\"news.image\">\r\n                      <el-image :src=\"news.image\" fit=\"cover\"></el-image>\r\n                    </div>\r\n                    <el-button type=\"text\" @click=\"viewNewsDetail(news.id)\">阅读更多</el-button>\r\n                  </el-card>\r\n                </el-timeline-item>\r\n              </el-timeline>\r\n            </div>\r\n          </section>\r\n        </div>\r\n\r\n        <!-- 通知公告 -->\r\n        <div v-show=\"activeTab === 'notice'\" class=\"content-section\">\r\n          <section class=\"section notice\">\r\n            <div class=\"section-title\">\r\n              <h2>通知公告</h2>\r\n            </div>\r\n            <div class=\"notice-content\">\r\n              <el-table\r\n                :data=\"noticeList\"\r\n                style=\"width: 100%\">\r\n                <el-table-column\r\n                  prop=\"date\"\r\n                  label=\"发布日期\"\r\n                  width=\"180\">\r\n                </el-table-column>\r\n                <el-table-column\r\n                  prop=\"title\"\r\n                  label=\"标题\">\r\n                </el-table-column>\r\n                <el-table-column\r\n                  fixed=\"right\"\r\n                  label=\"操作\"\r\n                  width=\"120\">\r\n                  <template slot-scope=\"scope\">\r\n                    <el-button @click=\"viewNoticeDetail(scope.row.id)\" type=\"text\" size=\"small\">查看</el-button>\r\n                  </template>\r\n                </el-table-column>\r\n              </el-table>\r\n            </div>\r\n          </section>\r\n        </div>\r\n\r\n        <!-- 媒体报道 -->\r\n        <div v-show=\"activeTab === 'media'\" class=\"content-section\">\r\n          <section class=\"section media\">\r\n            <div class=\"section-title\">\r\n              <h2>媒体报道</h2>\r\n            </div>\r\n            <div class=\"media-content\">\r\n              <el-row :gutter=\"30\">\r\n                <el-col :xs=\"24\" :sm=\"12\" :md=\"8\" v-for=\"media in mediaList\" :key=\"media.id\" class=\"media-col\">\r\n                  <el-card class=\"media-card\" shadow=\"hover\">\r\n                    <div class=\"media-image\">\r\n                      <el-image :src=\"media.image\" fit=\"cover\"></el-image>\r\n                    </div>\r\n                    <div class=\"media-info\">\r\n                      <h3>{{ media.title }}</h3>\r\n                      <p class=\"media-source\">来源: {{ media.source }}</p>\r\n                      <p class=\"media-date\">{{ media.date }}</p>\r\n                      <p class=\"media-summary\">{{ media.summary }}</p>\r\n                      <el-button type=\"text\" @click=\"viewMediaDetail(media.id)\">阅读全文</el-button>\r\n                    </div>\r\n                  </el-card>\r\n                </el-col>\r\n              </el-row>\r\n            </div>\r\n          </section>\r\n        </div>\r\n      </el-main>\r\n    </el-container>\r\n    \r\n    <el-footer class=\"footer\">\r\n      <div class=\"footer-content\">\r\n        <p>地址：深圳市宝安区松白路7022号宝民技工学校</p>\r\n        <div class=\"copyright\">\r\n          © 2025 深圳市宝民技工学校 版权所有\r\n        </div>\r\n      </div>\r\n    </el-footer>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport MainNavigation from '../components/MainNavigation.vue'\r\n\r\nexport default {\r\n  name: 'NewsCenter',\r\n  components: {\r\n    MainNavigation\r\n  },\r\n  data() {\r\n    return {\r\n      activeTab: 'school-news',\r\n      // 学校新闻数据，添加图片字段\r\n      schoolNews: [\r\n        {\r\n          id: 1,\r\n          title: '我校举行2024年春季开学典礼',\r\n          date: '2024-03-01',\r\n          content: '3月1日上午，我校在操场隆重举行2024年春季开学典礼。校领导、全体教职工及学生参加了此次典礼。校长在典礼上发表了热情洋溢的讲话，对新学期提出了新的要求和期望。',\r\n          // 使用require引入图片\r\n          image: require('@/assets/img/news/开学典礼.jpg')\r\n        },\r\n        {\r\n          id: 2,\r\n          title: '我校学生在市技能大赛中获得佳绩',\r\n          date: '2024-02-15',\r\n          content: '在近日举行的深圳市职业技能大赛中，我校学生表现优异，共获得金牌3枚、银牌5枚、铜牌7枚的好成绩。这充分展示了我校职业教育的教学成果和学生的专业技能水平。',\r\n          image: require('@/assets/img/news/技能大赛.jpg')\r\n        },\r\n        {\r\n          id: 3,\r\n          title: '校企合作签约仪式成功举行',\r\n          date: '2024-01-20',\r\n          content: '1月20日，我校与多家知名企业举行校企合作签约仪式。此次合作将为学生提供更多实习和就业机会，也将促进学校教学与企业需求的深度融合，实现校企双赢。',\r\n          image: require('@/assets/img/news/校企合作.jpg')\r\n        }\r\n      ],\r\n      // 通知公告数据，添加图片字段\r\n      announcements: [\r\n        {\r\n          id: 1,\r\n          title: '关于2024年春季学期学费缴纳的通知',\r\n          date: '2024-02-20',\r\n          content: '请各位同学于2024年2月25日前完成学费缴纳。可通过学校官方网站在线支付系统或到学校财务处现场缴纳。逾期未缴纳者，将按学校相关规定处理。',\r\n          image: require('@/assets/img/news/学费通知.jpg')\r\n        },\r\n        {\r\n          id: 2,\r\n          title: '2024年春季学期教材发放安排',\r\n          date: '2024-02-22',\r\n          content: '2024年春季学期教材将于3月1日至3月3日在各班级教室发放，请各班班长按照安排时间到教材科领取并组织发放。',\r\n          image: require('@/assets/img/news/教材发放.jpg')\r\n        },\r\n        {\r\n          id: 3,\r\n          title: '关于开展校园文化节活动的通知',\r\n          date: '2024-03-05',\r\n          content: '为丰富校园文化生活，展示学生才艺，学校将于3月15日至3月25日举办校园文化节。活动包括歌唱比赛、演讲比赛、书法展览等多项内容，欢迎广大师生积极参与。',\r\n          image: require('@/assets/img/news/文化节.jpg')\r\n        }\r\n      ],\r\n      // 招生信息数据，添加图片字段\r\n      admissionInfo: [\r\n        {\r\n          id: 1,\r\n          title: '2024年秋季招生简章',\r\n          date: '2024-03-10',\r\n          content: '2024年秋季招生工作即将开始，我校计划招收新生1200名。招生专业包括计算机应用、电子商务、幼儿教育等。详细招生要求和报名方式请查看招生简章。',\r\n          image: require('@/assets/img/news/招生简章.jpg')\r\n        },\r\n        {\r\n          id: 2,\r\n          title: '2024年春季招生咨询会安排',\r\n          date: '2024-01-15',\r\n          content: '我校将于1月20日至2月10日在各区举办多场招生咨询会，为考生和家长提供专业咨询服务。具体时间和地点请关注学校官网或咨询招生办电话。',\r\n          image: require('@/assets/img/news/招生咨询.jpg')\r\n        },\r\n        {\r\n          id: 3,\r\n          title: '关于接受中职学校转学生的通知',\r\n          date: '2024-02-25',\r\n          content: '我校现接受部分中职学校转学生，名额有限。有意向的学生请携带相关材料到学校招生办公室咨询和办理相关手续。',\r\n          image: require('@/assets/img/news/转学通知.jpg')\r\n        }\r\n      ]\r\n    }\r\n  },\r\n  created() {\r\n    // 根据URL查询参数设置当前活动的标签页\r\n    const tab = this.$route.query.tab;\r\n    if (tab) {\r\n      this.activeTab = tab;\r\n    } else {\r\n      this.activeTab = 'news';\r\n    }\r\n  },\r\n  watch: {\r\n    // 监听路由变化，更新活动标签页\r\n    '$route.query.tab': function(newTab) {\r\n      if (newTab) {\r\n        this.activeTab = newTab;\r\n      } else {\r\n        this.activeTab = 'news';\r\n      }\r\n    }\r\n  },\r\n  methods: {\r\n    handleSelect(key) {\r\n      this.activeTab = key;\r\n      \r\n      // 修复路由导航错误\r\n      const currentQuery = this.$route.query.tab;\r\n      \r\n      try {\r\n        if (key === 'news') {\r\n          if (currentQuery) {\r\n            // 只有当需要移除查询参数时才导航\r\n            this.$router.push({ path: '/news-center', query: {} }).catch(err => {\r\n              if (err.name !== 'NavigationDuplicated') {\r\n                throw err;\r\n              }\r\n            });\r\n          }\r\n        } else if (key !== currentQuery) {\r\n          // 只有当切换到不同的标签页时才导航\r\n          this.$router.push({ path: '/news-center', query: { tab: key } }).catch(err => {\r\n            if (err.name !== 'NavigationDuplicated') {\r\n              throw err;\r\n            }\r\n          });\r\n        }\r\n      } catch (err) {\r\n        // 忽略导航重复错误\r\n        if (err.name !== 'NavigationDuplicated') {\r\n          console.error(err);\r\n        }\r\n      }\r\n    },\r\n    viewNewsDetail(id) {\r\n      console.log('查看新闻详情:', id);\r\n      // 这里可以跳转到新闻详情页\r\n      // this.$router.push({ path: `/news-detail/${id}` });\r\n    },\r\n    viewNoticeDetail(id) {\r\n      console.log('查看通知详情:', id);\r\n      // 这里可以跳转到通知详情页或显示弹窗\r\n    },\r\n    viewMediaDetail(id) {\r\n      console.log('查看媒体报道详情:', id);\r\n      // 这里可以跳转到媒体报道详情页\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n/* 复用学校概况页面的样式，确保一致性 */\r\n.news-center-page {\r\n  displa