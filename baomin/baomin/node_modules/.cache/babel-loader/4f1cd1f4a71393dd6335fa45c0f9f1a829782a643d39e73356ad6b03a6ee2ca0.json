{"ast":null,"code":"//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n\nexport default {\n  name: 'MoralEducation',\n  data() {\n    return {\n      activeTab: 'activities',\n      dialogVisible: false,\n      selectedArt: null,\n      moralActivities: [{\n        id: 1,\n        title: '爱国主义教育主题班会',\n        date: '2023-05-20',\n        description: '各班级开展了以\"传承红色基因，争做时代新人\"为主题的班会活动，通过观看爱国主义教育影片、讲述革命故事等形式，激发学生的爱国情怀。',\n        image: require('../assets/img/sy/carousel1.jpg'),\n        category: '主题班会',\n        type: 'success',\n        color: '#67C23A'\n      }, {\n        id: 2,\n        title: '感恩教育活动',\n        date: '2023-04-15',\n        description: '学校组织了\"感恩父母、感恩师长、感恩社会\"的主题活动，学生通过写感恩信、制作感恩卡片等方式，表达对父母和老师的感谢之情。',\n        image: require('../assets/img/sy/carousel2.jpg'),\n        category: '德育活动',\n        type: 'primary',\n        color: '#409EFF'\n      }, {\n        id: 3,\n        title: '诚信教育讲座',\n        date: '2023-03-10',\n        description: '邀请了教育专家为学生开展诚信教育讲座，通过案例分析和互动讨论，引导学生树立正确的诚信观念，做一个诚实守信的人。',\n        image: require('../assets/img/sy/carousel3.jpg'),\n        category: '专题讲座',\n        type: 'warning',\n        color: '#E6A23C'\n      }],\n      mentalHealthActivities: [{\n        title: '心理健康月活动',\n        description: '学校举办了为期一个月的心理健康主题活动，包括心理健康知识讲座、心理游戏、团体辅导等多种形式，帮助学生了解心理健康知识，提高心理调适能力。',\n        date: '2023年4月',\n        image: require('../assets/img/sy/carousel1.jpg')\n      }, {\n        title: '压力管理工作坊',\n        description: '针对学生学习压力大的问题，学校心理咨询室组织了压力管理工作坊，教授学生科学的减压方法和技巧，帮助学生有效应对学习和生活中的压力。',\n        date: '2023年5月15日',\n        image: require('../assets/img/sy/carousel2.jpg')\n      }],\n      mentalHealthResources: [{\n        title: '青少年心理健康手册',\n        description: '专为中学生编写的心理健康指导手册，包含常见心理问题解析和应对方法。',\n        url: '#'\n      }, {\n        title: '情绪管理技巧',\n        description: '学习如何识别和管理自己的情绪，提高情绪调节能力。',\n        url: '#'\n      }, {\n        title: '考试焦虑应对指南',\n        description: '帮助学生克服考试焦虑，以平和的心态面对考试。',\n        url: '#'\n      }],\n      mentalHealthTips: [{\n        title: '保持规律作息',\n        content: '规律的作息时间有助于身心健康，尽量保持每天相同的起床和睡觉时间，确保充足的睡眠。'\n      }, {\n        title: '适当运动',\n        content: '每天进行适当的体育锻炼，如慢跑、散步、打球等，有助于释放压力，改善心情。'\n      }, {\n        title: '学会倾诉',\n        content: '遇到困难或烦恼时，不要一个人闷在心里，可以向信任的朋友、家人或老师倾诉，寻求支持和帮助。'\n      }],\n      excellentStudents: [{\n        name: '张明',\n        class: '计算机应用2101班',\n        photo: require('../assets/img/sy/carousel1.jpg'),\n        achievement: '2023年广东省职业技能大赛计算机应用一等奖',\n        story: '张明同学自入学以来，学习刻苦认真，专业技能出色。在备战省职业技能大赛期间，他每天坚持训练8小时以上，最终凭借扎实的基本功和创新的解题思路，获得了比赛一等奖的好成绩。'\n      }, {\n        name: '李华',\n        class: '电子商务2102班',\n        photo: require('../assets/img/sy/carousel2.jpg'),\n        achievement: '校\"三好学生\"、\"优秀学生干部\"',\n        story: '李华同学品学兼优，担任班级学习委员，积极组织同学们开展学习互助活动。在校期间，她多次获得\"三好学生\"和\"优秀学生干部\"称号，是同学们学习的榜样。'\n      }, {\n        name: '王强',\n        class: '汽车维修2103班',\n        photo: require('../assets/img/sy/carousel3.jpg'),\n        achievement: '校园志愿服务先进个人',\n        story: '王强同学热心公益，积极参与校内外各类志愿服务活动。他组织成立了\"爱心维修队\"，利用专业技能为社区居民提供家电维修服务，受到了广泛好评。'\n      }],\n      literaryWorks: [{\n        title: '《我的职业梦想》',\n        author: '张小明',\n        class: '计算机应用2101班',\n        content: '每个人都有自己的梦想，而我的梦想是成为一名优秀的软件工程师。在这个信息技术飞速发展的时代，软件工程师不仅需要扎实的专业知识，还需要创新思维和团队协作精神...',\n        comment: '文章立意深刻，语言流畅，表达了作者对职业的思考和追求，展现了当代职校学生积极向上的精神面貌。'\n      }, {\n        title: '《感恩有你》',\n        author: '李小华',\n        class: '电子商务2102班',\n        content: '在我成长的道路上，有许多人给予了我帮助和支持。我要感谢我的父母，是他们无私的爱和付出，让我健康成长；我要感谢我的老师，是他们的谆谆教诲，让我获得知识和智慧...',\n        comment: '文章情感真挚，表达了作者对父母和老师的感恩之情，字里行间流露出温暖和感动。'\n      }],\n      artWorks: [{\n        title: '《春暖花开》',\n        author: '王小红',\n        class: '艺术设计2101班',\n        image: require('../assets/img/sy/carousel1.jpg'),\n        description: '水彩画作品，描绘了春天校园里盛开的花朵和欢快的学生，表达了对美好校园生活的热爱。',\n        technique: '水彩画'\n      }, {\n        title: '《未来城市》',\n        author: '赵小龙',\n        class: '建筑设计2102班',\n        image: require('../assets/img/sy/carousel2.jpg'),\n        description: '计算机辅助设计作品，展示了作者对未来智能城市的构想，融合了环保理念和科技元素。',\n        technique: 'CAD设计'\n      }, {\n        title: '《传统与现代》',\n        author: '刘小燕',\n        class: '艺术设计2101班',\n        image: require('../assets/img/sy/carousel3.jpg'),\n        description: '摄影作品，通过对比传统建筑和现代建筑，表达了对文化传承与创新的思考。',\n        technique: '摄影'\n      }],\n      skillWorks: [{\n        title: '智能垃圾分类机器人',\n        author: '张小强、李小明',\n        class: '电子技术2101班',\n        image: require('../assets/img/sy/carousel1.jpg'),\n        description: '基于Arduino开发的智能垃圾分类机器人，能够自动识别不同类型的垃圾并进行分类，为环保事业贡献力量。',\n        category: '电子创新'\n      }, {\n        title: '校园导览APP',\n        author: '王小伟',\n        class: '计算机应用2102班',\n        image: require('../assets/img/sy/carousel2.jpg'),\n        description: '自主开发的校园导览APP，包含校园地图、教学楼导航、课表查询等功能，方便新生快速熟悉校园环境。',\n        category: '软件开发'\n      }, {\n        title: '创意家具设计',\n        author: '刘小芳',\n        class: '家具设计2103班',\n        image: require('../assets/img/sy/carousel3.jpg'),\n        description: '多功能学生书桌设计，考虑到学生学习和生活的实际需求，集学习、收纳、休息等功能于一体。',\n        category: '工业设计'\n      }]\n    };\n  },\n  methods: {\n    downloadResource(resource) {\n      // 这里可以实现资源下载功能\n      alert(`即将下载: ${resource.title}`);\n    },\n    showArtDetail(art) {\n      this.selectedArt = art;\n      this.dialogVisible = true;\n    }\n  },\n  created() {\n    // 如果有路由参数指定标签，则切换到对应标签\n    if (this.$route.params.tab) {\n      this.activeTab = this.$route.params.tab;\n    }\n  }\n};","map":{"version":3,"names":["name","data","activeTab","dialogVisible","selectedArt","moralActivities","id","title","date","description","image","require","category","type","color","mentalHealthActivities","mentalHealthResources","url","mentalHealthTips","content","excellentStudents","class","photo","achievement","story","literaryWorks","author","comment","artWorks","technique","skillWorks","methods","downloadResource","resource","alert","showArtDetail","art","created","$route","params","tab"],"sources":["src/views/MoralEducation.vue"],"sourcesContent":["<template>\r\n  <div class=\"moral-education-page\">\r\n    <!-- 头部 -->\r\n    <el-header class=\"header\">\r\n      <div class=\"logo-container\">\r\n        <div class=\"school-logo\">\r\n          <img src=\"../assets/img/sy/fd343a2a5554bb33db411f6d23f6fb88.jpg\" alt=\"学校校标\" />\r\n        </div>\r\n        <div class=\"school-name\">\r\n          <h1>深圳市宝民职业技术学校</h1>\r\n          <p>SHENZHEN BAOMIN VOCATIONAL TECHNICAL SCHOOL</p>\r\n        </div>\r\n      </div>\r\n      <div class=\"nav-links\">\r\n        <router-link to=\"/home\" class=\"nav-link\">返回首页</router-link>\r\n      </div>\r\n    </el-header>\r\n\r\n    <!-- 主要内容 -->\r\n    <div class=\"content-container\">\r\n      <h1 class=\"page-title\">德育之窗</h1>\r\n      \r\n      <!-- 导航标签 -->\r\n      <el-tabs v-model=\"activeTab\" type=\"card\" class=\"moral-tabs\">\r\n        <el-tab-pane label=\"德育活动\" name=\"activities\">\r\n          <div class=\"section-content\">\r\n            <h2 class=\"section-title\">丰富多彩的德育活动</h2>\r\n            \r\n            <el-timeline>\r\n              <el-timeline-item\r\n                v-for=\"activity in moralActivities\"\r\n                :key=\"activity.id\"\r\n                :timestamp=\"activity.date\"\r\n                :color=\"activity.color\"\r\n                placement=\"top\"\r\n              >\r\n                <el-card>\r\n                  <div class=\"activity-card\">\r\n                    <div class=\"activity-image\">\r\n                      <el-image :src=\"activity.image\" :alt=\"activity.title\" fit=\"cover\"></el-image>\r\n                    </div>\r\n                    <div class=\"activity-info\">\r\n                      <h3>{{ activity.title }}</h3>\r\n                      <p>{{ activity.description }}</p>\r\n                      <div class=\"activity-tags\">\r\n                        <el-tag size=\"small\" :type=\"activity.type\">{{ activity.category }}</el-tag>\r\n                      </div>\r\n                    </div>\r\n                  </div>\r\n                </el-card>\r\n              </el-timeline-item>\r\n            </el-timeline>\r\n          </div>\r\n        </el-tab-pane>\r\n        \r\n        <el-tab-pane label=\"心理健康\" name=\"mental-health\">\r\n          <div class=\"section-content\">\r\n            <h2 class=\"section-title\">心理健康教育</h2>\r\n            \r\n            <el-row :gutter=\"20\">\r\n              <el-col :span=\"16\">\r\n                <div class=\"mental-health-intro\">\r\n                  <h3>心理健康服务介绍</h3>\r\n                  <p>我校高度重视学生心理健康教育，设有专业的心理咨询室，配备专业心理咨询师，为学生提供个体咨询、团体辅导等多种形式的心理健康服务。</p>\r\n                  \r\n                  <h3>心理咨询预约方式</h3>\r\n                  <el-card class=\"appointment-card\">\r\n                    <div class=\"appointment-info\">\r\n                      <p><i class=\"el-icon-location\"></i> 地点：学校行政楼3楼心理咨询室</p>\r\n                      <p><i class=\"el-icon-time\"></i> 时间：周一至周五 9:00-17:00</p>\r\n                      <p><i class=\"el-icon-phone\"></i> 预约电话：0755-12345678</p>\r\n                      <p><i class=\"el-icon-message\"></i> 预约邮箱：xinli@baomin.edu.cn</p>\r\n                    </div>\r\n                  </el-card>\r\n                </div>\r\n                \r\n                <div class=\"mental-health-activities\">\r\n                  <h3>心理健康活动</h3>\r\n                  <el-card v-for=\"(activity, index) in mentalHealthActivities\" :key=\"index\" class=\"mental-activity-card\">\r\n                    <div class=\"mental-activity\">\r\n                      <div class=\"mental-activity-image\">\r\n                        <el-image :src=\"activity.image\" fit=\"cover\"></el-image>\r\n                      </div>\r\n                      <div class=\"mental-activity-info\">\r\n                        <h4>{{ activity.title }}</h4>\r\n                        <p>{{ activity.description }}</p>\r\n                        <p class=\"mental-activity-date\">{{ activity.date }}</p>\r\n                      </div>\r\n                    </div>\r\n                  </el-card>\r\n                </div>\r\n              </el-col>\r\n              \r\n              <el-col :span=\"8\">\r\n                <div class=\"mental-health-resources\">\r\n                  <h3>心理健康资源</h3>\r\n                  <el-card class=\"resource-card\">\r\n                    <div class=\"resource-list\">\r\n                      <div v-for=\"(resource, index) in mentalHealthResources\" :key=\"index\" class=\"resource-item\">\r\n                        <h4>{{ resource.title }}</h4>\r\n                        <p>{{ resource.description }}</p>\r\n                        <el-button type=\"primary\" size=\"small\" @click=\"downloadResource(resource)\">下载资料</el-button>\r\n                      </div>\r\n                    </div>\r\n                  </el-card>\r\n                  \r\n                  <h3>心理健康小贴士</h3>\r\n                  <el-card class=\"tips-card\">\r\n                    <div class=\"tips-list\">\r\n                      <div v-for=\"(tip, index) in mentalHealthTips\" :key=\"index\" class=\"tip-item\">\r\n                        <h4>{{ tip.title }}</h4>\r\n                        <p>{{ tip.content }}</p>\r\n                      </div>\r\n                    </div>\r\n                  </el-card>\r\n                </div>\r\n              </el-col>\r\n            </el-row>\r\n          </div>\r\n        </el-tab-pane>\r\n        \r\n        <el-tab-pane label=\"学生风采\" name=\"student-showcase\">\r\n          <div class=\"section-content\">\r\n            <h2 class=\"section-title\">学生风采展示</h2>\r\n            \r\n            <div class=\"student-excellence\">\r\n              <h3>优秀学生事迹</h3>\r\n              <el-row :gutter=\"20\">\r\n                <el-col :span=\"8\" v-for=\"(student, index) in excellentStudents\" :key=\"index\">\r\n                  <el-card class=\"student-card\">\r\n                    <div class=\"student-photo\">\r\n                      <el-image :src=\"student.photo\" fit=\"cover\"></el-image>\r\n                    </div>\r\n                    <div class=\"student-info\">\r\n                      <h4>{{ student.name }}</h4>\r\n                      <p class=\"student-class\">{{ student.class }}</p>\r\n                      <p class=\"student-achievement\">{{ student.achievement }}</p>\r\n                      <p class=\"student-story\">{{ student.story }}</p>\r\n                    </div>\r\n                  </el-card>\r\n                </el-col>\r\n              </el-row>\r\n            </div>\r\n            \r\n            <div class=\"student-works\">\r\n              <h3>学生作品展示</h3>\r\n              <el-tabs type=\"border-card\">\r\n                <el-tab-pane label=\"文学作品\">\r\n                  <el-row :gutter=\"20\">\r\n                    <el-col :span=\"12\" v-for=\"(work, index) in literaryWorks\" :key=\"index\">\r\n                      <el-card class=\"work-card\">\r\n                        <div class=\"work-info\">\r\n                          <h4>{{ work.title }}</h4>\r\n                          <p class=\"work-author\">作者：{{ work.author }} ({{ work.class }})</p>\r\n                          <div class=\"work-content\">{{ work.content }}</div>\r\n                          <p class=\"work-comment\">点评：{{ work.comment }}</p>\r\n                        </div>\r\n                      </el-card>\r\n                    </el-col>\r\n                  </el-row>\r\n                </el-tab-pane>\r\n                \r\n                <el-tab-pane label=\"艺术作品\">\r\n                  <el-row :gutter=\"20\">\r\n                    <el-col :span=\"8\" v-for=\"(work, index) in artWorks\" :key=\"index\">\r\n                      <el-card class=\"art-card\">\r\n                        <div class=\"art-image\">\r\n                          <el-image :src=\"work.image\" fit=\"cover\" @click=\"showArtDetail(work)\"></el-image>\r\n                        </div>\r\n                        <div class=\"art-info\">\r\n                          <h4>{{ work.title }}</h4>\r\n                          <p>作者：{{ work.author }} ({{ work.class }})</p>\r\n                          <p>{{ work.description }}</p>\r\n                        </div>\r\n                      </el-card>\r\n                    </el-col>\r\n                  </el-row>\r\n                </el-tab-pane>\r\n                \r\n                <el-tab-pane label=\"技能成果\">\r\n                  <el-row :gutter=\"20\">\r\n                    <el-col :span=\"8\" v-for=\"(work, index) in skillWorks\" :key=\"index\">\r\n                      <el-card class=\"skill-card\">\r\n                        <div class=\"skill-image\">\r\n                          <el-image :src=\"work.image\" fit=\"cover\"></el-image>\r\n                        </div>\r\n                        <div class=\"skill-info\">\r\n                          <h4>{{ work.title }}</h4>\r\n                          <p>创作者：{{ work.author }} ({{ work.class }})</p>\r\n                          <p>{{ work.description }}</p>\r\n                          <el-tag size=\"small\" type=\"success\">{{ work.category }}</el-tag>\r\n                        </div>\r\n                      </el-card>\r\n                    </el-col>\r\n                  </el-row>\r\n                </el-tab-pane>\r\n              </el-tabs>\r\n            </div>\r\n          </div>\r\n        </el-tab-pane>\r\n      </el-tabs>\r\n    </div>\r\n    \r\n    <!-- 艺术作品详情对话框 -->\r\n    <el-dialog\r\n      :visible.sync=\"dialogVisible\"\r\n      width=\"60%\">\r\n      <div class=\"art-detail\" v-if=\"selectedArt\">\r\n        <el-image :src=\"selectedArt.image\" fit=\"contain\" style=\"width: 100%\"></el-image>\r\n        <h3>{{ selectedArt.title }}</h3>\r\n        <p>作者：{{ selectedArt.author }} ({{ selectedArt.class }})</p>\r\n        <p>{{ selectedArt.description }}</p>\r\n        <p v-if=\"selectedArt.technique\">创作技法：{{ selectedArt.technique }}</p>\r\n      </div>\r\n    </el-dialog>\r\n    \r\n    <!-- 页脚 -->\r\n    <el-footer class=\"footer\">\r\n      <div class=\"footer-content\">\r\n        <div class=\"footer-info\">\r\n          <p>地址：深圳市宝安区石岩石龙仔路宝民学校</p>\r\n        </div>\r\n        <div class=\"copyright\">\r\n          © 2023 深圳市宝民职业技术学校 版权所有\r\n          <p>技术支持：dxh</p>\r\n        </div>\r\n      </div>\r\n    </el-footer>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'MoralEducation',\r\n  data() {\r\n    return {\r\n      activeTab: 'activities',\r\n      dialogVisible: false,\r\n      selectedArt: null,\r\n      moralActivities: [\r\n        {\r\n          id: 1,\r\n          title: '爱国主义教育主题班会',\r\n          date: '2023-05-20',\r\n          description: '各班级开展了以\"传承红色基因，争做时代新人\"为主题的班会活动，通过观看爱国主义教育影片、讲述革命故事等形式，激发学生的爱国情怀。',\r\n          image: require('../assets/img/sy/carousel1.jpg'),\r\n          category: '主题班会',\r\n          type: 'success',\r\n          color: '#67C23A'\r\n        },\r\n        {\r\n          id: 2,\r\n          title: '感恩教育活动',\r\n          date: '2023-04-15',\r\n          description: '学校组织了\"感恩父母、感恩师长、感恩社会\"的主题活动，学生通过写感恩信、制作感恩卡片等方式，表达对父母和老师的感谢之情。',\r\n          image: require('../assets/img/sy/carousel2.jpg'),\r\n          category: '德育活动',\r\n          type: 'primary',\r\n          color: '#409EFF'\r\n        },\r\n        {\r\n          id: 3,\r\n          title: '诚信教育讲座',\r\n          date: '2023-03-10',\r\n          description: '邀请了教育专家为学生开展诚信教育讲座，通过案例分析和互动讨论，引导学生树立正确的诚信观念，做一个诚实守信的人。',\r\n          image: require('../assets/img/sy/carousel3.jpg'),\r\n          category: '专题讲座',\r\n          type: 'warning',\r\n          color: '#E6A23C'\r\n        }\r\n      ],\r\n      mentalHealthActivities: [\r\n        {\r\n          title: '心理健康月活动',\r\n          description: '学校举办了为期一个月的心理健康主题活动，包括心理健康知识讲座、心理游戏、团体辅导等多种形式，帮助学生了解心理健康知识，提高心理调适能力。',\r\n          date: '2023年4月',\r\n          image: require('../assets/img/sy/carousel1.jpg')\r\n        },\r\n        {\r\n          title: '压力管理工作坊',\r\n          description: '针对学生学习压力大的问题，学校心理咨询室组织了压力管理工作坊，教授学生科学的减压方法和技巧，帮助学生有效应对学习和生活中的压力。',\r\n          date: '2023年5月15日',\r\n          image: require('../assets/img/sy/carousel2.jpg')\r\n        }\r\n      ],\r\n      mentalHealthResources: [\r\n        {\r\n          title: '青少年心理健康手册',\r\n          description: '专为中学生编写的心理健康指导手册，包含常见心理问题解析和应对方法。',\r\n          url: '#'\r\n        },\r\n        {\r\n          title: '情绪管理技巧',\r\n          description: '学习如何识别和管理自己的情绪，提高情绪调节能力。',\r\n          url: '#'\r\n        },\r\n        {\r\n          title: '考试焦虑应对指南',\r\n          description: '帮助学生克服考试焦虑，以平和的心态面对考试。',\r\n          url: '#'\r\n        }\r\n      ],\r\n      mentalHealthTips: [\r\n        {\r\n          title: '保持规律作息',\r\n          content: '规律的作息时间有助于身心健康，尽量保持每天相同的起床和睡觉时间，确保充足的睡眠。'\r\n        },\r\n        {\r\n          title: '适当运动',\r\n          content: '每天进行适当的体育锻炼，如慢跑、散步、打球等，有助于释放压力，改善心情。'\r\n        },\r\n        {\r\n          title: '学会倾诉',\r\n          content: '遇到困难或烦恼时，不要一个人闷在心里，可以向信任的朋友、家人或老师倾诉，寻求支持和帮助。'\r\n        }\r\n      ],\r\n      excellentStudents: [\r\n        {\r\n          name: '张明',\r\n          class: '计算机应用2101班',\r\n          photo: require('../assets/img/sy/carousel1.jpg'),\r\n          achievement: '2023年广东省职业技能大赛计算机应用一等奖',\r\n          story: '张明同学自入学以来，学习刻苦认真，专业技能出色。在备战省职业技能大赛期间，他每天坚持训练8小时以上，最终凭借扎实的基本功和创新的解题思路，获得了比赛一等奖的好成绩。'\r\n        },\r\n        {\r\n          name: '李华',\r\n          class: '电子商务2102班',\r\n          photo: require('../assets/img/sy/carousel2.jpg'),\r\n          achievement: '校\"三好学生\"、\"优秀学生干部\"',\r\n          story: '李华同学品学兼优，担任班级学习委员，积极组织同学们开展学习互助活动。在校期间，她多次获得\"三好学生\"和\"优秀学生干部\"称号，是同学们学习的榜样。'\r\n        },\r\n        {\r\n          name: '王强',\r\n          class: '汽车维修2103班',\r\n          photo: require('../assets/img/sy/carousel3.jpg'),\r\n          achievement: '校园志愿服务先进个人',\r\n          story: '王强同学热心公益，积极参与校内外各类志愿服务活动。他组织成立了\"爱心维修队\"，利用专业技能为社区居民提供家电维修服务，受到了广泛好评。'\r\n        }\r\n      ],\r\n      literaryWorks: [\r\n        {\r\n          title: '《我的职业梦想》',\r\n          author: '张小明',\r\n          class: '计算机应用2101班',\r\n          content: '每个人都有自己的梦想，而我的梦想是成为一名优秀的软件工程师。在这个信息技术飞速发展的时代，软件工程师不仅需要扎实的专业知识，还需要创新思维和团队协作精神...',\r\n          comment: '文章立意深刻，语言流畅，表达了作者对职业的思考和追求，展现了当代职校学生积极向上的精神面貌。'\r\n        },\r\n        {\r\n          title: '《感恩有你》',\r\n          author: '李小华',\r\n          class: '电子商务2102班',\r\n          content: '在我成长的道路上，有许多人给予了我帮助和支持。我要感谢我的父母，是他们无私的爱和付出，让我健康成长；我要感谢我的老师，是他们的谆谆教诲，让我获得知识和智慧...',\r\n          comment: '文章情感真挚，表达了作者对父母和老师的感恩之情，字里行间流露出温暖和感动。'\r\n        }\r\n      ],\r\n      artWorks: [\r\n        {\r\n          title: '《春暖花开》',\r\n          author: '王小红',\r\n          class: '艺术设计2101班',\r\n          image: require('../assets/img/sy/carousel1.jpg'),\r\n          description: '水彩画作品，描绘了春天校园里盛开的花朵和欢快的学生，表达了对美好校园生活的热爱。',\r\n          technique: '水彩画'\r\n        },\r\n        {\r\n          title: '《未来城市》',\r\n          author: '赵小龙',\r\n          class: '建筑设计2102班',\r\n          image: require('../assets/img/sy/carousel2.jpg'),\r\n          description: '计算机辅助设计作品，展示了作者对未来智能城市的构想，融合了环保理念和科技元素。',\r\n          technique: 'CAD设计'\r\n        },\r\n        {\r\n          title: '《传统与现代》',\r\n          author: '刘小燕',\r\n          class: '艺术设计2101班',\r\n          image: require('../assets/img/sy/carousel3.jpg'),\r\n          description: '摄影作品，通过对比传统建筑和现代建筑，表达了对文化传承与创新的思考。',\r\n          technique: '摄影'\r\n        }\r\n      ],\r\n      skillWorks: [\r\n        {\r\n          title: '智能垃圾分类机器人',\r\n          author: '张小强、李小明',\r\n          class: '电子技术2101班',\r\n          image: require('../assets/img/sy/carousel1.jpg'),\r\n          description: '基于Arduino开发的智能垃圾分类机器人，能够自动识别不同类型的垃圾并进行分类，为环保事业贡献力量。',\r\n          category: '电子创新'\r\n        },\r\n        {\r\n          title: '校园导览APP',\r\n          author: '王小伟',\r\n          class: '计算机应用2102班',\r\n          image: require('../assets/img/sy/carousel2.jpg'),\r\n          description: '自主开发的校园导览APP，包含校园地图、教学楼导航、课表查询等功能，方便新生快速熟悉校园环境。',\r\n          category: '软件开发'\r\n        },\r\n        {\r\n          title: '创意家具设计',\r\n          author: '刘小芳',\r\n          class: '家具设计2103班',\r\n          image: require('../assets/img/sy/carousel3.jpg'),\r\n          description: '多功能学生书桌设计，考虑到学生学习和生活的实际需求，集学习、收纳、休息等功能于一体。',\r\n          category: '工业设计'\r\n        }\r\n      ]\r\n    }\r\n  },\r\n  methods: {\r\n    downloadResource(resource) {\r\n      // 这里可以实现资源下载功能\r\n      alert(`即将下载: ${resource.title}`);\r\n    },\r\n    showArtDetail(art) {\r\n      this.selectedArt = art;\r\n      this.dialogVisible = true;\r\n    }\r\n  },\r\n  created() {\r\n    // 如果有路由参数指定标签，则切换到对应标签\r\n    if (this.$route.params.tab) {\r\n      this.activeTab = this.$route.params.tab;\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.moral-education-page {\r\n  display: flex;\r\n  flex-direction: column;\r\n  min-height: 100vh;\r\n}\r\n\r\n.header {\r\n  background-color: #0d47a1;\r\n  color: white;\r\n  padding: 10px 20px;\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n}\r\n\r\n.logo-container {\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n.school-logo {\r\n  display: flex;\r\n  align-items: center;\r\n  margin-right: 15px;\r\n}\r\n\r\n.school-logo img {\r\n  width: 50px;\r\n  height: auto;\r\n}\r\n\r\n.school-name h1 {\r\n  margin: 0;\r\n  font-size: 24px;\r\n}\r\n\r\n.school-name p {\r\n  margin: 0;\r\n  font-size: 12px;\r\n}\r\n\r\n.nav-links {\r\n  display: flex;\r\n}\r\n\r\n.nav-link {\r\n  color: white;\r\n  text-decoration: none;\r\n  margin-left: 20px;\r\n  font-size: 14px;\r\n}\r\n\r\n.nav-link:hover {\r\n  text-decoration: underline;\r\n}\r\n\r\n.content-container {\r\n  flex: 1;\r\n  padding: 20px;\r\n  background-color: #f5f5f5;\r\n  max-width: 1200px;\r\n  margin: 0 auto;\r\n}\r\n\r\n.page-title {\r\n  text-align: center;\r\n  color: #0d47a1;\r\n  margin-bottom: 30px;\r\n  position: relative;\r\n}\r\n\r\n.page-title:after {\r\n  content: '';\r\n  position: absolute;\r\n  bottom: -10px;\r\n  left: 50%;\r\n  transform: translateX(-50%);\r\n  width: 80px;\r\n  height: 3px;\r\n  background-color: #0d47a1;\r\n}\r\n\r\n.moral-tabs {\r\n  margin-top: 30px;\r\n}\r\n\r\n.section-content {\r\n  padding: 20px 0;\r\n}\r\n\r\n.section-title {\r\n  color: #0d47a1;\r\n  margin-bottom: 30px;\r\n  text-align: center;\r\n  font-size: 28px;\r\n  font-weight: bold;\r\n}\r\n\r\n/* 德育活动样式 */\r\n.activity-card {\r\n  display: flex;\r\n  align-items: flex-start;\r\n}\r\n\r\n.activity-image {\r\n  width: 300px;\r\n  height: 200px;\r\n  margin-right: 20px;\r\n  overflow: hidden;\r\n}\r\n\r\n.activity-info h3 {\r\n  margin-top: 0;\r\n  color: #333;\r\n}\r\n\r\n.activity-info p {\r\n  color: #666;\r\n  line-height: 1.6;\r\n}\r\n\r\n.activity-tags {\r\n  margin-top: 10px;\r\n}\r\n\r\n/* 心理健康样式 */\r\n.mental-health-intro {\r\n  margin-bottom: 30px;\r\n}\r\n\r\n.mental-health-intro h3 {\r\n  color: #0d47a1;\