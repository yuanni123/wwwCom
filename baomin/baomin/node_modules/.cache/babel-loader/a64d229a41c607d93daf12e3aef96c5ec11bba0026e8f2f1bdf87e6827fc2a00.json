{"ast":null,"code":"//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n\nimport MainNavigation from '../components/MainNavigation.vue';\nexport default {\n  name: 'MoralEducationPage',\n  components: {\n    MainNavigation\n  },\n  data() {\n    return {\n      activeTab: 'activities',\n      moralActivities: [{\n        id: 1,\n        title: '爱国主义教育主题班会',\n        date: '2023-09-30',\n        content: '为庆祝国庆节，学校组织了爱国主义教育主题班会，通过观看爱国主义教育影片、讲述革命先烈故事等形式，激发学生的爱国热情。',\n        color: '#409EFF',\n        images: [require('@/assets/img/xxgk/1728446731.jpg'), require('@/assets/img/xxgk/1728446731.jpg')]\n      }, {\n        id: 2,\n        title: '诚信教育活动',\n        date: '2023-09-15',\n        content: '学校开展了以\"诚信做人，诚信做事\"为主题的诚信教育活动，通过诚信讲座、诚信承诺签名等形式，引导学生树立诚信意识。',\n        color: '#67C23A',\n        images: [require('@/assets/img/xxgk/1728446731.jpg')]\n      }, {\n        id: 3,\n        title: '感恩教育活动',\n        date: '2023-05-12',\n        content: '在母亲节来临之际，学校组织了\"感恩母亲，感恩师长\"主题活动，学生通过写感恩信、制作感恩卡片等方式表达对母亲和老师的感恩之情。',\n        color: '#E6A23C',\n        images: [require('@/assets/img/xxgk/1728446731.jpg'), require('@/assets/img/xxgk/1728446731.jpg'), require('@/assets/img/xxgk/1728446731.jpg')]\n      }],\n      mentalHealthServices: [{\n        title: '个人心理咨询',\n        description: '由专业心理咨询师提供一对一的心理咨询服务，帮助学生解决个人成长、学习压力、情绪管理等方面的困扰。',\n        icon: 'el-icon-user'\n      }, {\n        title: '团体心理辅导',\n        description: '通过小组活动形式，帮助学生提高自我认知、人际交往能力和团队合作精神。',\n        icon: 'el-icon-s-cooperation'\n      }, {\n        title: '心理危机干预',\n        description: '为遇到重大心理困难或危机的学生提供及时、专业的心理援助和支持。',\n        icon: 'el-icon-first-aid-kit'\n      }],\n      mentalHealthResources: [{\n        title: '青少年心理健康手册',\n        description: '介绍青少年常见心理问题及应对方法，包含自我认知、情绪管理、压力应对等内容。',\n        url: '#'\n      }, {\n        title: '压力管理与情绪调节',\n        description: '学习如何识别压力源、管理压力和调节情绪的实用指南，包含多种放松技巧和练习。',\n        url: '#'\n      }, {\n        title: '人际关系与沟通技巧',\n        description: '提升人际交往能力和沟通技巧的方法，帮助学生建立健康的人际关系。',\n        url: '#'\n      }, {\n        title: '生涯规划与自我发展',\n        description: '帮助学生认识自我、规划未来，提高自信心和自我效能感。',\n        url: '#'\n      }],\n      excellentStudents: [{\n        id: 1,\n        name: '张明',\n        class: '计算机应用2101班',\n        title: '校三好学生',\n        avatar: require('@/assets/img/xxgk/1728446731.jpg'),\n        // 将import改为avatar\n        story: '张明同学学习刻苦认真，成绩优异，多次获得学校奖学金。同时积极参加社会实践活动，担任班级学习委员，热心帮助同学，是同学们学习的榜样。'\n      }, {\n        id: 2,\n        name: '李华',\n        class: '电子商务2102班',\n        title: '优秀学生干部',\n        avatar: require('@/assets/img/xxgk/1728446731.jpg'),\n        // 将import改为avatar\n        story: '李华同学担任学生会主席，组织策划了多项校园文化活动，工作认真负责，具有较强的组织能力和领导才能，深受师生好评。'\n      }, {\n        id: 3,\n        name: '王芳',\n        class: '会计2103班',\n        title: '技能大赛一等奖获得者',\n        avatar: require('@/assets/img/xxgk/1728446731.jpg'),\n        // 将import改为avatar\n        story: '王芳同学在2023年全国职业院校技能大赛会计项目中获得一等奖，专业技能突出，学习态度端正，是专业学习的标兵。'\n      }],\n      studentWorks: [{\n        title: '《春天的畅想》',\n        author: '刘晓',\n        class: '艺术设计2101班',\n        image: require('@/assets/img/xxgk/1728446731.jpg'),\n        description: '这幅作品表达了作者对春天的美好向往，色彩明快，构图和谐。'\n      }, {\n        title: '《科技与未来》',\n        author: '张伟',\n        class: '计算机应用2102班',\n        image: require('@/assets/img/xxgk/1728446731.jpg'),\n        description: '这是一个3D打印作品，展示了作者对未来科技发展的畅想。'\n      }, {\n        title: '《我的家乡》',\n        author: '李梅',\n        class: '旅游管理2103班',\n        image: require('@/assets/img/xxgk/1728446731.jpg'),\n        description: '这篇散文描绘了作者家乡的美丽风景和风土人情，字里行间流露出对家乡的深厚感情。'\n      }]\n    };\n  },\n  created() {\n    // 根据URL查询参数设置当前活动的标签页\n    const tab = this.$route.query.tab;\n    if (tab) {\n      this.activeTab = tab;\n    }\n  },\n  watch: {\n    // 监听路由变化，更新活动标签页\n    '$route.query.tab': function (newTab) {\n      if (newTab) {\n        this.activeTab = newTab;\n      } else {\n        this.activeTab = 'activities';\n      }\n    }\n  },\n  methods: {\n    backToHome() {\n      this.$router.push('/');\n    },\n    downloadResource(resource) {\n      this.$message({\n        message: `正在下载资源：${resource.title}`,\n        type: 'success'\n      });\n      // 实际下载逻辑\n    },\n    handleImageClick(image) {\n      // 处理图片点击事件\n      // 可以在这里添加图片预览功能\n    }\n  }\n};","map":{"version":3,"names":["MainNavigation","name","components","data","activeTab","moralActivities","id","title","date","content","color","images","require","mentalHealthServices","description","icon","mentalHealthResources","url","excellentStudents","class","avatar","story","studentWorks","author","image","created","tab","$route","query","watch","$route.query.tab","newTab","methods","backToHome","$router","push","downloadResource","resource","$message","message","type","handleImageClick"],"sources":["src/views/MoralEducationPage.vue"],"sourcesContent":["<template>\r\n  <div class=\"moral-education-container\">\r\n    <!-- 将学校logo和名称放在最上面 -->\r\n    <el-header class=\"header\">\r\n      <div class=\"logo-container\">\r\n        <div class=\"school-logo\">\r\n          <img src=\"../assets/img/sy/fd343a2a5554bb33db411f6d23f6fb88.jpg\" alt=\"学校校标\" />\r\n        </div>\r\n        <div class=\"school-name\">\r\n          <h1>深圳市宝民技工学校</h1>\r\n          <p>SHENZHEN BAOMIN VOCATIONAL TECHNICAL SCHOOL</p>\r\n        </div>\r\n      </div>\r\n    </el-header>\r\n    \r\n    <!-- 使用导航栏组件 -->\r\n    <main-navigation active-index=\"4\"></main-navigation>\r\n    \r\n    <!-- 添加横幅图片 -->\r\n    <div class=\"banner-container\">\r\n      <el-image \r\n        :src=\"require('@/assets/img/xxgk/fafa.png')\" \r\n        fit=\"cover\" \r\n        class=\"banner-image\">\r\n      </el-image>\r\n      <div class=\"banner-overlay\">\r\n        <h1>德育之窗</h1>\r\n        <p>培养学生良好品德，促进全面发展</p>\r\n      </div>\r\n    </div>\r\n    \r\n    <el-container class=\"main-container\">\r\n      <el-main class=\"main-content\">\r\n        <el-tabs v-model=\"activeTab\" type=\"card\">\r\n          <!-- 新增的标签页内容 -->\r\n          <el-tab-pane label=\"德育活动\" name=\"activities\">\r\n            <div class=\"section\">\r\n              <h2 class=\"section-title\">德育活动展示</h2>\r\n              <el-timeline>\r\n                <el-timeline-item\r\n                  v-for=\"activity in moralActivities\"\r\n                  :key=\"activity.id\"\r\n                  :color=\"activity.color\"\r\n                  :timestamp=\"activity.date\">\r\n                  <h3>{{ activity.title }}</h3>\r\n                  <p>{{ activity.content }}</p>\r\n                  <div class=\"activity-images\">\r\n                    <el-image\r\n                      v-for=\"(image, index) in activity.images\"\r\n                      :key=\"index\"\r\n                      :src=\"image\"\r\n                      fit=\"cover\"\r\n                      class=\"activity-image\"\r\n                      @click=\"handleImageClick(image)\">\r\n                    </el-image>\r\n                  </div>\r\n                </el-timeline-item>\r\n              </el-timeline>\r\n            </div>\r\n          </el-tab-pane>\r\n  \r\n          <el-tab-pane label=\"心理健康\" name=\"mental-health\">\r\n            <div class=\"section\">\r\n              <h2 class=\"section-title\">心理健康教育</h2>\r\n              \r\n              <!-- 心理健康介绍部分 -->\r\n              <div class=\"mental-health-intro\">\r\n                <el-row :gutter=\"20\">\r\n                  <el-col :span=\"16\">\r\n                    <div class=\"intro-content\">\r\n                      <h3>关爱心灵，健康成长</h3>\r\n                      <p>心理健康是指个体在认知、情感、意志、人格等方面保持良好的状态，能够保持积极的心态，有效应对生活中的各种挑战和压力。学校心理健康教育旨在帮助学生了解自我、接纳自我，培养积极的心理品质，提高脑调适能力。</p>\r\n                      <p>我校心理健康教育中心为学生提供专业的心理咨询服务，开展丰富多彩的心理健康教育活动，帮助学生解决学习、生活、人际交往等方面的心理困扰，促进学生身心健康发展。</p>\r\n                    </div>\r\n                  </el-col>\r\n                  <el-col :span=\"8\">\r\n                    <div class=\"intro-image\">\r\n                      <el-image \r\n          \r\n                        fit=\"cover\">\r\n                      </el-image>\r\n                    </div>\r\n                  </el-col>\r\n                </el-row>\r\n              </div>\r\n              \r\n              <!-- 心理健康服务部分 -->\r\n              <div class=\"mental-health-services\">\r\n                <h3 class=\"sub-title\">心理健康服务</h3>\r\n                <el-row :gutter=\"20\">\r\n                  <el-col :span=\"8\" v-for=\"(service, index) in mentalHealthServices\" :key=\"index\">\r\n                    <el-card class=\"service-card\" shadow=\"hover\">\r\n                      <div class=\"service-icon\">\r\n                        <i :class=\"service.icon\"></i>\r\n                      </div>\r\n                      <div class=\"service-title\">{{ service.title }}</div>\r\n                      <div class=\"service-desc\">{{ service.description }}</div>\r\n                    </el-card>\r\n                  </el-col>\r\n                </el-row>\r\n              </div>\r\n              \r\n              <!-- 心理健康资源部分 -->\r\n              <div class=\"mental-health-resources\">\r\n                <h3 class=\"sub-title\">心理健康资源</h3>\r\n                <el-table\r\n                  :data=\"mentalHealthResources\"\r\n                  style=\"width: 100%\">\r\n                  <el-table-column\r\n                    prop=\"title\"\r\n                    label=\"资源名称\"\r\n                    width=\"250\">\r\n                  </el-table-column>\r\n                  <el-table-column\r\n                    prop=\"description\"\r\n                    label=\"资源描述\">\r\n                  </el-table-column>\r\n                  <el-table-column\r\n                    label=\"操作\"\r\n                    width=\"120\">\r\n                    <template slot-scope=\"scope\">\r\n                      <el-button\r\n                        size=\"mini\"\r\n                        type=\"primary\"\r\n                        @click=\"downloadResource(scope.row)\">下载</el-button>\r\n                    </template>\r\n                  </el-table-column>\r\n                </el-table>\r\n              </div>\r\n              \r\n              <!-- 心理健康小贴士 -->\r\n              <div class=\"mental-health-tips\">\r\n                <h3 class=\"sub-title\">心理健康小贴士</h3>\r\n                <el-collapse accordion>\r\n                  <el-collapse-item v-for=\"(tip, index) in mentalHealthTips\" :key=\"index\" :title=\"tip.title\" :name=\"index\">\r\n                    <div>{{ tip.content }}</div>\r\n                  </el-collapse-item>\r\n                </el-collapse>\r\n              </div>\r\n            </div>\r\n          </el-tab-pane>\r\n  \r\n          <el-tab-pane label=\"优秀学生\" name=\"excellent-students\">\r\n            <div class=\"section\">\r\n              <h2 class=\"section-title\">优秀学生风采</h2>\r\n              <el-row :gutter=\"20\">\r\n                <el-col :span=\"8\" v-for=\"student in excellentStudents\" :key=\"student.id\">\r\n                  <el-card class=\"student-card\" shadow=\"hover\">\r\n                    <el-avatar :size=\"100\" :src=\"student.avatar\" class=\"student-avatar\"></el-avatar>\r\n                    <div class=\"student-info\">\r\n                      <h3>{{ student.name }}</h3>\r\n                      <p class=\"student-class\">{{ student.class }}</p>\r\n                      <p class=\"student-title\">{{ student.title }}</p>\r\n                    </div>\r\n                    <p class=\"student-story\">{{ student.story }}</p>\r\n                  </el-card>\r\n                </el-col>\r\n              </el-row>\r\n            </div>\r\n          </el-tab-pane>\r\n  \r\n          <el-tab-pane label=\"学生作品\" name=\"student-works\">\r\n            <div class=\"section\">\r\n              <h2 class=\"section-title\">学生优秀作品展示</h2>\r\n              <el-row :gutter=\"20\">\r\n                <el-col :span=\"8\" v-for=\"work in studentWorks\" :key=\"work.title\">\r\n                  <el-card class=\"work-card\" shadow=\"hover\">\r\n                    <img :src=\"work.image\" class=\"work-image\">\r\n                    <div class=\"work-info\">\r\n                      <h3>{{ work.title }}</h3>\r\n                      <p class=\"work-author\">{{ work.author }} - {{ work.class }}</p>\r\n                      <p class=\"work-desc\">{{ work.description }}</p>\r\n                    </div>\r\n                  </el-card>\r\n                </el-col>\r\n              </el-row>\r\n            </div>\r\n          </el-tab-pane>\r\n        </el-tabs>\r\n      </el-main>\r\n    </el-container>\r\n    \r\n    <el-footer class=\"footer\">\r\n      <!-- 页脚内容保持不变 -->\r\n    </el-footer>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport MainNavigation from '../components/MainNavigation.vue'\r\n\r\nexport default {\r\n  name: 'MoralEducationPage',\r\n  components: {\r\n    MainNavigation\r\n  },\r\n  data() {\r\n    return {\r\n      activeTab: 'activities',\r\n      moralActivities: [\r\n        {\r\n          id: 1,\r\n          title: '爱国主义教育主题班会',\r\n          date: '2023-09-30',\r\n          content: '为庆祝国庆节，学校组织了爱国主义教育主题班会，通过观看爱国主义教育影片、讲述革命先烈故事等形式，激发学生的爱国热情。',\r\n          color: '#409EFF',\r\n          images: [\r\n          require('@/assets/img/xxgk/1728446731.jpg'),\r\n          require('@/assets/img/xxgk/1728446731.jpg')\r\n          ]\r\n        },\r\n        {\r\n          id: 2,\r\n          title: '诚信教育活动',\r\n          date: '2023-09-15',\r\n          content: '学校开展了以\"诚信做人，诚信做事\"为主题的诚信教育活动，通过诚信讲座、诚信承诺签名等形式，引导学生树立诚信意识。',\r\n          color: '#67C23A',\r\n          images: [\r\n          require('@/assets/img/xxgk/1728446731.jpg')\r\n          ]\r\n        },\r\n        {\r\n          id: 3,\r\n          title: '感恩教育活动',\r\n          date: '2023-05-12',\r\n          content: '在母亲节来临之际，学校组织了\"感恩母亲，感恩师长\"主题活动，学生通过写感恩信、制作感恩卡片等方式表达对母亲和老师的感恩之情。',\r\n          color: '#E6A23C',\r\n          images: [\r\n            require('@/assets/img/xxgk/1728446731.jpg'),\r\n            require('@/assets/img/xxgk/1728446731.jpg'),\r\n            require('@/assets/img/xxgk/1728446731.jpg'),\r\n          ]\r\n        }\r\n      ],\r\n      mentalHealthServices: [\r\n        {\r\n          title: '个人心理咨询',\r\n          description: '由专业心理咨询师提供一对一的心理咨询服务，帮助学生解决个人成长、学习压力、情绪管理等方面的困扰。',\r\n          icon: 'el-icon-user'\r\n        },\r\n        {\r\n          title: '团体心理辅导',\r\n          description: '通过小组活动形式，帮助学生提高自我认知、人际交往能力和团队合作精神。',\r\n          icon: 'el-icon-s-cooperation'\r\n        },\r\n        {\r\n          title: '心理危机干预',\r\n          description: '为遇到重大心理困难或危机的学生提供及时、专业的心理援助和支持。',\r\n          icon: 'el-icon-first-aid-kit'\r\n        }\r\n      ],\r\n      mentalHealthResources: [\r\n        {\r\n          title: '青少年心理健康手册',\r\n          description: '介绍青少年常见心理问题及应对方法，包含自我认知、情绪管理、压力应对等内容。',\r\n          url: '#'\r\n        },\r\n        {\r\n          title: '压力管理与情绪调节',\r\n          description: '学习如何识别压力源、管理压力和调节情绪的实用指南，包含多种放松技巧和练习。',\r\n          url: '#'\r\n        },\r\n        {\r\n          title: '人际关系与沟通技巧',\r\n          description: '提升人际交往能力和沟通技巧的方法，帮助学生建立健康的人际关系。',\r\n          url: '#'\r\n        },\r\n        {\r\n          title: '生涯规划与自我发展',\r\n          description: '帮助学生认识自我、规划未来，提高自信心和自我效能感。',\r\n          url: '#'\r\n        }\r\n      ],\r\n      excellentStudents: [\r\n        {\r\n          id: 1,\r\n          name: '张明',\r\n          class: '计算机应用2101班',\r\n          title: '校三好学生',\r\n          avatar: require('@/assets/img/xxgk/1728446731.jpg'),  // 将import改为avatar\r\n          story: '张明同学学习刻苦认真，成绩优异，多次获得学校奖学金。同时积极参加社会实践活动，担任班级学习委员，热心帮助同学，是同学们学习的榜样。'\r\n        },\r\n        {\r\n          id: 2,\r\n          name: '李华',\r\n          class: '电子商务2102班',\r\n          title: '优秀学生干部',\r\n          avatar: require('@/assets/img/xxgk/1728446731.jpg'),  // 将import改为avatar\r\n          story: '李华同学担任学生会主席，组织策划了多项校园文化活动，工作认真负责，具有较强的组织能力和领导才能，深受师生好评。'\r\n        },\r\n        {\r\n          id: 3,\r\n          name: '王芳',\r\n          class: '会计2103班',\r\n          title: '技能大赛一等奖获得者',\r\n          avatar: require('@/assets/img/xxgk/1728446731.jpg'),  // 将import改为avatar\r\n          story: '王芳同学在2023年全国职业院校技能大赛会计项目中获得一等奖，专业技能突出，学习态度端正，是专业学习的标兵。'\r\n        }\r\n      ],\r\n      studentWorks: [\r\n        {\r\n          title: '《春天的畅想》',\r\n          author: '刘晓',\r\n          class: '艺术设计2101班',\r\n          image: require('@/assets/img/xxgk/1728446731.jpg'),\r\n          description: '这幅作品表达了作者对春天的美好向往，色彩明快，构图和谐。'\r\n        },\r\n        {\r\n          title: '《科技与未来》',\r\n          author: '张伟',\r\n          class: '计算机应用2102班',\r\n          image: require('@/assets/img/xxgk/1728446731.jpg'),\r\n          description: '这是一个3D打印作品，展示了作者对未来科技发展的畅想。'\r\n        },\r\n        {\r\n          title: '《我的家乡》',\r\n          author: '李梅',\r\n          class: '旅游管理2103班',\r\n          image: require('@/assets/img/xxgk/1728446731.jpg'),\r\n          description: '这篇散文描绘了作者家乡的美丽风景和风土人情，字里行间流露出对家乡的深厚感情。'\r\n        }\r\n      ]\r\n    }\r\n  },\r\n  created() {\r\n    // 根据URL查询参数设置当前活动的标签页\r\n    const tab = this.$route.query.tab;\r\n    if (tab) {\r\n      this.activeTab = tab;\r\n    }\r\n  },\r\n  watch: {\r