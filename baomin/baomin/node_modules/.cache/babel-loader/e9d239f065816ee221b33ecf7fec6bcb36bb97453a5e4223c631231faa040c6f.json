{"ast":null,"code":"//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n\nexport default {\n  name: 'AdmissionInfo',\n  data() {\n    return {\n      activeTab: 'policy',\n      majorData: [{\n        name: '计算机应用',\n        duration: '3年',\n        quota: '120人',\n        description: '培养具备计算机应用能力的技术人才，就业方向包括软件开发、网站建设、IT支持等。'\n      }, {\n        name: '电子商务',\n        duration: '3年',\n        quota: '100人',\n        description: '培养电子商务运营、网络营销等方面的专业人才，就业方向包括电商平台运营、网店客服等。'\n      }, {\n        name: '会计',\n        duration: '3年',\n        quota: '80人',\n        description: '培养具备会计核算、财务管理能力的专业人才，就业方向包括企事业单位会计、出纳等。'\n      }, {\n        name: '机电一体化',\n        duration: '3年',\n        quota: '90人',\n        description: '培养机电设备操作、维护、安装调试等方面的技术人才，就业方向包括制造业、自动化企业等。'\n      }, {\n        name: '汽车维修',\n        duration: '3年',\n        quota: '80人',\n        description: '培养汽车检测、维修、服务等方面的技术人才，就业方向包括汽车4S店、维修厂等。'\n      }],\n      queryForm: {\n        name: '',\n        idCard: '',\n        captcha: ''\n      },\n      queryRules: {\n        name: [{\n          required: true,\n          message: '请输入姓名',\n          trigger: 'blur'\n        }],\n        idCard: [{\n          required: true,\n          message: '请输入身份证号',\n          trigger: 'blur'\n        }, {\n          pattern: /(^\\d{15}$)|(^\\d{18}$)|(^\\d{17}(\\d|X|x)$)/,\n          message: '请输入正确的身份证号',\n          trigger: 'blur'\n        }],\n        captcha: [{\n          required: true,\n          message: '请输入验证码',\n          trigger: 'blur'\n        }]\n      },\n      showResult: false\n    };\n  },\n  methods: {\n    refreshCaptcha() {\n      this.$message({\n        message: '验证码已刷新',\n        type: 'success'\n      });\n    },\n    queryResult() {\n      this.$refs.queryForm.validate(valid => {\n        if (valid) {\n          // 模拟查询过程\n          setTimeout(() => {\n            this.showResult = true;\n          }, 1000);\n        } else {\n          return false;\n        }\n      });\n    },\n    resetForm(formName) {\n      this.$refs[formName].resetFields();\n      this.showResult = false;\n    },\n    downloadAdmission() {\n      this.$message({\n        message: '录取通知书下载中...',\n        type: 'success'\n      });\n      // 这里可以添加下载文件的逻辑\n    }\n  }\n};","map":{"version":3,"names":["name","data","activeTab","majorData","duration","quota","description","queryForm","idCard","captcha","queryRules","required","message","trigger","pattern","showResult","methods","refreshCaptcha","$message","type","queryResult","$refs","validate","valid","setTimeout","resetForm","formName","resetFields","downloadAdmission"],"sources":["src/components/AdmissionInfo.vue"],"sourcesContent":["<template>\r\n  <div class=\"admission-container\">\r\n    <h2>招生信息</h2>\r\n    \r\n    <el-tabs v-model=\"activeTab\" type=\"border-card\">\r\n      <el-tab-pane label=\"招生政策\" name=\"policy\">\r\n        <div class=\"content-section\">\r\n          <h3>2023年招生政策</h3>\r\n          <p>深圳市芬达职业技术学校是经深圳市教育局批准成立的全日制职业学校，面向全国招收初中毕业生。</p>\r\n          \r\n          <el-divider></el-divider>\r\n          \r\n          <h4>招生对象</h4>\r\n          <p>应、往届初中毕业生，年龄在14-18周岁之间，身体健康。</p>\r\n          \r\n          <h4>招生专业</h4>\r\n          <el-table :data=\"majorData\" style=\"width: 100%\">\r\n            <el-table-column prop=\"name\" label=\"专业名称\" width=\"180\"></el-table-column>\r\n            <el-table-column prop=\"duration\" label=\"学制\" width=\"100\"></el-table-column>\r\n            <el-table-column prop=\"quota\" label=\"招生人数\" width=\"120\"></el-table-column>\r\n            <el-table-column prop=\"description\" label=\"专业介绍\"></el-table-column>\r\n          </el-table>\r\n          \r\n          <h4>收费标准</h4>\r\n          <p>学费：6000元/年</p>\r\n          <p>住宿费：1200元/年（四人间）</p>\r\n          <p>书本费：800元/年（根据实际情况收取）</p>\r\n          \r\n          <h4>奖助学金</h4>\r\n          <p>学校设有国家助学金、学校奖学金、企业奖学金等多种奖助学金，帮助家庭经济困难学生完成学业。</p>\r\n        </div>\r\n      </el-tab-pane>\r\n      \r\n      <el-tab-pane label=\"报名流程\" name=\"process\">\r\n        <div class=\"content-section\">\r\n          <h3>报名流程</h3>\r\n          <el-steps :active=\"5\" align-center>\r\n            <el-step title=\"网上报名\" description=\"填写在线报名表\"></el-step>\r\n            <el-step title=\"资料审核\" description=\"学校审核报名资料\"></el-step>\r\n            <el-step title=\"通知面试\" description=\"通过短信通知面试时间\"></el-step>\r\n            <el-step title=\"面试录取\" description=\"面试合格即可录取\"></el-step>\r\n            <el-step title=\"缴费注册\" description=\"缴纳学费完成注册\"></el-step>\r\n          </el-steps>\r\n          \r\n          <el-divider></el-divider>\r\n          \r\n          <h4>报名所需材料</h4>\r\n          <el-card class=\"box-card\">\r\n            <div slot=\"header\" class=\"clearfix\">\r\n              <span>必备材料</span>\r\n            </div>\r\n            <div class=\"text item\">\r\n              <p>1. 本人身份证原件及复印件</p>\r\n              <p>2. 户口本原件及复印件</p>\r\n              <p>3. 初中毕业证原件及复印件</p>\r\n              <p>4. 近期免冠照片4张（2寸蓝底）</p>\r\n            </div>\r\n          </el-card>\r\n          \r\n          <h4>报名方式</h4>\r\n          <el-card class=\"box-card\">\r\n            <div class=\"text item\">\r\n              <p><strong>在线报名：</strong>通过学校官网在线报名系统填写报名信息</p>\r\n              <p><strong>现场报名：</strong>直接到学校招生办公室报名</p>\r\n              <p><strong>电话报名：</strong>拨打招生热线0755-12345678进行报名</p>\r\n            </div>\r\n          </el-card>\r\n        </div>\r\n      </el-tab-pane>\r\n      \r\n      <el-tab-pane label=\"录取结果\" name=\"results\">\r\n        <div class=\"content-section\">\r\n          <h3>录取结果查询</h3>\r\n          \r\n          <el-form :model=\"queryForm\" :rules=\"queryRules\" ref=\"queryForm\" label-width=\"100px\" class=\"query-form\">\r\n            <el-form-item label=\"姓名\" prop=\"name\">\r\n              <el-input v-model=\"queryForm.name\" placeholder=\"请输入姓名\"></el-input>\r\n            </el-form-item>\r\n            \r\n            <el-form-item label=\"身份证号\" prop=\"idCard\">\r\n              <el-input v-model=\"queryForm.idCard\" placeholder=\"请输入身份证号\"></el-input>\r\n            </el-form-item>\r\n            \r\n            <el-form-item label=\"验证码\" prop=\"captcha\">\r\n              <div class=\"captcha-container\">\r\n                <el-input v-model=\"queryForm.captcha\" placeholder=\"请输入验证码\"></el-input>\r\n                <img src=\"https://via.placeholder.com/120x40?text=验证码\" alt=\"验证码\" class=\"captcha-img\">\r\n                <el-button type=\"text\" @click=\"refreshCaptcha\">换一张</el-button>\r\n              </div>\r\n            </el-form-item>\r\n            \r\n            <el-form-item>\r\n              <el-button type=\"primary\" @click=\"queryResult\">查询</el-button>\r\n              <el-button @click=\"resetForm('queryForm')\">重置</el-button>\r\n            </el-form-item>\r\n          </el-form>\r\n          \r\n          <div v-if=\"showResult\" class=\"result-container\">\r\n            <el-result\r\n              icon=\"success\"\r\n              title=\"恭喜您已被录取！\"\r\n              subTitle=\"请按照通知要求在规定时间内完成缴费注册。\">\r\n              <template slot=\"extra\">\r\n                <el-button type=\"primary\" size=\"medium\" @click=\"downloadAdmission\">下载录取通知书</el-button>\r\n              </template>\r\n            </el-result>\r\n          </div>\r\n        </div>\r\n      </el-tab-pane>\r\n    </el-tabs>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'AdmissionInfo',\r\n  data() {\r\n    return {\r\n      activeTab: 'policy',\r\n      majorData: [\r\n        {\r\n          name: '计算机应用',\r\n          duration: '3年',\r\n          quota: '120人',\r\n          description: '培养具备计算机应用能力的技术人才，就业方向包括软件开发、网站建设、IT支持等。'\r\n        },\r\n        {\r\n          name: '电子商务',\r\n          duration: '3年',\r\n          quota: '100人',\r\n          description: '培养电子商务运营、网络营销等方面的专业人才，就业方向包括电商平台运营、网店客服等。'\r\n        },\r\n        {\r\n          name: '会计',\r\n          duration: '3年',\r\n          quota: '80人',\r\n          description: '培养具备会计核算、财务管理能力的专业人才，就业方向包括企事业单位会计、出纳等。'\r\n        },\r\n        {\r\n          name: '机电一体化',\r\n          duration: '3年',\r\n          quota: '90人',\r\n          description: '培养机电设备操作、维护、安装调试等方面的技术人才，就业方向包括制造业、自动化企业等。'\r\n        },\r\n        {\r\n          name: '汽车维修',\r\n          duration: '3年',\r\n          quota: '80人',\r\n          description: '培养汽车检测、维修、服务等方面的技术人才，就业方向包括汽车4S店、维修厂等。'\r\n        }\r\n      ],\r\n      queryForm: {\r\n        name: '',\r\n        idCard: '',\r\n        captcha: ''\r\n      },\r\n      queryRules: {\r\n        name: [\r\n          { required: true, message: '请输入姓名', trigger: 'blur' }\r\n        ],\r\n        idCard: [\r\n          { required: true, message: '请输入身份证号', trigger: 'blur' },\r\n          { pattern: /(^\\d{15}$)|(^\\d{18}$)|(^\\d{17}(\\d|X|x)$)/, message: '请输入正确的身份证号', trigger: 'blur' }\r\n        ],\r\n        captcha: [\r\n          { required: true, message: '请输入验证码', trigger: 'blur' }\r\n        ]\r\n      },\r\n      showResult: false\r\n    };\r\n  },\r\n  methods: {\r\n    refreshCaptcha() {\r\n      this.$message({\r\n        message: '验证码已刷新',\r\n        type: 'success'\r\n      });\r\n    },\r\n    queryResult() {\r\n      this.$refs.queryForm.validate((valid) => {\r\n        if (valid) {\r\n          // 模拟查询过程\r\n          setTimeout(() => {\r\n            this.showResult = true;\r\n          }, 1000);\r\n        } else {\r\n          return false;\r\n        }\r\n      });\r\n    },\r\n    resetForm(formName) {\r\n      this.$refs[formName].resetFields();\r\n      this.showResult = false;\r\n    },\r\n    downloadAdmission() {\r\n      this.$message({\r\n        message: '录取通知书下载中...',\r\n        type: 'success'\r\n      });\r\n      // 这里可以添加下载文件的逻辑\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.admission-container {\r\n  background-color: white;\r\n  padding: 20px;\r\n  border-radius: 4px;\r\n  box-shadow: 0 2px 12px 0 rgba(0, 0, 0, 0.1);\r\n}\r\n\r\nh2 {\r\n  color: #0d47a1;\r\n  margin-bottom: 20px;\r\n  text-align: center;\r\n}\r\n\r\n.content-section {\r\n  padding: 20px;\r\n}\r\n\r\nh3 {\r\n  color: #0d47a1;\r\n  margin-bottom: 15px;\r\n}\r\n\r\nh4 {\r\n  margin-top: 20px;\r\n  margin-bottom: 10px;\r\n  color: #303133;\r\n}\r\n\r\n.box-card {\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.query-form {\r\n  max-width: 500px;\r\n  margin: 0 auto;\r\n}\r\n\r\n.captcha-container {\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n.captcha-img {\r\n  margin: 0 10px;\r\n  height: 40px;\r\n  border: 1px solid #dcdfe6;\r\n}\r\n\r\n.result-container {\r\n  margin-top: 30px;\r\n}\r\n</style>"],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAkHA;EACAA,IAAA;EACAC,KAAA;IACA;MACAC,SAAA;MACAC,SAAA,GACA;QACAH,IAAA;QACAI,QAAA;QACAC,KAAA;QACAC,WAAA;MACA,GACA;QACAN,IAAA;QACAI,QAAA;QACAC,KAAA;QACAC,WAAA;MACA,GACA;QACAN,IAAA;QACAI,QAAA;QACAC,KAAA;QACAC,WAAA;MACA,GACA;QACAN,IAAA;QACAI,QAAA;QACAC,KAAA;QACAC,WAAA;MACA,GACA;QACAN,IAAA;QACAI,QAAA;QACAC,KAAA;QACAC,WAAA;MACA,EACA;MACAC,SAAA;QACAP,IAAA;QACAQ,MAAA;QACAC,OAAA;MACA;MACAC,UAAA;QACAV,IAAA,GACA;UAAAW,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA,EACA;QACAL,MAAA,GACA;UAAAG,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA,GACA;UAAAC,OAAA;UAAAF,OAAA;UAAAC,OAAA;QAAA,EACA;QACAJ,OAAA,GACA;UAAAE,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA;MAEA;MACAE,UAAA;IACA;EACA;EACAC,OAAA;IACAC,eAAA;MACA,KAAAC,QAAA;QACAN,OAAA;QACAO,IAAA;MACA;IACA;IACAC,YAAA;MACA,KAAAC,KAAA,CAAAd,SAAA,CAAAe,QAAA,CAAAC,KAAA;QACA,IAAAA,KAAA;UACA;UACAC,UAAA;YACA,KAAAT,UAAA;UACA;QACA;UACA;QACA;MACA;IACA;IACAU,UAAAC,QAAA;MACA,KAAAL,KAAA,CAAAK,QAAA,EAAAC,WAAA;MACA,KAAAZ,UAAA;IACA;IACAa,kBAAA;MACA,KAAAV,QAAA;QACAN,OAAA;QACAO,IAAA;MACA;MACA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}