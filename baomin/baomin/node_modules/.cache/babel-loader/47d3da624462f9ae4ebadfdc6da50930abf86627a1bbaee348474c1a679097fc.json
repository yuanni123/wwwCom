{"ast":null,"code":"//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n\nexport default {\n  name: 'HomeView',\n  methods: {\n    navigateTo(section) {\n      if (section === 'moral-education') {\n        this.$router.push('/moral-education');\n      } else if (section === 'campus-activities') {\n        this.$router.push('/campus-activities');\n      } else if (section === 'student-clubs') {\n        this.$router.push('/student-clubs');\n      } else if (section === 'school-history') {\n        this.$router.push('/school-history');\n      } else {\n        // 对于其他部分，保持在主页但激活相应部分\n        this.$router.push({\n          path: '/culture',\n          query: {\n            section\n          }\n        });\n      }\n    }\n  }\n};","map":{"version":3,"names":["name","methods","navigateTo","section","$router","push","path","query"],"sources":["src/lsh/HomeView.vue"],"sourcesContent":["<template>\r\n  <div class=\"home\">\r\n    <header class=\"welcome-header\">\r\n      <h1>欢迎访问校园文化网</h1>\r\n      <p>展示校园风采，传承校园文化</p>\r\n    </header>\r\n    \r\n    <div class=\"section-links\">\r\n      <div class=\"section-card\" @click=\"navigateTo('campus-activities')\">\r\n        <div class=\"card-icon\" style=\"background-image: url('/images/art-festival.svg')\"></div>\r\n        <h2>校园活动</h2>\r\n        <p>了解校园丰富多彩的活动</p>\r\n      </div>\r\n      \r\n      <div class=\"section-card\" @click=\"navigateTo('student-clubs')\">\r\n        <div class=\"card-icon\" style=\"background-image: url('/images/reading-month.svg')\"></div>\r\n        <h2>社团组织</h2>\r\n        <p>探索校园社团的精彩世界</p>\r\n      </div>\r\n      \r\n      <div class=\"section-card\" @click=\"navigateTo('school-history')\">\r\n        <div class=\"card-icon\" style=\"background-image: url('/images/tech-innovation.svg')\"></div>\r\n        <h2>校史馆</h2>\r\n        <p>回顾学校发展的光辉历程</p>\r\n      </div>\r\n      \r\n      <div class=\"section-card\" @click=\"navigateTo('moral-education')\">\r\n        <div class=\"card-icon\" style=\"background-image: url('/images/art-festival.svg')\"></div>\r\n        <h2>德育之窗</h2>\r\n        <p>培养学生良好品德，促进身心健康发展</p>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'HomeView',\r\n  methods: {\r\n    navigateTo(section) {\r\n      if (section === 'moral-education') {\r\n        this.$router.push('/moral-education');\r\n      } else if (section === 'campus-activities') {\r\n        this.$router.push('/campus-activities');\r\n      } else if (section === 'student-clubs') {\r\n        this.$router.push('/student-clubs');\r\n      } else if (section === 'school-history') {\r\n        this.$router.push('/school-history');\r\n      } else {\r\n        // 对于其他部分，保持在主页但激活相应部分\r\n        this.$router.push({ path: '/culture', query: { section } });\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.home {\r\n  padding: 2rem;\r\n  max-width: 1200px;\r\n  margin: 0 auto;\r\n}\r\n\r\n.welcome-header {\r\n  text-align: center;\r\n  margin-bottom: 3rem;\r\n}\r\n\r\n.welcome-header h1 {\r\n  color: #1e3c72;\r\n  font-size: 2.5rem;\r\n  margin-bottom: 0.5rem;\r\n}\r\n\r\n.welcome-header p {\r\n  color: #666;\r\n  font-size: 1.2rem;\r\n}\r\n\r\n.section-links {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));\r\n  gap: 2rem;\r\n}\r\n\r\n.section-card {\r\n  background-color: white;\r\n  border-radius: 8px;\r\n  padding: 2rem;\r\n  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);\r\n  text-align: center;\r\n  cursor: pointer;\r\n  transition: transform 0.3s ease, box-shadow 0.3s ease;\r\n}\r\n\r\n.section-card:hover {\r\n  transform: translateY(-5px);\r\n  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);\r\n}\r\n\r\n.card-icon {\r\n  width: 80px;\r\n  height: 80px;\r\n  margin: 0 auto 1.5rem;\r\n  background-size: contain;\r\n  background-position: center;\r\n  background-repeat: no-repeat;\r\n}\r\n\r\n.section-card h2 {\r\n  color: #1e3c72;\r\n  margin-bottom: 1rem;\r\n  font-size: 1.5rem;\r\n}\r\n\r\n.section-card p {\r\n  color: #666;\r\n}\r\n</style>"],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAoCA;EACAA,IAAA;EACAC,OAAA;IACAC,WAAAC,OAAA;MACA,IAAAA,OAAA;QACA,KAAAC,OAAA,CAAAC,IAAA;MACA,WAAAF,OAAA;QACA,KAAAC,OAAA,CAAAC,IAAA;MACA,WAAAF,OAAA;QACA,KAAAC,OAAA,CAAAC,IAAA;MACA,WAAAF,OAAA;QACA,KAAAC,OAAA,CAAAC,IAAA;MACA;QACA;QACA,KAAAD,OAAA,CAAAC,IAAA;UAAAC,IAAA;UAAAC,KAAA;YAAAJ;UAAA;QAAA;MACA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}