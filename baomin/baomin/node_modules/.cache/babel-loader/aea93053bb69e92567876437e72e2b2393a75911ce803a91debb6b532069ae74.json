mage>\r\n      <div class=\"banner-overlay\">\r\n        <h1>联系我们</h1>\r\n        <p>欢迎随时与我们联系</p>\r\n      </div>\r\n    </div>\r\n    \r\n    <el-container class=\"main-container\">\r\n      <el-main class=\"main-content\">\r\n        <div class=\"contact-info-container\">\r\n          <h2 class=\"section-title\">联系方式</h2>\r\n          \r\n          <div class=\"contact-section\">\r\n            <h3>学校地址</h3>\r\n            <p><i class=\"el-icon-location\"></i> 深圳市宝安区松白路7022号宝民技工学校</p>\r\n            <div class=\"map-container\">\r\n              <!-- 这里可以放置地图组件或图片 -->\r\n           \r\n            </div>\r\n          </div>\r\n          \r\n          <div class=\"contact-section\">\r\n            <h3>联系电话</h3>\r\n            <p><i class=\"el-icon-phone\"></i> 招生咨询：18018770098</p>\r\n            <p><i class=\"el-icon-phone\"></i> 学校办公室：0755-XXXXXXXX</p>\r\n            <p><i class=\"el-icon-phone\"></i> 人事部门：0755-XXXXXXXX</p>\r\n          </div>\r\n          \r\n          <div class=\"contact-section\">\r\n            <h3>电子邮箱</h3>\r\n            <p><i class=\"el-icon-message\"></i> 学校邮箱：info@baominschool.com</p>\r\n            <p><i class=\"el-icon-message\"></i> 招生咨询：admission@baominschool.com</p>\r\n            <p><i class=\"el-icon-message\"></i> 人才招聘：hr@baominschool.com</p>\r\n          </div>\r\n          \r\n          <div class=\"contact-section\">\r\n            <h3>关注我们</h3>\r\n            <div class=\"social-media\">\r\n              <div class=\"qrcode-item\">\r\n                <img src=\"@/assets/img/xxgk/1728446731.jpg\" alt=\"微信公众号\" class=\"qrcode\">\r\n                <p>微信公众号</p>\r\n              </div>\r\n              <div class=\"qrcode-item\">\r\n                <img src=\"@/assets/img/xxgk/1728446731.jpg\" alt=\"招生咨询\" class=\"qrcode\">\r\n                <p>招生咨询</p>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          \r\n          <div class=\"contact-section\">\r\n            <h3>在线留言</h3>\r\n            <el-form