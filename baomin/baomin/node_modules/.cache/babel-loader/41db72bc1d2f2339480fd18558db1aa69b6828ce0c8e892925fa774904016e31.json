{"ast":null,"code":"//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n\nimport { ref, computed, onMounted, onUnmounted } from 'vue';\nimport { Swiper, SwiperSlide } from 'swiper/vue';\nimport { Navigation, Pagination, Autoplay } from 'swiper/modules';\nimport 'swiper/css';\nimport 'swiper/css/navigation';\nimport 'swiper/css/pagination';\nimport 'swiper/css/autoplay';\n\n// 导入轮播图图片\nimport image1 from '../assets/微信图片_20240423091719.jpg';\nimport image2 from '../assets/微信图片_20240521201519.jpg';\nimport image3 from '../assets/微信图片_20240521201545.jpg';\n\n// 轮播图数据\nconst slides = [{\n  image: image1,\n  title: '校园风光'\n}, {\n  image: image2,\n  title: '教学活动'\n}, {\n  image: image3,\n  title: '学生生活'\n}];\n\n// 公告数据\nconst notices = [{\n  title: '我校举办2024年春季运动会',\n  date: '2024-05-15'\n}, {\n  title: '2024年学科竞赛报名开始',\n  date: '2024-05-10'\n}, {\n  title: '关于期末考试安排的通知',\n  date: '2024-05-08'\n}, {\n  title: '校园文化节活动安排',\n  date: '2024-05-05'\n}, {\n  title: '图书馆开放时间调整',\n  date: '2024-05-01'\n}];\n\n// 新闻分类\nconst categories = [{\n  id: 'campus',\n  name: '校园新闻'\n}, {\n  id: 'notice',\n  name: '通知公告'\n}, {\n  id: 'media',\n  name: '媒体报道'\n}];\nconst currentCategory = ref('campus');\nconst selectedNewsId = ref(null);\nconst readingProgress = ref(0);\n\n// 新闻列表数据\nconst newsList = [\n// 校园新闻\n{\n  id: 1,\n  title: '我校举办2024年春季运动会',\n  date: '2024-03-15',\n  excerpt: '为促进师生身心健康发展，展现校园活力...',\n  category: 'campus',\n  views: 245\n}, {\n  id: 2,\n  title: '2024年教师教学创新大赛圆满结束',\n  date: '2024-03-12',\n  excerpt: '为提升教育教学质量，推动教学改革创新，我校成功举办2024年教师教学创新大赛...',\n  category: 'campus',\n  views: 189\n}, {\n  id: 3,\n  title: '我校学生在全国大学生创新创业大赛中获特等奖',\n  date: '2024-03-10',\n  excerpt: '在第九届全国大学生创新创业大赛总决赛中，我校机械工程学院学生团队凭借\"智能环保机器人\"项目...',\n  category: 'campus',\n  views: 320\n}, {\n  id: 4,\n  title: '校园acee文化节开幕式圆满举行',\n  date: '2024-03-08',\n  excerpt: '第十五届校园acee文化节在大礼堂隆重开幕，来自各院系的学生带来精彩表演...',\n  category: 'campus',\n  views: 276\n}, {\n  id: 5,\n  title: '我校举办第三届国际学术研讨会',\n  date: '2024-03-06',\n  excerpt: '来自全球多个国家的专家学者齐聚我校，共同探讨学科发展前沿问题...',\n  category: 'campus',\n  views: 198\n}, {\n  id: 6,\n  title: '图书馆举办读书月活动',\n  date: '2024-03-04',\n  excerpt: '为培养学生的阅读兴趣，图书馆特别策划了系列读书活动...',\n  category: 'campus',\n  views: 156\n}, {\n  id: 7,\n  title: '校园志愿服务队获市级表彰',\n  date: '2024-03-02',\n  excerpt: '我校志愿服务队在市级评选中脱颖而出，获得\"最佳志愿服务团队\"称号...',\n  category: 'campus',\n  views: 210\n}, {\n  id: 8,\n  title: '学生社团联合会换届大会顺利召开',\n  date: '2024-02-28',\n  excerpt: '新一届学生社团联合会正式成立，将致力于推动校园文化建设...',\n  category: 'campus',\n  views: 178\n}, {\n  id: 9,\n  title: '我校成功举办首届人工智能创新大赛',\n  date: '2024-02-26',\n  excerpt: '来自全校各院系的300多名学生参与比赛，展示人工智能创新成果...',\n  category: 'campus',\n  views: 289\n},\n// 通知公告\n{\n  id: 10,\n  title: '关于2024年清明节放假安排的通知',\n  date: '2024-03-20',\n  excerpt: '根据国务院办公厅通知和学校实际情况，现将2024年清明节放假安排通知如下...',\n  category: 'notice',\n  views: 432\n}, {\n  id: 11,\n  title: '2024学年第二学期奖学金申请通知',\n  date: '2024-03-18',\n  excerpt: '各院系学生：2024学年第二学期奖学金申请工作现已开始，请符合条件的同学按要求提交材料...',\n  category: 'notice',\n  views: 387\n}, {\n  id: 12,\n  title: '关于开展2024年度教师职称评定工作的通知',\n  date: '2024-03-16',\n  excerpt: '为做好2024年度教师职称评定工作，根据上级文件精神，结合我校实际情况...',\n  category: 'notice',\n  views: 256\n}, {\n  id: 13,\n  title: '关于组织开展2024年暑期社会实践的通知',\n  date: '2024-03-14',\n  excerpt: '为深入贯彻执行习近平新时代中国特色社会主义思想，为学生社会责任感...',\n  category: 'notice',\n  views: 312\n}, {\n  id: 14,\n  title: '2024年研究生招生考试复试通知',\n  date: '2024-03-12',\n  excerpt: '我校2024年研究生招生考试复试工作即将开始，现将有关事项通知如下...',\n  category: 'notice',\n  views: 478\n}, {\n  id: 15,\n  title: '关于开展2024年度学生证件补办的通知',\n  date: '2024-03-10',\n  excerpt: '为方便学生办理各类证件，学校将集中开展一次证件补办工作...',\n  category: 'notice',\n  views: 345\n}, {\n  id: 16,\n  title: '图书馆关于举办信息检索大赛的通知',\n  date: '2024-03-08',\n  excerpt: '为提高学生信息素养和检索能力，图书馆将举办第五届信息检索大赛...',\n  category: 'notice',\n  views: 187\n}, {\n  id: 17,\n  title: '关于开展2024年度学生社团年审的通知',\n  date: '2024-03-06',\n  excerpt: '为规范学生社团管理，提升社团活动质量，现开展年度社团审核工作...',\n  category: 'notice',\n  views: 234\n}, {\n  id: 18,\n  title: '关于举办校园网络安全知识竞赛的通知',\n  date: '2024-03-04',\n  excerpt: '为提高全校师生网络安全意识，将举办校园网络安全知识竞赛...',\n  category: 'notice',\n  views: 198\n},\n// 媒体报道\n{\n  id: 19,\n  title: '央视新闻：我校科研团队取得重大突破',\n  date: '2024-03-14',\n  excerpt: '近日，我校材料科学研究团队在新型环保材料领域取得重大突破，相关研究成果已发表在国际顶级期刊...',\n  category: 'media',\n  views: 567,\n  source: '央视新闻'\n}, {\n  id: 20,\n  title: '人民日报：我校智慧教育改革经验获广泛关注',\n  date: '2024-03-08',\n  excerpt: '在教育部组织的\"智慧教育示范校\"评选中，我校凭借创新的教学模式和完善的智慧校园建设...',\n  category: 'media',\n  views: 489,\n  source: '人民日报'\n}, {\n  id: 21,\n  title: '新华网：校企合作助力产教融合发展',\n  date: '2024-03-05',\n  excerpt: '我校与多家知名企业签署战略合作协议，共建产学研基地，推动高校科研成果转化...',\n  category: 'media',\n  views: 412,\n  source: '新华网'\n}, {\n  id: 22,\n  title: '光明日报：我校在基础研究领域取得突破性进展',\n  date: '2024-03-02',\n  excerpt: '我校物理研究所在量子计算领域取得重要突破，相关成果登上Nature子刊...',\n  category: 'media',\n  views: 378,\n  source: '光明日报'\n}, {\n  id: 23,\n  title: '中国教育报：我校创新人才培养模式获好评',\n  date: '2024-02-28',\n  excerpt: '我校实施的\"产学研\"一体化人才培养模式，获得教育部门肯定...',\n  category: 'media',\n  views: 325,\n  source: '中国教育报'\n}, {\n  id: 24,\n  title: '科技日报：我校在生物医药领域获重大突破',\n  date: '2024-02-25',\n  excerpt: '我校生物医学工程团队研发新型药物递送系统取得重要进展...',\n  category: 'media',\n  views: 402,\n  source: '科技日报'\n}, {\n  id: 25,\n  title: '中国青年报：我校毕业生就业质量位居前列',\n  date: '2024-02-22',\n  excerpt: '第三方机构发布的就业质量报告显示，我校毕业生就业率和薪资水平均位居前列...',\n  category: 'media',\n  views: 356,\n  source: '中国青年报'\n}, {\n  id: 26,\n  title: '经济日报：我校科技成果转化成效显著',\n  date: '2024-02-19',\n  excerpt: '我校通过产学研合作，已成功孵化多个高科技项目，带动地方经济发展...',\n  category: 'media',\n  views: 298,\n  source: '经济日报'\n}, {\n  id: 27,\n  title: '中国科学报：我校在国际学术竞赛中创佳绩',\n  date: '2024-02-16',\n  excerpt: '我校学子在国际大学生程序设计竞赛中获得金牌，展现出较强的竞争力...',\n  category: 'media',\n  views: 342,\n  source: '中国科学报'\n}];\n\n// 根据分类筛选新闻\nconst filteredNews = computed(() => {\n  return newsList.filter(news => news.category === currentCategory.value);\n});\n\n// 获取当前选中的新闻\nconst currentNews = computed(() => {\n  return newsList.find(news => news.id === selectedNewsId.value);\n});\n\n// 获取分类名称\nconst getCategoryName = category => {\n  const categoryMap = {\n    'campus': '校园新闻',\n    'notice': '通知公告',\n    'media': '媒体报道'\n  };\n  return categoryMap[category] || '';\n};\n\n// 生成新闻内容\nconst generateContent = (category, title) => {\n  const contentMap = {\n    'campus': `\n      进一步推动我校教育事业发展，提升教育教学质量，近日，我校举办了一系列重要活动。\n      在活动中，师生们展现出了极大的热情和创造力。通过此次活动，不仅增进了师生间的交流，\n      也为学校的未来发展注入了新的活力。活动得到了校领导的高度重视，相关负责人表示，\n      今后将继续举办类似活动，为师生搭建更好的交流平台。\n      \n      本次活动的成功举办，离开部门们的通力协作。参与活动的师生们都表示，希望能够有更多\n      类似的活动，为校园文化建设贡献力量。活动结束后，组委会对活动进行了总结，并提出了\n      下一步的工作计划。\n    `,\n    'notice': `\n      根据学校整体工作安排，结合实际情况，现就相关事项通知如下：\n      \n      一、工作目标\n      深入贯彻上级精神，切实做好各项工作。\n      \n      二、具体安排\n      1. 各单位要重视，认真acee排序；\n      2. 加强协调配合，确保工作有序开展；\n      3. 注意工作实效，及时总结经验。\n      \n      三、工作要求\n      1. 提高认识，加强领导；\n      2. 明确职责，落实任务；\n      3. 强化监督，确保实效。\n    `,\n    'media': `\n      近日，我校在教育教学、科研创新等方面取得的成绩受到社会各界广泛关注。通过持续深化\n      教育改革，推进产学研合作，学校的综合实力得到显著提升。\n      \n      专家们认为，我校在人才培养模式创新、科研成果转化等方面的经验具有重要的示范意义。\n      下一步，学校将继续深化改革，加强内涵建设，为建设高水平大学而不懈努力。\n      \n      此外，学校还将进一步与企业、科研院所的合作，推动科技成果转化，为地方的社会经济\n      发展作出更大贡献。\n    `\n  };\n  return contentMap[category] || '详细内容正在整理中...';\n};\n\n// 查看新闻详情\nconst viewNewsDetail = id => {\n  selectedNewsId.value = id;\n  window.scrollTo(0, 0);\n};\n\n// 返回新闻列表\nconst backToNewsList = () => {\n  selectedNewsId.value = null;\n};\n\n// 显示主页新闻\nconst showMainNews = () => {\n  selectedNewsId.value = null;\n  currentCategory.value = 'campus';\n};\n\n// 根据分类筛选新闻\nconst filterNewsByCategory = category => {\n  selectedNewsId.value = null;\n  currentCategory.value = category;\n};\n\n// 筛选公告\nconst filterNotice = notice => {\n  // 查找标题匹配的新闻\n  const matchedNews = newsList.find(news => news.title.includes(notice.title) || notice.title.includes(news.title));\n  if (matchedNews) {\n    viewNewsDetail(matchedNews.id);\n  } else {\n    // 如果没找到匹配的，就显示通知公告分类\n    filterNewsByCategory('notice');\n  }\n};\n\n// 计算阅读进度\nconst calculateReadingProgress = () => {\n  const scrollTop = window.scrollY;\n  const docHeight = document.documentElement.scrollHeight - window.innerHeight;\n  readingProgress.value = scrollTop / docHeight * 100;\n};\n\n// 图片加载完成\nconst onImageLoad = event => {\n  event.target.classList.add('loaded');\n};\n\n// 生命周期钩子\nonMounted(() => {\n  window.addEventListener('scroll', calculateReadingProgress);\n});\nonUnmounted(() => {\n  window.removeEventListener('scroll', calculateReadingProgress);\n});","map":{"version":3,"names":["ref","computed","onMounted","onUnmounted","Swiper","SwiperSlide","Navigation","Pagination","Autoplay","image1","image2","image3","slides","image","title","notices","date","categories","id","name","currentCategory","selectedNewsId","readingProgress","newsList","excerpt","category","views","source","filteredNews","filter","news","value","currentNews","find","getCategoryName","categoryMap","generateContent","contentMap","viewNewsDetail","window","scrollTo","backToNewsList","showMainNews","filterNewsByCategory","filterNotice","notice","matchedNews","includes","calculateReadingProgress","scrollTop","scrollY","docHeight","document","documentElement","scrollHeight","innerHeight","onImageLoad","event","target","classList","add","addEventListener","removeEventListener"],"sources":["src/views/NewsPage.vue"],"sourcesContent":["<template>\r\n  <div class=\"app\">\r\n    <header class=\"header\">\r\n      <h1>学校新闻中心</h1>\r\n    </header>\r\n    \r\n    <div class=\"main-container\">\r\n      <!-- 左侧导航栏 -->\r\n      <aside class=\"sidebar left-sidebar\">\r\n        <h3>快速导航</h3>\r\n        <ul class=\"nav-list\">\r\n          <li><a href=\"#\" @click.prevent=\"showMainNews\">首页</a></li>\r\n          <li><a href=\"#\" @click.prevent=\"filterNewsByCategory('notice')\">学校公告</a></li>\r\n          <li><a href=\"#\" @click.prevent=\"filterNewsByCategory('campus')\">教学动态</a></li>\r\n          <li><a href=\"#\" @click.prevent=\"filterNewsByCategory('campus')\">学生活动</a></li>\r\n          <li><a href=\"#\" @click.prevent=\"filterNewsByCategory('media')\">校园风采</a></li>\r\n        </ul>\r\n      </aside>\r\n      \r\n      <!-- 中间内容区 -->\r\n      <div class=\"content-area\">\r\n        <!-- 轮播图 -->\r\n        <div class=\"swiper-container\" v-if=\"!selectedNewsId\">\r\n          <swiper\r\n            :modules=\"[Navigation, Pagination, Autoplay]\"\r\n            :slides-per-view=\"1\"\r\n            :loop=\"true\"\r\n            :autoplay=\"{\r\n              delay: 3000,\r\n              disableOnInteraction: false\r\n            }\"\r\n            :pagination=\"{ clickable: true }\"\r\n            :navigation=\"true\"\r\n          >\r\n            <swiper-slide v-for=\"(slide, index) in slides\" :key=\"index\">\r\n              <img :src=\"slide.image\" :alt=\"slide.title\">\r\n            </swiper-slide>\r\n          </swiper>\r\n        </div>\r\n\r\n        <!-- 新闻列表区域 -->\r\n        <div v-if=\"!selectedNewsId\" class=\"news-container\">\r\n          <div class=\"news-categories\">\r\n            <div \r\n              v-for=\"category in categories\" \r\n              :key=\"category.id\"\r\n              :class=\"['category-tab', { active: currentCategory === category.id }]\"\r\n              @click=\"currentCategory = category.id\"\r\n            >\r\n              {{ category.name }}\r\n            </div>\r\n          </div>\r\n          <div class=\"news-grid\">\r\n            <div v-for=\"news in filteredNews\" :key=\"news.id\" class=\"news-card\">\r\n              <div class=\"news-card-content\">\r\n                <div class=\"news-header\">\r\n                  <h3>{{ news.title }}</h3>\r\n                </div>\r\n                <div class=\"news-meta\">\r\n                  <span class=\"date-chip\">{{ news.date }}</span>\r\n                </div>\r\n                <p class=\"news-excerpt\">{{ news.excerpt }}</p>\r\n                <div class=\"read-more\" @click=\"viewNewsDetail(news.id)\">\r\n                  <span>阅读更多</span>\r\n                  <i class=\"arrow-icon\">→</i>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n\r\n        <!-- 新闻详情区域 -->\r\n        <div v-if=\"selectedNewsId\" class=\"news-detail-container\">\r\n          <!-- 添加阅读进度条 -->\r\n          <div class=\"reading-progress\" :style=\"{ width: readingProgress + '%' }\"></div>\r\n          \r\n          <div class=\"news-detail-content\">\r\n            <h1>{{ currentNews?.title }}</h1>\r\n            <div class=\"meta\">\r\n              <span class=\"date\">{{ currentNews?.date }}</span>\r\n              <span class=\"category\">{{ getCategoryName(currentNews?.category) }}</span>\r\n              <span class=\"views\">阅读量：{{ currentNews?.views || 0 }}</span>\r\n            </div>\r\n            <div class=\"content\">\r\n              <p class=\"excerpt\">{{ currentNews?.excerpt }}</p>\r\n              <div class=\"full-content\">\r\n                <!-- 添加首字下沉效果 -->\r\n                <p class=\"content-text\">{{ currentNews?.content || generateContent(currentNews?.category, currentNews?.title) }}</p>\r\n                \r\n                <div v-if=\"currentNews?.images\" class=\"news-images\">\r\n                  <!-- 添加图片加载动画 -->\r\n                  <div v-for=\"(img, index) in currentNews?.images\" \r\n                       :key=\"index\"\r\n                       class=\"image-wrapper\">\r\n                    <img :src=\"img\" \r\n                         :alt=\"currentNews?.title\"\r\n                         class=\"news-image\"\r\n                         @load=\"onImageLoad\">\r\n                    <div class=\"image-overlay\">\r\n                      <span class=\"zoom-icon\">🔍</span>\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n                \r\n                <div class=\"news-footer\">\r\n                  <p class=\"source\">信息来源：{{ currentNews?.source || '校园新闻中心' }}</p>\r\n                  <p class=\"editor\">编辑：{{ currentNews?.editor || '校园新闻部' }}</p>\r\n                </div>\r\n              </div>\r\n            </div>\r\n            <div class=\"back-button\" @click=\"backToNewsList\">\r\n              <i class=\"arrow-icon\">←</i>\r\n              <span>返回列表</span>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      \r\n      <!-- 右侧信息栏 -->\r\n      <aside class=\"sidebar right-sidebar\">\r\n        <div class=\"info-card\">\r\n          <h3>最新公告</h3>\r\n          <ul class=\"notice-list\">\r\n            <li v-for=\"(notice, index) in notices\" :key=\"index\">\r\n              <a href=\"#\" @click.prevent=\"filterNotice(notice)\">{{ notice.title }}</a>\r\n              <span class=\"date\">{{ notice.date }}</span>\r\n            </li>\r\n          </ul>\r\n        </div>\r\n        \r\n        <div class=\"info-card\">\r\n          <h3>联系我们</h3>\r\n          <p><i class=\"icon\">📞</i> 电话: 123-4567-8910</p>\r\n          <p><i class=\"icon\">✉️</i> 邮箱: contact@school.edu</p>\r\n          <p><i class=\"icon\">🏢</i> 地址: 学校路123号</p>\r\n        </div>\r\n      </aside>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script setup>\r\nimport { ref, computed, onMounted, onUnmounted } from 'vue'\r\nimport { Swiper, SwiperSlide } from 'swiper/vue'\r\nimport { Navigation, Pagination, Autoplay } from 'swiper/modules'\r\nimport 'swiper/css'\r\nimport 'swiper/css/navigation'\r\nimport 'swiper/css/pagination'\r\nimport 'swiper/css/autoplay'\r\n\r\n// 导入轮播图图片\r\nimport image1 from '../assets/微信图片_20240423091719.jpg'\r\nimport image2 from '../assets/微信图片_20240521201519.jpg'\r\nimport image3 from '../assets/微信图片_20240521201545.jpg'\r\n\r\n// 轮播图数据\r\nconst slides = [\r\n  {\r\n    image: image1,\r\n    title: '校园风光'\r\n  },\r\n  {\r\n    image: image2,\r\n    title: '教学活动'\r\n  },\r\n  {\r\n    image: image3,\r\n    title: '学生生活'\r\n  }\r\n]\r\n\r\n// 公告数据\r\nconst notices = [\r\n  { title: '我校举办2024年春季运动会', date: '2024-05-15' },\r\n  { title: '2024年学科竞赛报名开始', date: '2024-05-10' },\r\n  { title: '关于期末考试安排的通知', date: '2024-05-08' },\r\n  { title: '校园文化节活动安排', date: '2024-05-05' },\r\n  { title: '图书馆开放时间调整', date: '2024-05-01' }\r\n]\r\n\r\n// 新闻分类\r\nconst categories = [\r\n  { id: 'campus', name: '校园新闻' },\r\n  { id: 'notice', name: '通知公告' },\r\n  { id: 'media', name: '媒体报道' }\r\n]\r\n\r\nconst currentCategory = ref('campus')\r\nconst selectedNewsId = ref(null)\r\nconst readingProgress = ref(0)\r\n\r\n// 新闻列表数据\r\nconst newsList = [\r\n  // 校园新闻\r\n  {\r\n    id: 1,\r\n    title: '我校举办2024年春季运动会',\r\n    date: '2024-03-15',\r\n    excerpt: '为促进师生身心健康发展，展现校园活力...',\r\n    category: 'campus',\r\n    views: 245\r\n  },\r\n  {\r\n    id: 2,\r\n    title: '2024年教师教学创新大赛圆满结束',\r\n    date: '2024-03-12',\r\n    excerpt: '为提升教育教学质量，推动教学改革创新，我校成功举办2024年教师教学创新大赛...',\r\n    category: 'campus',\r\n    views: 189\r\n  },\r\n  {\r\n    id: 3,\r\n    title: '我校学生在全国大学生创新创业大赛中获特等奖',\r\n    date: '2024-03-10',\r\n    excerpt: '在第九届全国大学生创新创业大赛总决赛中，我校机械工程学院学生团队凭借\"智能环保机器人\"项目...',\r\n    category: 'campus',\r\n    views: 320\r\n  },\r\n  {\r\n    id: 4,\r\n    title: '校园acee文化节开幕式圆满举行',\r\n    date: '2024-03-08',\r\n    excerpt: '第十五届校园acee文化节在大礼堂隆重开幕，来自各院系的学生带来精彩表演...',\r\n    category: 'campus',\r\n    views: 276\r\n  },\r\n  {\r\n    id: 5,\r\n    title: '我校举办第三届国际学术研讨会',\r\n    date: '2024-03-06',\r\n    excerpt: '来自全球多个国家的专家学者齐聚我校，共同探讨学科发展前沿问题...',\r\n    category: 'campus',\r\n    views: 198\r\n  },\r\n  {\r\n    id: 6,\r\n    title: '图书馆举办读书月活动',\r\n    date: '2024-03-04',\r\n    excerpt: '为培养学生的阅读兴趣，图书馆特别策划了系列读书活动...',\r\n    category: 'campus',\r\n    views: 156\r\n  },\r\n  {\r\n    id: 7,\r\n    title: '校园志愿服务队获市级表彰',\r\n    date: '2024-03-02',\r\n    excerpt: '我校志愿服务队在市级评选中脱颖而出，获得\"最佳志愿服务团队\"称号...',\r\n    category: 'campus',\r\n    views: 210\r\n  },\r\n  {\r\n    id: 8,\r\n    title: '学生社团联合会换届大会顺利召开',\r\n    date: '2024-02-28',\r\n    excerpt: '新一届学生社团联合会正式成立，将致力于推动校园文化建设...',\r\n    category: 'campus',\r\n    views: 178\r\n  },\r\n  {\r\n    id: 9,\r\n    title: '我校成功举办首届人工智能创新大赛',\r\n    date: '2024-02-26',\r\n    excerpt: '来自全校各院系的300多名学生参与比赛，展示人工智能创新成果...',\r\n    category: 'campus',\r\n    views: 289\r\n  },\r\n  \r\n  // 通知公告\r\n  {\r\n    id: 10,\r\n    title: '关于2024年清明节放假安排的通知',\r\n    date: '2024-03-20',\r\n    excerpt: '根据国务院办公厅通知和学校实际情况，现将2024年清明节放假安排通知如下...',\r\n    category: 'notice',\r\n    views: 432\r\n  },\r\n  {\r\n    id: 11,\r\n    title: '2024学年第二学期奖学金申请通知',\r\n    date: '2024-03-18',\r\n    excerpt: '各院系学生：2024学年第二学期奖学金申请工作现已开始，请符合条件的同学按要求提交材料...',\r\n    category: 'notice',\r\n    views: 387\r\n  },\r\n  {\r\n    id: 12,\r\n    title: '关于开展2024年度教师职称评定工作的通知',\r\n    date: '2024-03-16',\r\n    excerpt: '为做好2024年度教师职称评定工作，根据上级文件精神，结合我校实际情况...',\r\n    category: 'notice',\r\n    views: 256\r\n  },\r\n  {\r\n    id: 13,\r\n    title: '关于组织开展2024年暑期社会实践的通知',\r\n    date: '2024-03-14',\r\n    excerpt: '为深入贯彻执行习近平新时代中国特色社会主义思想，为学生社会责任感...',\r\n    category: 'notice',\r\n    views: 312\r\n  },\r\n  {\r\n    id: 14,\r\n    title: '2024年研究生招生考试复试通知',\r\n    date: '2024-03-12',\r\n    excerpt: '我校2024年研究生招生考试复试工作即将开始，现将有关事项通知如下...',\r\n    category: 'notice',\r\n    views: 478\r\n  },\r\n  {\r\n    id: 15,\r\n    title: '关于开展2024年度学生证件补办的通知',\r\n    date: '2024-03-10',\r\n    excerpt: '为方便学生办理各类证件，学校将集中开展一次证件补办工作...',\r\n    category: 'notice',\r\n    views: 345\r\n  },\r\n  {\r\n    id: 16,\r\n    title: '图书馆关于举办信息检索大赛的通知',\r\n    date: '2024-03-08',\r\n    excerpt: '为提高学生信息素养和检索能力，图书馆将举办第五届信息检索大赛...',\r\n    category: 'notice',\r\n    views: 187\r\n  },\r\n  {\r\n    id: 17,\r\n    title: '关于开展2024年度学生社团年审的通知',\r\n    date: '2024-03-06',\r\n    excerpt: '为规范学生社团管理，提升社团活动质量，现开展年度社团审核工作...',\r\n    category: 'notice',\r\n    views: 234\r\n  },\r\n  {\r\n    id: 18,\r\n    title: '关于举办校园网络安全知识竞赛的通知',\r\n    date: '2024-03-04',\r\n    excerpt: '为提高全校师生网络安全意识，将举办校园网络安全知识竞赛...',\r\n    category: 'notice',\r\n    views: 198\r\n  },\r\n\r\n  // 媒体报道\r\n  {\r\n    id: 19,\r\n    title: '央视新闻：我校科研团队取得重大突破',\r\n    date: '2024-03-14',\r\n    excerpt: '近日，我校材料科学研究团队在新型环保材料领域取得重大突破，相关研究成果已发表在国际顶级期刊...',\r\n    category: 'media',\r\n    views: 567,\r\n    source: '央视新闻'\r\n  },\r\n  {\r\n    id: 20,\r\n    title: '人民日报：我校智慧教育改革经验获广泛关注',\r\n    date: '2024-03-08',\r\n    excerpt: '在教育部组织的\"智慧教育示范校\"评选中，我校凭借创新的教学模式和完善的智慧校园建设...',\r\n    category: 'media',\r\n    views: 489,\r\n    source: '人民日报'\r\n  },\r\n  {\r\n    id: 21,\r\n    title: '新华网：校企合作助力产教融合发展',\r\n    date: '2024-03-05',\r\n    excerpt: '我校与多家知名企业签署战略合作协议，共建产学研基地，推动高校科研成果转化...',\r\n    category: 'media',\r\n    views: 412,\r\n    source: '新华网'\r\n  },\r\n  {\r\n    id: 22,\r\n    title: '光明日报：我校在基础研究领域取得突破性进展',\r\n    date: '2024-03-02',\r\n    excerpt: '我校物理研究所在量子计算领域取得重要突破，相关成果登上Nature子刊...',\r\n    category: 'media',\r\n    views: 378,\r\n    source: '光明日报'\r\n  },\r\n  {\r\n    id: 23,\r\n    title: '中国教育报：我校创新人才培养模式获好评',\r\n    date: '2024-02-28',\r\n    excerpt: '我校实施的\"产学研\"一体化人才培养模式，获得教育部门肯定...',\r\n    category: 'media',\r\n    views: 325,\r\n    source: '中国教育报'\r\n  },\r\n  {\r\n    id: 24,\r\n    title: '科技日报：我校在生物医药领域获重大突破',\r\n    date: '2024-02-25',\r\n    excerpt: '我校生物医学工程团队研发新型药物递送系统取得重要进展...',\r\n    category: 'media',\r\n    views: 402,\r\n    source: '科技日报'\r\n  },\r\n  {\r\n    id: 25,\r\n    title: '中国青年报：我校毕业生就业质量位居前列',\r\n    date: '2024-02-22',\r\n    excerpt: '第三方机构发布的就业质量报告显示，我校毕业生就业率和薪资水平均位居前列...',\r\n    category: 'media',\r\n    views: 356,\r\n    source: '中国青年报'\r\n  },\r\n  {\r\n    id: 26,\r\n    title: '经济日报：我校科技成果转化成效显著',\r\n    date: '2024-02-19',\r\n    excerpt: '我校通过产学研合作，已成功孵化多个高科技项目，带动地方经济发展...',\r\n    category: 'media',\r\n    views: 298,\r\n    source: '经济日报'\r\n  },\r\n  {\r\n    id: 27,\r\n    title: '中国科学报：我校在国际学术竞赛中创佳绩',\r\n    date: '2024-02-16',\r\n    excerpt: '我校学子在国际大学生程序设计竞赛中获得金牌，展现出较强的竞争力...',\r\n    category: 'media',\r\n    views: 342,\r\n    source: '中国科学报'\r\n  }\r\n]\r\n\r\n// 根据分类筛选新闻\r\nconst filteredNews = computed(() => {\r\n  return newsList.filter(news => news.category === currentCategory.value)\r\n})\r\n\r\n// 获取当前选中的新闻\r\nconst currentNews = computed(() => {\r\n  return newsList.find(news => news.id === selectedNewsId.value)\r\n})\r\n\r\n// 获取分类名称\r\nconst getCategoryName = (category) => {\r\n  const categoryMap = {\r\n    'campus': '校园新闻',\r\n    'notice': '通知公告',\r\n    'media': '媒体报道'\r\n  }\r\n  return categoryMap[category] || ''\r\n}\r\n\r\n// 生成新闻内容\r\nconst generateContent = (category, title) => {\r\n  const contentMap = {\r\n    'campus': `\r\n      进一步推动我校教育事业发展，提升教育教学质量，近日，我校举办了一系列重要活动。\r\n      在活动中，师生们展现出了极大的热情和创造力。通过此次活动，不仅增进了师生间的交流，\r\n      也为学校的未来发展注入了新的活力。活动得到了校领导的高度重视，相关负责人表示，\r\n      今后将继续举办类似活动，为师生搭建更好的交流平台。\r\n      \r\n      本次活动的成功举办，离开部门们的通力协作。参与活动的师生们都表示，希望能够有更多\r\n      类似的活动，为校园文化建设贡献力量。活动结束后，组委会对活动进行了总结，并提出了\r\n      下一步的工作计划。\r\n    `,\r\n    'notice': `\r\n      根据学校整体工作安排，结合实际情况，现就相关事项通知如下：\r\n      \r\n      一、工作目标\r\n      深入贯彻上级精神，切实做好各项工作。\r\n      \r\n      二、具体安排\r\n      1. 各单位要重视，认真acee排序；\r\n      2. 加强协调配合，确保工作有序开展；\r\n      3. 注意工作实效，及时总结经验。\r\n      \r\n      三、工作要求\r\n      1. 提高认识，加强领导；\r\n      2. 明确职责，落实任务；\r\n      3. 强化监督，确保实效。\r\n    `,\r\n    'media': `\r\n      近日，我校在教育教学、科研创新等方面取得的成绩受到社会各界广泛关注。通过持续深化\r\n      教育改革，推进产学研合作，学校的综合实力得到显著提升。\r\n      \r\n      专家们认为，我校在人才培养模式创新、科研成果转化等方面的经验具有重要的示范意义。\r\n      下一步，学校将继续深化改革，加强内涵建设，为建设高水平大学而不懈努力。\r\n      \r\n      此外，学校还将进一步与企业、科研院所的合作，推动科技成果转化，为地方的社会经济\r\n      发展作出更大贡献。\r\n    `\r\n  }\r\n  \r\n  return contentMap[category] || '详细内容正在整理中...'\r\n}\r\n\r\n// 查看新闻详情\r\nconst viewNewsDetail = (id) => {\r\n  selectedNewsId.value = id\r\n  window.scrollTo(0, 0)\r\n}\r\n\r\n// 返回新闻列表\r\nconst backToNewsList = () => {\r\n  selectedNewsId.value = null\r\n}\r\n\r\n// 显示主页新闻\r\nconst showMainNews = () => {\r\n  selectedNewsId.value = null\r\n  currentCategory.value = 'campus'\r\n}\r\n\r\n// 根据分类筛选新闻\r\nconst filterNewsByCategory = (category) => {\r\n  selectedNewsId.value = null\r\n  currentCategory.value = category\r\n}\r\n\r\n// 筛选公告\r\nconst filterNotice = (notice) => {\r\n  // 查找标题匹配的新闻\r\n  const matchedNews = newsList.find(news => \r\n    news.title.includes(notice.title) || \r\n    notice.title.includes(news.title)\r\n  )\r\n  \r\n  if (matchedNews) {\r\n    viewNewsDetail(matchedNews.id)\r\n  } else {\r\n    // 如果没找到匹配的，就显示通知公告分类\r\n    filterNewsByCategory('notice')\r\n  }\r\n}\r\n\r\n// 计算阅读进度\r\nconst calculateReadingProgress = () => {\r\n  const scrollTop = window.scrollY\r\n  const docHeight = document.documentElement.scrollHeight - window.innerHeight\r\n  readingProgress.value = (scrollTop / docHeight) * 100\r\n}\r\n\r\n// 图片加载完成\r\nconst onImageLoad = (event) => {\r\n  event.target.classList.add('loaded')\r\n}\r\n\r\n// 生命周期钩子\r\nonMounted(() => {\r\n  window.addEventListener('scroll', calculateReadingProgress)\r\n})\r\n\r\nonUnmounted(() => {\r\n  window.removeEventListener('scroll', calculateReadingProgress)\r\n})\r\n</script>\r\n\r\n<style>\r\n/* App 样式 */\r\n.app {\r\n  font-family: Arial, sans-serif;\r\n  min-height: 100vh;\r\n  background-color: #f5f5f5;\r\n}\r\n\r\n.header {\r\n  background-color: #2c3e50;\r\n  color: white;\r\n  padding: 20px;\r\n  text-align: center;\r\n}\r\n\r\n.header h1 {\r\n  margin: 0;\r\n}\r\n\r\n.main-container {\r\n  display: flex;\r\n  max-width: 1600px;\r\n  margin: 0 aut