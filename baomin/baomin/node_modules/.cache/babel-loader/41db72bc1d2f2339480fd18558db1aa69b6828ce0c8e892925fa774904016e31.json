\r\n.meta {\r\n  display: flex;\r\n  gap: 20px;\r\n  color: #666;\r\n  font-size: 0.9em;\r\n  margin-bottom: 30px;\r\n}\r\n\r\n.excerpt {\r\n  font-size: 1.1em;\r\n  line-height: 1.6;\r\n  color: #444;\r\n  font-weight: 500;\r\n  margin-bottom: 30px;\r\n  padding: 15px;\r\n  background: #f9f9f9;\r\n  border-left: 4px solid #2c3e50;\r\n}\r\n\r\n.content-text {\r\n  line-height: 1.8;\r\n  color: #333;\r\n  margin-bottom: 30px;\r\n}\r\n\r\n.content-text::first-letter {\r\n  font-size: 3em;\r\n  font-weight: bold;\r\n  color: #2c3e50;\r\n  float: left;\r\n  line-height: 1;\r\n  padding-right: 10px;\r\n}\r\n\r\n.news-images {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\r\n  gap: 20px;\r\n  margin: 30px 0;\r\n}\r\n\r\n.image-wrapper {\r\n  position: relative;\r\n  overflow: hidden;\r\n  border-radius: 8px;\r\n  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);\r\n}\r\n\r\n.news-image {\r\n  width: 100%;\r\n  height: 200px;\r\n  object-fit: cover;\r\n  transition: transform 0.5s ease;\r\n  opacity: 0;\r\n  transform: scale(0.95);\r\n}\r\n\r\n.news-image.loaded {\r\n  opacity: 1;\r\n  transform: scale(1);\r\n}\r\n\r\n.image-overlay {\r\n  position: absolute;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  background: rgba(0, 0, 0, 0.4);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  opacity: 0;\r\n  transition: opacity 0.3s ease;\r\n}\r\n\r\n.image-wrapper:hover .image-overlay {\r\n  opacity: 1;\r\n}\r\n\r\n.image-wrapper:hover .news-image {\r\n  transform: scale(1.05);\r\n}\r\n\r\n.zoom-icon {\r\n  color: white;\r\n  font-size: 2em;\r\n}\r\n\r\n.news-footer {\r\n  margin-top: 40px;\r\n  padding-top: 20px;\r\n  border-top: 1px solid #eee;\r\n  color: #888;\r\n  font-size: 0.9em;\r\n}\r\n\r\n.back-button {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  margin-top: 30px;\r\n  color: #2c3e50;\r\n  cursor: pointer;\r\n  font-weight: 500;\r\n  transition: all 0.3s ease;\r\n}\r\n\r\n.back-button:hover {\r\n  color: #1e88e5;\r\n}\r\n\r\n.back-button .arrow-icon {\r\n  margin-right: 8px;\r\n}\r\n\r\n.reading-progress {\r\n  position: fixed;\r\n  top: 0;\r\n  left: 0;\r\n  height: 4px;\r\n  background: #2c3e50;\r\n  z-index: 1000;\r\n  transition: width 0.1s ease;\r\n}\r\n\r\n/* 响应式设计 */\r\n@media (max-width: 1200px) {\r\n  .main-container {\r\n    flex-direction: column;\r\n  }\r\n  \r\n  .sidebar {\r\n    width: 100%;\r\n    margin-bottom: 20px;\r\n  }\r\n  \r\n  .left-sidebar {\r\n    order: 1;\r\n  }\r\n  \r\n  .content-area {\r\n    order: 2;\r\n  }\r\n  \r\n  .right-sidebar {\r\n    order: 3;\r\n  }\r\n}\r\n\r\n@media (max-width: 768px) {\r\n  .news-detail-content {\r\n    padding: 20px;\r\n  }\r\n  \r\n  .news-detail-content h1 {\r\n    font-size: 1.5em;\r\n  }\r\n  \r\n  .meta {\r\n    flex-direction: column;\r\n    gap: 5px;\r\n  }\r\n  \r\n  .news-images {\r\n    grid-template-columns: 1fr;\r\n  }\r\n  \r\n  .news-grid {\r\n    grid-template-columns: 1fr;\r\n  }\r\n}\r\n\r\n@media (min-width: 768px) {\r\n  .news-grid {\r\n    grid-template-columns: repeat(2, 1fr);\r\n  }\r\n}\r\n\r\n@media (min-width: 1200px) {\r\n  .news-grid {\r\n    grid-template-columns: repeat(3, 1fr);\r\n  }\r\n}\r\n</style>"],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AA8IA,SAAAA,GAAA,EAAAC,QAAA,EAAAC,SAAA,EAAAC,WAAA;AACA,SAAAC,MAAA,EAAAC,WAAA;AACA,SAAAC,UAAA,EAAAC,UAAA,EAAAC,QAAA;AACA;AACA;AACA;AACA;;AAEA;AACA,OAAAC,MAAA;AACA,OAAAC,MAAA;AACA,OAAAC,MAAA;;AAEA;AACA,MAAAC,MAAA,IACA;EACAC,KAAA,EAAAJ,MAAA;EACAK,KAAA;AACA,GACA;EACAD,KAAA,EAAAH,MAAA;EACAI,KAAA;AACA,GACA;EACAD,KAAA,EAAAF,MAAA;EACAG,KAAA;AACA,EACA;;AAEA;AACA,MAAAC,OAAA,IACA;EAAAD,KAAA;EAAAE,IAAA;AAAA,GACA;EAAAF,KAAA;EAAAE,IAAA;AAAA,GACA;EAAAF,KAAA;EAAAE,IAAA;AAAA,GACA;EAAAF,KAAA;EAAAE,IAAA;AAAA,GACA;EAAAF,KAAA;EAAAE,IAAA;AAAA,EACA;;AAEA;AACA,MAAAC,UAAA,IACA;EAAAC,EAAA;EAAAC,IAAA;AAAA,GACA;EAAA