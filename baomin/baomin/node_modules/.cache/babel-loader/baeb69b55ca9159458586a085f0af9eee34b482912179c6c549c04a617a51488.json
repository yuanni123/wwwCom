{"ast":null,"code":"//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n\nimport FooterComponent from './FooterComponent.vue';\nexport default {\n  name: 'RecruitmentInfo',\n  components: {\n    FooterComponent\n  }\n};","map":{"version":3,"names":["FooterComponent","name","components"],"sources":["src/components/RecruitmentInfo.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <div class=\"recruitment-info-container\">\r\n      <h2 class=\"section-title\">招聘信息</h2>\r\n    \r\n      <div class=\"section\">\r\n        <h3>一、招聘单位介绍</h3>\r\n        <div class=\"info-item\">\r\n          <div class=\"label\">学校名称：</div>\r\n          <div class=\"value\">深圳市宝民技工学校</div>\r\n        </div>\r\n        <div class=\"info-item\">\r\n          <div class=\"label\">学校性质：</div>\r\n          <div class=\"value\">民办职业技术学校</div>\r\n        </div>\r\n        <div class=\"info-item\">\r\n          <div class=\"label\">学校简介：</div>\r\n          <div class=\"value\">深圳市宝民技工学校创办于2005年，是一所以培养职业技能人才为主的综合性学校。学校秉承\"厚德、博学、求实、创新\"的校训，致力于培养具有扎实专业知识和实践能力的技术人才。</div>\r\n        </div>\r\n        <div class=\"info-item\">\r\n          <div class=\"label\">地理位置：</div>\r\n          <div class=\"value\">深圳市宝安区松白路7022号宝民技工学校</div>\r\n        </div>\r\n        <div class=\"info-item\">\r\n          <div class=\"label\">办学规模：</div>\r\n          <div class=\"value\">学生人数约xxxx人，教师人数xx余人，校园占地面积xx亩</div>\r\n        </div>\r\n      </div>\r\n      \r\n      <div class=\"section\">\r\n        <h3>二、招聘岗位及要求</h3>\r\n        <h4>1. 招聘岗位</h4>\r\n        <ul class=\"job-list\">\r\n          <li>专业课教师（计算机应用、电子商务、会计、机电一体化、汽车维修等）</li>\r\n          <li>文化课教师（语文、数学、英语等）</li>\r\n          <li>辅导员/班主任</li>\r\n          <li>教务管理人员</li>\r\n          <li>学生管理人员</li>\r\n          <li>招生办工作人员</li>\r\n        </ul>\r\n      \r\n        <h4>2. 招聘条件</h4>\r\n        <div class=\"sub-section\">\r\n          <h5>（1）基本要求</h5>\r\n          <ul>\r\n            <li>热爱教育事业，responsibility strong，具有良好的职业道德和团队合作精神</li>\r\n            <li>具备符合岗位要求的学历、专业背景及工作经验</li>\r\n            <li>普通话标准，具备良好的沟通表达能力</li>\r\n          </ul>\r\n        </div>\r\n      \r\n        <div class=\"sub-section\">\r\n          <h5>（2）学历与资质</h5>\r\n          <ul>\r\n            <li>本科及以上学历，相关专业毕业（优秀者可放宽）</li>\r\n            <li>持有相应学科的教师资格证（或符合当地教育局规定的要求）</li>\r\n            <li>具备相关教学经验者优先</li>\r\n          </ul>\r\n        </div>\r\n      \r\n        <div class=\"sub-section\">\r\n          <h5>（3）专业技能</h5>\r\n          <ul>\r\n            <li>熟练掌握相关学科知识，具备扎实的教学基本功</li>\r\n            <li>具备信息化教学能力，能熟练使用多媒体教学设备</li>\r\n            <li>了解学生心理发展特点，具备良好的班级管理能力</li>\r\n          </ul>\r\n        </div>\r\n      \r\n        <div class=\"sub-section\">\r\n          <h5>（4）优先条件</h5>\r\n          <ul>\r\n            <li>具有丰富的教学经验或竞赛指导经验者优先</li>\r\n            <li>具有研究生学历、海外留学或国际课程教学经验者优先</li>\r\n            <li>参加过教育教学研究、课题研究并取得成果者优先</li>\r\n          </ul>\r\n        </div>\r\n      </div>\r\n      \r\n      <div class=\"section\">\r\n        <h3>三、薪资福利</h3>\r\n        <div class=\"sub-section\">\r\n          <h5>薪资待遇：</h5>\r\n          <p>基本工资+课时费+绩效奖励（具体面议）</p>\r\n        </div>\r\n        \r\n        <div class=\"sub-section\">\r\n          <h5>福利保障：</h5>\r\n          <ul>\r\n            <li>五险一金</li>\r\n            <li>带薪寒暑假</li>\r\n            <li>提供住宿/住房补贴</li>\r\n            <li>交通补贴/餐补</li>\r\n            <li>教师培训及进修机会</li>\r\n            <li>子女就读优惠政策</li>\r\n          </ul>\r\n        </div>\r\n      </div>\r\n      \r\n      <div class=\"section\">\r\n        <h3>四、应聘流程</h3>\r\n        <div class=\"process-item\">\r\n          <div class=\"process-title\">1. 简历投递</div>\r\n          <div class=\"process-content\">\r\n            <p>邮箱投递：hr@baominschool.com</p>\r\n            <p>现场报名：深圳市宝安区松白路7022号宝民技工学校</p>\r\n            <p>截止时间：长期有效</p>\r\n          </div>\r\n        </div>\r\n        \r\n        <div class=\"process-item\">\r\n          <div class=\"process-title\">2. 资格审核</div>\r\n          <div class=\"process-content\">\r\n            <p>学校对应聘材料进行初审，并通知符合条件的人员参加面试</p>\r\n          </div>\r\n        </div>\r\n        \r\n        <div class=\"process-item\">\r\n          <div class=\"process-title\">3. 笔试/试讲</div>\r\n          <div class=\"process-content\">\r\n            <p>学科教师需进行专业测试或试讲</p>\r\n            <p>行政及后勤岗位需进行相关业务考核</p>\r\n          </div>\r\n        </div>\r\n        \r\n        <div class=\"process-item\">\r\n          <div class=\"process-title\">4. 面试</div>\r\n          <div class=\"process-content\">\r\n            <p>面试形式：结构化面试/半结构化面试</p>\r\n            <p>面试内容：自我介绍、职业规划、教育理念、教学案例分析等</p>\r\n          </div>\r\n        </div>\r\n        \r\n        <div class=\"process-item\">\r\n          <div class=\"process-title\">5. 体检与背景调查</div>\r\n          <div class=\"process-content\">\r\n            <p>通过面试后，需进行体检及相关背景调查</p>\r\n          </div>\r\n        </div>\r\n        \r\n        <div class=\"process-item\">\r\n          <div class=\"process-title\">6. 录用与入职</div>\r\n          <div class=\"process-content\">\r\n            <p>发送录用通知，办理入职手续，签订劳动合同</p>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      \r\n      <div class=\"section\">\r\n        <h3>五、联系方式</h3>\r\n        <div class=\"info-item\">\r\n          <div class=\"label\">联系人：</div>\r\n          <div class=\"value\">人事部</div>\r\n        </div>\r\n        <div class=\"info-item\">\r\n          <div class=\"label\">联系电话：</div>\r\n          <div class=\"value\">18018770098</div>\r\n        </div>\r\n        <div class=\"info-item\">\r\n          <div class=\"label\">学校地址：</div>\r\n          <div class=\"value\">深圳市宝安区松白路7022号宝民技工学校</div>\r\n        </div>\r\n        <div class=\"info-item\">\r\n          <div class=\"label\">招聘邮箱：</div>\r\n          <div class=\"value\">hr@baominschool.com</div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n    \r\n    <!-- 使用页脚组件 -->\r\n    <footer-component></footer-component>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport FooterComponent from './FooterComponent.vue'\r\n\r\nexport default {\r\n  name: 'RecruitmentInfo',\r\n  components: {\r\n    FooterComponent\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.recruitment-info-container {\r\n  padding: 20px;\r\n  background-color: #fff;\r\n  border-radius: 4px;\r\n  box-shadow: 0 2px 12px 0 rgba(0, 0, 0, 0.1);\r\n  margin-bottom: 30px; /* 添加底部间距，为页脚留出空间 */\r\n}\r\n\r\n.section-title {\r\n  color: #0d47a1;\r\n  text-align: center;\r\n  margin-bottom: 30px;\r\n  font-size: 24px;\r\n}\r\n\r\n.section {\r\n  margin-bottom: 30px;\r\n}\r\n\r\nh3 {\r\n  color: #0d47a1;\r\n  border-bottom: 2px solid #0d47a1;\r\n  padding-bottom: 10px;\r\n  margin-bottom: 15px;\r\n}\r\n\r\nh4 {\r\n  color: #1565c0;\r\n  margin: 15px 0;\r\n}\r\n\r\nh5 {\r\n  color: #1976d2;\r\n  margin: 10px 0;\r\n}\r\n\r\n.info-item {\r\n  display: flex;\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.label {\r\n  font-weight: bold;\r\n  min-width: 100px;\r\n}\r\n\r\n.value {\r\n  flex: 1;\r\n  line-height: 1.6;\r\n}\r\n\r\n.job-list li, .sub-section ul li {\r\n  margin-bottom: 8px;\r\n  line-height: 1.6;\r\n}\r\n\r\n.sub-section {\r\n  margin-bottom: 15px;\r\n}\r\n\r\n.process-item {\r\n  margin-bottom: 15px;\r\n  padding-left: 15px;\r\n  border-left: 3px solid #1976d2;\r\n}\r\n\r\n.process-title {\r\n  font-weight: bold;\r\n  color: #1976d2;\r\n  margin-bottom: 5px;\r\n}\r\n\r\n.process-content {\r\n  padding-left: 15px;\r\n}\r\n\r\n.process-content p {\r\n  margin: 5px 0;\r\n  line-height: 1.6;\r\n}\r\n\r\n.job-list {\r\n  padding-left: 20px;\r\n}\r\n\r\n.sub-section ul {\r\n  padding-left: 20px;\r\n}\r\n\r\n@media (max-width: 768px) {\r\n  .info-item {\r\n    flex-direction: column;\r\n  }\r\n  \r\n  .label {\r\n    min-width: auto;\r\n    margin-bottom: 5px;\r\n  }\r\n}\r\n\r\n/* 移除以下页脚相关样式 */\r\n</style>"],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AA+KA,OAAAA,eAAA;AAEA;EACAC,IAAA;EACAC,UAAA;IACAF;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}