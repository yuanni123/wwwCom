2015年',\n        icon: '/images/award-icon3.svg'\n      }, {\n        title: '国际教育示范基地',\n        description: '学校被判为\"国际教育示范基地\"，国际交流与合作成果丰硕。',\n        year: '2018年',\n        icon: '/images/award-icon4.svg'\n      }]\n    };\n  }\n};","map":{"version":3,"names":["name","data","historyEvents","year","title","description","image","achievements","icon"],"sources":["src/lsh/SchoolHistory.vue"],"sourcesContent":["<template>\r\n  <div class=\"school-history\">\r\n    <h1 class=\"section-title\">校史馆</h1>\r\n    <p class=\"section-desc\">了解我校的发展历程和辉煌成就</p>\r\n\r\n    <div class=\"history-timeline\">\r\n      <div class=\"timeline-header\">\r\n        <h2>学校发展历程</h2>\r\n      </div>\r\n      <div class=\"timeline\">\r\n        <div v-for=\"(event, index) in historyEvents\" :key=\"index\" class=\"timeline-item\">\r\n          <div class=\"timeline-dot\"></div>\r\n          <div class=\"timeline-content\">\r\n            <div class=\"timeline-year\">{{ event.year }}</div>\r\n            <div class=\"timeline-card\">\r\n              <h3>{{ event.title }}</h3>\r\n              <p>{{ event.description }}</p>\r\n              <div class=\"timeline-image\" v-if=\"event.image\" :style=\"{ backgroundImage: `url(${event.image})` }\"></div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"achievements-section\">\r\n      <h2>历史成就</h2>\r\n      <div class=\"achievements-grid\">\r\n        <div v-for=\"(achievement, index) in achievements\" :key=\"index\" class=\"achievement-card\">\r\n          <div class=\"achievement-icon\" v-if=\"achievement.icon\" :style=\"{ backgroundImage: `url(${achievement.icon})` }\"></div>\r\n          <div class=\"achievement-content\">\r\n            <h3>{{ achievement.title }}</h3>\r\n            <p>{{ achievement.description }}</p>\r\n            <div class=\"achievement-year\">{{ achievement.year }}</div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'SchoolHistory',\r\n  data() {\r\n    return {\r\n      historyEvents: [\r\n        {\r\n          year: '1985年',\r\n          title: '学校成立',\r\n          description: '我校正式成立，开始招收第一批学生，设立基础学科专业。',\r\n          image: '/images/founding.jpg'\r\n        },\r\n        {\r\n          year: '1990年',\r\n          title: '首次校园扩建',\r\n          description: '随着学校规模扩大，进行了首次校园扩建，新增教学楼和实验室。',\r\n          image: '/images/expansion.jpg'\r\n        },\r\n        {\r\n          year: '1995年',\r\n          title: '获评省级重点学校',\r\n          description: '经过十年发展，学校教学质量获得认可，被判为省级重点学校。',\r\n          image: '/images/award.jpg'\r\n        },\r\n        {\r\n          year: '2000年',\r\n          title: '新校区启用',\r\n          description: '为满足教学需求，新校区正式启用，学校进入快速发展阶段。',\r\n          image: '/images/new-campus.jpg'\r\n        },\r\n        {\r\n          year: '2005年',\r\n          title: '二十周年校庆',\r\n          description: '学校迎来二十周年校庆，举办系列庆祝活动，回顾发展历程。',\r\n          image: '/images/anniversary.jpg'\r\n        },\r\n        {\r\n          year: '2010年',\r\n          title: '国家级示范学校',\r\n          description: '学校被判为国家级示范学校，教育教学质量达到新高度。',\r\n          image: '/images/national-award.jpg'\r\n        },\r\n        {\r\n          year: '2015年',\r\n          title: '三十周年校庆暨国际教育中心成立',\r\n          description: '学校迎来三十周年校庆，同时成立国际教育中心，开启国际化办学新篇章。',\r\n          image: '/images/international.jpg'\r\n        },\r\n        {\r\n          year: '2020年',\r\n          title: '智慧校园建设完成',\r\n          description: '学校完成智慧校园建设，实现教学、管理、服务全面信息化。',\r\n          image: '/images/smart-campus.jpg'\r\n        }\r\n      ],\r\n      achievements: [\r\n        {\r\n          title: '国家级示范学校',\r\n          description: '2010年，学校被教育部评为\"国家级示范学校\"，成为全国教育系统的标杆。',\r\n          year: '2010年',\r\n          icon: '/images/award-icon1.svg'\r\n        },\r\n        {\r\n          title: '国家级教学成果奖',\r\n          description: '学校教学改革成果《创新人才培养模式的探索与实践》获国家级教学成果特等奖。',\r\n          year: '2012年',\r\n          icon: '/images/award-icon2.svg'\r\n        },\r\n        {\r\n          title: '省级文明校园',\r\n          description: '学校连续五年被判为\"省级文明校园\"，校园文化建设成果显著。',\r\n          year: '2015年',\r\n          icon: '/images/award-icon3.svg'\r\n        },\r\n        {\r\n          title: '国际教育示范基地',\r\n          description: '学校被判为\"国际教育示范基地\"，国际交流与合作成果丰硕。',\r\n          year: '2018年',\r\n          icon: '/images/award-icon4.svg'\r\n        }\r\n      ]\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.school-history {\r\n  padding: 1rem;\r\n}\r\n\r\n.section-title {\r\n  color: #1e3c72;\r\n  font-size: 2.5rem;\r\n  margin-bottom: 0.5rem;\r\n  text-align: center;\r\n}\r\n\r\n.section-desc {\r\n  color: #666;\r\n  text-align: center;\r\n  margin-bottom: 2rem;\r\n  font-size: 1.2rem;\r\n}\r\n\r\n.history-timeline {\r\n  margin-bottom: 3rem;\r\n}\r\n\r\n.timeline-header h2 {\r\n  color: #1e3c72;\r\n  margin-bottom: 1.5rem;\r\n  font-size: 1.8rem;\r\n  border-bottom: 2px solid #e0e0e0;\r\n  padding-bottom: 0.5rem;\r\n}\r\n\r\n.timeline {\r\n  position: relative;\r\n  padding: 2rem 0;\r\n}\r\n\r\n.timeline::before {\r\n  content: '';\r\n  position: absolute;\r\n  top: 0;\r\n  bottom: 0;\r\n  left: 50px;\r\n  width: 4px;\r\n  background: linear-gradient(to bottom, #1e3c72, #2a5298);\r\n}\r\n\r\n.timeline-item {\r\n  position: relative;\r\n  padding-left: 100px;\r\n  margin-bottom: 3rem;\r\n}\r\n\r\n.timeline-dot {\r\n  position: absolute;\r\n  left: 42px;\r\n  width: 20px;\r\n  height: 20px;\r\n  border-radius: 50%;\r\n  background-color: #1e3c72;\r\n  border: 4px solid white;\r\n  box-shadow: 0 0 0 3px rgba(30, 60, 114, 0.3);\r\n}\r\n\r\n.timeline-content {\r\n  background-color: white;\r\n  padding: 1.5rem;\r\n  border-radius: 8px;\r\n  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);\r\n}\r\n\r\n.timeline-year {\r\n  display: inline-block;\r\n  padding: 0.3rem 1rem;\r\n  background-color: #1e3c72;\r\n  color: white;\r\n  border-radius: 20px;\r\n  font-weight: bold;\r\n  margin-bottom: 0.8rem;\r\n}\r\n\r\n.timeline-title {\r\n  color: #1e3c72;\r\n  margin-bottom: 0.8rem;\r\n  font-size: 1.4rem;\r\n}\r\n\r\n.timeline-desc {\r\n  color: #666;\r\n  line-height: 1.6;\r\n  margin-bottom: 1rem;\r\n}\r\n\r\n.timeline-image img {\r\n  width: 100%;\r\n  border-radius: 4px;\r\n  margin-top: 1rem;\r\n}\r\n\r\n.important-figures {\r\n  margin-bottom: 3rem;\r\n}\r\n\r\n.important-figures h2 {\r\n  color: #1e3c72;\r\n  margin-bottom: 1.5rem;\r\n  font-size: 1.8rem;\r\n  border-bottom: 2px solid #e0e0e0;\r\n  padding-bottom: 0.5rem;\r\n}\r\n\r\n.figures-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));\r\n  gap: 2rem;\r\n}\r\n\r\n.figure-card {\r\n  background-color: white;\r\n  border-radius: 8px;\r\n  overflow: hidden;\r\n  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n.figure-image img {\r\n  width: 100%;\r\n  height: 250px;\r\n  object-fit: cover;\r\n}\r\n\r\n.figure-info {\r\n  padding: 1.5rem;\r\n}\r\n\r\n.figure-info h3 {\r\n  color: #1e3c72;\r\n  margin-bottom: 0.5rem;\r\n  font-size: 1.4rem;\r\n}\r\n\r\n.figure-period {\r\n  color: #888;\r\n  font-style: italic;\r\n  margin-bottom: 1rem;\r\n}\r\n\r\n.figure-desc {\r\n  color: #666;\r\n  line-height: 1.5;\r\n}\r\n\r\n.achievements {\r\n  margin-bottom: 3rem;\r\n}\r\n\r\n.achievements h2 {\r\n  color: #1e3c72;\r\n  margin-bottom: 1.5rem;\r\n  font-size: 1.8rem;\r\n  border-bottom: 2px solid #e0e0e0;\r\n  padding-bottom: 0.5rem;\r\n}\r\n\r\n.achievement-cards {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));\r\n  gap: 1.5rem;\r\n}\r\n\r\n.campus-gallery {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));\r\n  gap: 1.5rem;\r\n}\r\n</style>"],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAyCA;EACAA,IAAA;EACAC,KAAA;IACA;MACAC,aAAA,GACA;QACAC,IAAA;QACAC,KAAA;QACAC,WAAA;QACAC,KAAA;MACA,GACA;QA