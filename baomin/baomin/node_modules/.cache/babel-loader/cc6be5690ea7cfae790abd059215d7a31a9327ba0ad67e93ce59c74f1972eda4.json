{"ast":null,"code":"//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n\nexport default {\n  name: 'TeachingPage',\n  data() {\n    return {\n      currentDate: new Date(),\n      teachingPlans: [{\n        id: 1,\n        date: '2024-03-15',\n        title: '2024春季学期教学计划发布',\n        content: '包含各年级课程设置、教学目标等详细内容'\n      }, {\n        id: 2,\n        date: '2024-03-10',\n        title: '教学改革方案实施',\n        content: '推进新课改，优化教学方法'\n      }],\n      courseSchedule: [{\n        time: '周一 08:00-09:40',\n        course: '高等数学',\n        teacher: '张教授',\n        location: '教学楼A101'\n      }, {\n        time: '周二 10:00-11:40',\n        course: '大学物理',\n        teacher: '李教授',\n        location: '教学楼B203'\n      }],\n      achievements: [{\n        id: 1,\n        title: '教学创新奖',\n        type: '省级',\n        description: '创新教学方法获得省级表彰'\n      }, {\n        id: 2,\n        title: '优秀教学团队',\n        type: '校级',\n        description: '数学教研组获评优秀教学团队'\n      }],\n      recentActivities: [{\n        id: 1,\n        title: '教研组例会',\n        date: '2024-03-20',\n        type: 'primary',\n        color: '#409EFF'\n      }, {\n        id: 2,\n        title: '公开课展示',\n        date: '2024-03-25',\n        type: 'success',\n        color: '#67C23A'\n      }, {\n        id: 3,\n        title: '教学研讨会',\n        date: '2024-03-30',\n        type: 'warning',\n        color: '#E6A23C'\n      }],\n      activityDays: ['2024-03-20', '2024-03-25', '2024-03-30']\n    };\n  },\n  methods: {\n    isActivityDay(day) {\n      return this.activityDays.includes(day);\n    }\n  }\n};","map":{"version":3,"names":["name","data","currentDate","Date","teachingPlans","id","date","title","content","courseSchedule","time","course","teacher","location","achievements","type","description","recentActivities","color","activityDays","methods","isActivityDay","day","includes"],"sources":["src/TeachingAndResearch/TeachingPage.vue"],"sourcesContent":["<template>\r\n  <div class=\"teaching-container\">\r\n    <el-container>\r\n      <el-header>\r\n        <h1>教学管理中心</h1>\r\n      </el-header>\r\n      \r\n      <el-main>\r\n        <!-- 教学动态部分 -->\r\n        <div class=\"section\">\r\n          <h2 class=\"section-title\">教学动态</h2>\r\n          <el-tabs type=\"border-card\">\r\n            <el-tab-pane label=\"教学计划\">\r\n              <el-timeline>\r\n                <el-timeline-item\r\n                  v-for=\"item in teachingPlans\"\r\n                  :key=\"item.id\"\r\n                  :timestamp=\"item.date\"\r\n                  placement=\"top\"\r\n                >\r\n                  <el-card>\r\n                    <h4>{{ item.title }}</h4>\r\n                    <p>{{ item.content }}</p>\r\n                  </el-card>\r\n                </el-timeline-item>\r\n              </el-timeline>\r\n            </el-tab-pane>\r\n            \r\n            <el-tab-pane label=\"课程安排\">\r\n              <el-table :data=\"courseSchedule\" stripe style=\"width: 100%\">\r\n                <el-table-column prop=\"time\" label=\"时间\" width=\"180\" />\r\n                <el-table-column prop=\"course\" label=\"课程名称\" />\r\n                <el-table-column prop=\"teacher\" label=\"授课教师\" width=\"180\" />\r\n                <el-table-column prop=\"location\" label=\"地点\" width=\"180\" />\r\n              </el-table>\r\n            </el-tab-pane>\r\n\r\n            <el-tab-pane label=\"教学成果\">\r\n              <el-row :gutter=\"20\">\r\n                <el-col :span=\"8\" v-for=\"item in achievements\" :key=\"item.id\">\r\n                  <el-card class=\"achievement-card\">\r\n                    <template #header>\r\n                      <div class=\"card-header\">\r\n                        <span>{{ item.title }}</span>\r\n                        <el-tag size=\"small\">{{ item.type }}</el-tag>\r\n                      </div>\r\n                    </template>\r\n                    <div class=\"card-content\">{{ item.description }}</div>\r\n                  </el-card>\r\n                </el-col>\r\n              </el-row>\r\n            </el-tab-pane>\r\n          </el-tabs>\r\n        </div>\r\n\r\n        <!-- 教研活动部分 -->\r\n        <div class=\"section\">\r\n          <h2 class=\"section-title\">教研活动</h2>\r\n          <el-row :gutter=\"20\">\r\n            <el-col :span=\"16\">\r\n              <el-calendar v-model=\"currentDate\">\r\n                <template #dateCell=\"{ data }\">\r\n                  <div class=\"calendar-cell\">\r\n                    <p :class=\"{ 'is-selected': isActivityDay(data.day) }\">\r\n                      {{ data.day.split('-').slice(2).join('') }}\r\n                      <el-badge v-if=\"isActivityDay(data.day)\" is-dot />\r\n                    </p>\r\n                  </div>\r\n                </template>\r\n              </el-calendar>\r\n            </el-col>\r\n            <el-col :span=\"8\">\r\n              <el-card class=\"activity-list\">\r\n                <template #header>\r\n                  <div class=\"card-header\">\r\n                    <span>近期活动</span>\r\n                  </div>\r\n                </template>\r\n                <el-timeline>\r\n                  <el-timeline-item\r\n                    v-for=\"activity in recentActivities\"\r\n                    :key=\"activity.id\"\r\n                    :type=\"activity.type\"\r\n                    :timestamp=\"activity.date\"\r\n                    :color=\"activity.color\"\r\n                  >\r\n                    {{ activity.title }}\r\n                  </el-timeline-item>\r\n                </el-timeline>\r\n              </el-card>\r\n            </el-col>\r\n          </el-row>\r\n        </div>\r\n      </el-main>\r\n    </el-container>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'TeachingPage',\r\n  data() {\r\n    return {\r\n      currentDate: new Date(),\r\n      teachingPlans: [\r\n        {\r\n          id: 1,\r\n          date: '2024-03-15',\r\n          title: '2024春季学期教学计划发布',\r\n          content: '包含各年级课程设置、教学目标等详细内容'\r\n        },\r\n        {\r\n          id: 2,\r\n          date: '2024-03-10',\r\n          title: '教学改革方案实施',\r\n          content: '推进新课改，优化教学方法'\r\n        }\r\n      ],\r\n      courseSchedule: [\r\n        {\r\n          time: '周一 08:00-09:40',\r\n          course: '高等数学',\r\n          teacher: '张教授',\r\n          location: '教学楼A101'\r\n        },\r\n        {\r\n          time: '周二 10:00-11:40',\r\n          course: '大学物理',\r\n          teacher: '李教授',\r\n          location: '教学楼B203'\r\n        }\r\n      ],\r\n      achievements: [\r\n        {\r\n          id: 1,\r\n          title: '教学创新奖',\r\n          type: '省级',\r\n          description: '创新教学方法获得省级表彰'\r\n        },\r\n        {\r\n          id: 2,\r\n          title: '优秀教学团队',\r\n          type: '校级',\r\n          description: '数学教研组获评优秀教学团队'\r\n        }\r\n      ],\r\n      recentActivities: [\r\n        {\r\n          id: 1,\r\n          title: '教研组例会',\r\n          date: '2024-03-20',\r\n          type: 'primary',\r\n          color: '#409EFF'\r\n        },\r\n        {\r\n          id: 2,\r\n          title: '公开课展示',\r\n          date: '2024-03-25',\r\n          type: 'success',\r\n          color: '#67C23A'\r\n        },\r\n        {\r\n          id: 3,\r\n          title: '教学研讨会',\r\n          date: '2024-03-30',\r\n          type: 'warning',\r\n          color: '#E6A23C'\r\n        }\r\n      ],\r\n      activityDays: ['2024-03-20', '2024-03-25', '2024-03-30']\r\n    }\r\n  },\r\n  methods: {\r\n    isActivityDay(day) {\r\n      return this.activityDays.includes(day)\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.teaching-container {\r\n  padding: 20px;\r\n}\r\n\r\n.el-header {\r\n  text-align: center;\r\n  padding: 20px 0;\r\n}\r\n\r\n.section {\r\n  margin-bottom: 30px;\r\n}\r\n\r\n.section-title {\r\n  margin-bottom: 20px;\r\n  padding-left: 10px;\r\n  border-left: 4px solid #409EFF;\r\n}\r\n\r\n.achievement-card {\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.card-header {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n}\r\n\r\n.card-content {\r\n  color: #666;\r\n  font-size: 14px;\r\n}\r\n\r\n.calendar-cell {\r\n  text-align: center;\r\n  height: 100%;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n}\r\n\r\n.is-selected {\r\n  color: #409EFF;\r\n  font-weight: bold;\r\n}\r\n\r\n.activity-list {\r\n  height: 100%;\r\n}\r\n</style>"],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAmGA;EACAA,IAAA;EACAC,KAAA;IACA;MACAC,WAAA,MAAAC,IAAA;MACAC,aAAA,GACA;QACAC,EAAA;QACAC,IAAA;QACAC,KAAA;QACAC,OAAA;MACA,GACA;QACAH,EAAA;QACAC,IAAA;QACAC,KAAA;QACAC,OAAA;MACA,EACA;MACAC,cAAA,GACA;QACAC,IAAA;QACAC,MAAA;QACAC,OAAA;QACAC,QAAA;MACA,GACA;QACAH,IAAA;QACAC,MAAA;QACAC,OAAA;QACAC,QAAA;MACA,EACA;MACAC,YAAA,GACA;QACAT,EAAA;QACAE,KAAA;QACAQ,IAAA;QACAC,WAAA;MACA,GACA;QACAX,EAAA;QACAE,KAAA;QACAQ,IAAA;QACAC,WAAA;MACA,EACA;MACAC,gBAAA,GACA;QACAZ,EAAA;QACAE,KAAA;QACAD,IAAA;QACAS,IAAA;QACAG,KAAA;MACA,GACA;QACAb,EAAA;QACAE,KAAA;QACAD,IAAA;QACAS,IAAA;QACAG,KAAA;MACA,GACA;QACAb,EAAA;QACAE,KAAA;QACAD,IAAA;QACAS,IAAA;QACAG,KAAA;MACA,EACA;MACAC,YAAA;IACA;EACA;EACAC,OAAA;IACAC,cAAAC,GAAA;MACA,YAAAH,YAAA,CAAAI,QAAA,CAAAD,GAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}