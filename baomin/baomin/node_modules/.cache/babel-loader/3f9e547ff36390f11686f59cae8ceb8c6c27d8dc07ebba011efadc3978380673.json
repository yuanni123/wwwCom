{"ast":null,"code":"//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n\nexport default {\n  name: 'CulturePage',\n  data() {\n    return {\n      activeTab: 'campus-activities',\n      activeClub: '',\n      activities: [\n      // 示例数据，可根据实际需求修改\n      {\n        title: '校园歌手大赛',\n        date: '2023-05-20',\n        image: require('@/assets/img/culture/singer-contest.jpg'),\n        description: '年度校园歌手大赛火热进行中，展现你的音乐才华！'\n      }\n      // 添加更多活动数据...\n      ],\n      clubs: [{\n        name: '科技创新社',\n        teacher: '张老师',\n        establishDate: '2018-09-01',\n        description: '致力于科技创新与实践的社团，多次获得省级奖项',\n        images: [require('@/assets/img/culture/tech-club1.jpg')\n        // 添加更多图片...\n        ]\n      }\n      // 添加更多社团数据...\n      ],\n      historyEvents: [{\n        date: '2005-09-01',\n        title: '学校正式成立',\n        description: '深圳市宝民职业技术学校正式挂牌成立'\n      }\n      // 添加更多历史事件数据...\n      ]\n    };\n  },\n  created() {\n    // 从路由参数获取当前激活的tab\n    this.activeTab = this.$route.query.tab || 'campus-activities';\n  },\n  methods: {\n    handleTabChange(tab) {\n      this.$router.push({\n        path: '/culture',\n        query: {\n          tab: tab.name\n        }\n      });\n    },\n    formatDate(dateString) {\n      const date = new Date(dateString);\n      return `${date.getFullYear()}年${date.getMonth() + 1}月${date.getDate()}日`;\n    }\n  }\n};","map":{"version":3,"names":["name","data","activeTab","activeClub","activities","title","date","image","require","description","clubs","teacher","establishDate","images","historyEvents","created","$route","query","tab","methods","handleTabChange","$router","push","path","formatDate","dateString","Date","getFullYear","getMonth","getDate"],"sources":["src/views/CulturePage.vue"],"sourcesContent":["<template>\r\n  <div class=\"culture-page\">\r\n    <el-tabs v-model=\"activeTab\" @tab-click=\"handleTabChange\">\r\n      <!-- 校园活动 -->\r\n      <el-tab-pane label=\"校园活动\" name=\"campus-activities\">\r\n        <el-row :gutter=\"20\">\r\n          <el-col :span=\"8\" v-for=\"(activity, index) in activities\" :key=\"index\">\r\n            <el-card class=\"activity-card\">\r\n              <img :src=\"activity.image\" class=\"activity-image\" alt=\"活动图片\">\r\n              <h3>{{ activity.title }}</h3>\r\n              <p class=\"activity-date\">{{ formatDate(activity.date) }}</p>\r\n              <p class=\"activity-description\">{{ activity.description }}</p>\r\n            </el-card>\r\n          </el-col>\r\n        </el-row>\r\n      </el-tab-pane>\r\n\r\n      <!-- 社团组织 -->\r\n      <el-tab-pane label=\"社团组织\" name=\"clubs\">\r\n        <el-collapse v-model=\"activeClub\">\r\n          <el-collapse-item \r\n            v-for=\"(club, index) in clubs\" \r\n            :key=\"index\" \r\n            :title=\"club.name\" \r\n            :name=\"club.name\"\r\n          >\r\n            <div class=\"club-info\">\r\n              <p>指导老师：{{ club.teacher }}</p>\r\n              <p>成立时间：{{ formatDate(club.establishDate) }}</p>\r\n              <p class=\"club-description\">{{ club.description }}</p>\r\n              <el-carousel :interval=\"5000\" height=\"200px\">\r\n                <el-carousel-item v-for=\"(img, i) in club.images\" :key=\"i\">\r\n                  <img :src=\"img\" class=\"club-image\">\r\n                </el-carousel-item>\r\n              </el-carousel>\r\n            </div>\r\n          </el-collapse-item>\r\n        </el-collapse>\r\n      </el-tab-pane>\r\n\r\n      <!-- 校史馆 -->\r\n      <el-tab-pane label=\"校史馆\" name=\"history\">\r\n        <div class=\"history-content\">\r\n          <el-timeline>\r\n            <el-timeline-item\r\n              v-for=\"(event, index) in historyEvents\"\r\n              :key=\"index\"\r\n              :timestamp=\"formatDate(event.date)\"\r\n            >\r\n              <h4>{{ event.title }}</h4>\r\n              <p>{{ event.description }}</p>\r\n              <div v-if=\"event.images\" class=\"history-images\">\r\n                <img \r\n                  v-for=\"(img, i) in event.images\" \r\n                  :key=\"i\" \r\n                  :src=\"img\" \r\n                  class=\"history-image\"\r\n                >\r\n              </div>\r\n            </el-timeline-item>\r\n          </el-timeline>\r\n        </div>\r\n      </el-tab-pane>\r\n    </el-tabs>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'CulturePage',\r\n  data() {\r\n    return {\r\n      activeTab: 'campus-activities',\r\n      activeClub: '',\r\n      activities: [\r\n        // 示例数据，可根据实际需求修改\r\n        {\r\n          title: '校园歌手大赛',\r\n          date: '2023-05-20',\r\n          image: require('@/assets/img/culture/singer-contest.jpg'),\r\n          description: '年度校园歌手大赛火热进行中，展现你的音乐才华！'\r\n        },\r\n        // 添加更多活动数据...\r\n      ],\r\n      clubs: [\r\n        {\r\n          name: '科技创新社',\r\n          teacher: '张老师',\r\n          establishDate: '2018-09-01',\r\n          description: '致力于科技创新与实践的社团，多次获得省级奖项',\r\n          images: [\r\n            require('@/assets/img/culture/tech-club1.jpg'),\r\n            // 添加更多图片...\r\n          ]\r\n        },\r\n        // 添加更多社团数据...\r\n      ],\r\n      historyEvents: [\r\n        {\r\n          date: '2005-09-01',\r\n          title: '学校正式成立',\r\n          description: '深圳市宝民职业技术学校正式挂牌成立'\r\n        },\r\n        // 添加更多历史事件数据...\r\n      ]\r\n    }\r\n  },\r\n  created() {\r\n    // 从路由参数获取当前激活的tab\r\n    this.activeTab = this.$route.query.tab || 'campus-activities'\r\n  },\r\n  methods: {\r\n    handleTabChange(tab) {\r\n      this.$router.push({\r\n        path: '/culture',\r\n        query: { tab: tab.name }\r\n      })\r\n    },\r\n    formatDate(dateString) {\r\n      const date = new Date(dateString)\r\n      return `${date.getFullYear()}年${date.getMonth() + 1}月${date.getDate()}日`\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.culture-page {\r\n  padding: 20px;\r\n  max-width: 1200px;\r\n  margin: 0 auto;\r\n}\r\n\r\n.activity-card {\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.activity-image {\r\n  width: 100%;\r\n  height: 200px;\r\n  object-fit: cover;\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.club-image {\r\n  width: 100%;\r\n  height: 200px;\r\n  object-fit: cover;\r\n}\r\n\r\n.history-images {\r\n  display: flex;\r\n  gap: 10px;\r\n  margin-top: 10px;\r\n}\r\n\r\n.history-image {\r\n  width: 200px;\r\n  height: 150px;\r\n  object-fit: cover;\r\n  border-radius: 4px;\r\n}\r\n\r\n@media (max-width: 768px) {\r\n  .activity-card,\r\n  .club-image,\r\n  .history-image {\r\n    width: 100%;\r\n    height: auto;\r\n  }\r\n  \r\n  .el-col {\r\n    width: 100%;\r\n  }\r\n}\r\n</style>"],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAoEA;EACAA,IAAA;EACAC,KAAA;IACA;MACAC,SAAA;MACAC,UAAA;MACAC,UAAA;MACA;MACA;QACAC,KAAA;QACAC,IAAA;QACAC,KAAA,EAAAC,OAAA;QACAC,WAAA;MACA;MACA;MAAA,CACA;MACAC,KAAA,GACA;QACAV,IAAA;QACAW,OAAA;QACAC,aAAA;QACAH,WAAA;QACAI,MAAA,GACAL,OAAA;QACA;QAAA;MAEA;MACA;MAAA,CACA;MACAM,aAAA,GACA;QACAR,IAAA;QACAD,KAAA;QACAI,WAAA;MACA;MACA;MAAA;IAEA;EACA;EACAM,QAAA;IACA;IACA,KAAAb,SAAA,QAAAc,MAAA,CAAAC,KAAA,CAAAC,GAAA;EACA;EACAC,OAAA;IACAC,gBAAAF,GAAA;MACA,KAAAG,OAAA,CAAAC,IAAA;QACAC,IAAA;QACAN,KAAA;UAAAC,GAAA,EAAAA,GAAA,CAAAlB;QAAA;MACA;IACA;IACAwB,WAAAC,UAAA;MACA,MAAAnB,IAAA,OAAAoB,IAAA,CAAAD,UAAA;MACA,UAAAnB,IAAA,CAAAqB,WAAA,MAAArB,IAAA,CAAAsB,QAAA,UAAAtB,IAAA,CAAAuB,OAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}