{"ast":null,"code":"//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n\nimport AdmissionInfo from '../components/AdmissionInfo.vue';\nimport RecruitmentInfo from '../components/RecruitmentInfo.vue';\nimport OnlineRegistration from '../components/OnlineRegistration.vue';\nimport ContactUs from '../components/ContactUs.vue';\nexport default {\n  name: 'RecruitmentPage',\n  components: {\n    AdmissionInfo,\n    RecruitmentInfo,\n    OnlineRegistration,\n    ContactUs\n  },\n  props: {\n    activeTab: {\n      type: String,\n      default: 'recruitment'\n    }\n  },\n  data() {\n    return {\n      activeTabData: this.activeTab\n    };\n  },\n  computed: {\n    activeMenuItem() {\n      const mapping = {\n        'admission': '/admission',\n        'recruitment': '/recruitment',\n        'registration': '/registration',\n        'contact': '/contact'\n      };\n      return mapping[this.activeTabData];\n    }\n  },\n  methods: {\n    handleTabClick(tab) {\n      this.activeTabData = tab.name;\n      // 使用路由导航到对应页面\n      this.$router.push(this.activeMenuItem);\n    },\n    // 添加返回首页方法\n    backToHome() {\n      this.$router.push('/home');\n    }\n  },\n  // 监听路由变化，更新activeTabData\n  watch: {\n    $route(to) {\n      const path = to.path;\n      const reverseMapping = {\n        '/admission': 'admission',\n        '/recruitment': 'recruitment',\n        '/registration': 'registration',\n        '/contact': 'contact'\n      };\n      if (reverseMapping[path]) {\n        this.activeTabData = reverseMapping[path];\n      }\n    }\n  },\n  // 组件创建时根据当前路由设置activeTabData\n  created() {\n    const path = this.$route.path;\n    const reverseMapping = {\n      '/admission': 'admission',\n      '/recruitment': 'recruitment',\n      '/registration': 'registration',\n      '/contact': 'contact'\n    };\n    if (reverseMapping[path]) {\n      this.activeTabData = reverseMapping[path];\n    }\n  }\n};","map":{"version":3,"names":["AdmissionInfo","RecruitmentInfo","OnlineRegistration","ContactUs","name","components","props","activeTab","type","String","default","data","activeTabData","computed","activeMenuItem","mapping","methods","handleTabClick","tab","$router","push","backToHome","watch","$route","to","path","reverseMapping","created"],"sources":["src/views/RecruitmentPage.vue"],"sourcesContent":["<template>\r\n  <div class=\"recruitment-container\">\r\n    <el-header class=\"header\">\r\n      <div class=\"logo-container\">\r\n        <div class=\"school-name\">\r\n          <h1>深圳市宝民职业技术学校</h1>\r\n          <p>SHENZHEN FENDA VOCATIONAL TECHNICAL SCHOOL</p>\r\n        </div>\r\n      </div>\r\n      <!-- 将返回首页按钮移到表头 -->\r\n      <div class=\"nav-links\">\r\n        <el-button type=\"primary\" icon=\"el-icon-back\" @click=\"backToHome\">返回首页</el-button>\r\n      </div>\r\n    </el-header>\r\n    \r\n\r\n    \r\n    <el-container class=\"main-container\">\r\n      <el-aside width=\"220px\" class=\"sidebar\">\r\n        <el-menu\r\n          :default-active=\"activeMenuItem\"\r\n          class=\"menu\"\r\n          background-color=\"#0d47a1\"\r\n          text-color=\"#fff\"\r\n          active-text-color=\"#ffd04b\"\r\n          router\r\n          ref=\"menu\">\r\n          <!-- 现有菜单项保持不变 -->\r\n          <el-menu-item v-if=\"activeTabData === 'admission'\" index=\"/admission\">\r\n            <span>招生信息</span>\r\n          </el-menu-item>\r\n          <el-menu-item v-if=\"activeTabData === 'recruitment'\" index=\"/recruitment\">\r\n            <span>招聘信息</span>\r\n          </el-menu-item>\r\n          <el-menu-item v-if=\"activeTabData === 'registration'\" index=\"/registration\">\r\n            <span>在线报名</span>\r\n          </el-menu-item>\r\n          <el-menu-item v-if=\"activeTabData === 'contact'\" index=\"/contact\">\r\n            <span>联系我们</span>\r\n          </el-menu-item>\r\n        </el-menu>\r\n      </el-aside>\r\n      \r\n      <el-main class=\"main-content\">\r\n        <el-tabs v-model=\"activeTabData\" type=\"card\" @tab-click=\"handleTabClick\">\r\n          <el-tab-pane label=\"招生信息\" name=\"admission\">\r\n            <admission-info></admission-info>\r\n          </el-tab-pane>\r\n          <el-tab-pane label=\"招聘信息\" name=\"recruitment\">\r\n            <recruitment-info></recruitment-info>\r\n          </el-tab-pane>\r\n          <el-tab-pane label=\"在线报名\" name=\"registration\">\r\n            <online-registration></online-registration>\r\n          </el-tab-pane>\r\n          <el-tab-pane label=\"联系我们\" name=\"contact\">\r\n            <contact-us></contact-us>\r\n          </el-tab-pane>\r\n        </el-tabs>\r\n      </el-main>\r\n    </el-container>\r\n    \r\n    <el-footer class=\"footer\">\r\n      © 2023 深圳市宝民职业技术学校 版权所有\r\n    </el-footer>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport AdmissionInfo from '../components/AdmissionInfo.vue'\r\nimport RecruitmentInfo from '../components/RecruitmentInfo.vue'\r\nimport OnlineRegistration from '../components/OnlineRegistration.vue'\r\nimport ContactUs from '../components/ContactUs.vue'\r\n\r\nexport default {\r\n  name: 'RecruitmentPage',\r\n  components: {\r\n    AdmissionInfo,\r\n    RecruitmentInfo,\r\n    OnlineRegistration,\r\n    ContactUs\r\n  },\r\n  props: {\r\n    activeTab: {\r\n      type: String,\r\n      default: 'recruitment'\r\n    }\r\n  },\r\n  data() {\r\n    return {\r\n      activeTabData: this.activeTab\r\n    }\r\n  },\r\n  computed: {\r\n    activeMenuItem() {\r\n      const mapping = {\r\n        'admission': '/admission',\r\n        'recruitment': '/recruitment',\r\n        'registration': '/registration',\r\n        'contact': '/contact'\r\n      };\r\n      return mapping[this.activeTabData];\r\n    }\r\n  },\r\n  methods: {\r\n    handleTabClick(tab) {\r\n      this.activeTabData = tab.name;\r\n      // 使用路由导航到对应页面\r\n      this.$router.push(this.activeMenuItem);\r\n    },\r\n    // 添加返回首页方法\r\n    backToHome() {\r\n      this.$router.push('/home');\r\n    }\r\n  },\r\n  // 监听路由变化，更新activeTabData\r\n  watch: {\r\n    $route(to) {\r\n      const path = to.path;\r\n      const reverseMapping = {\r\n        '/admission': 'admission',\r\n        '/recruitment': 'recruitment',\r\n        '/registration': 'registration',\r\n        '/contact': 'contact'\r\n      };\r\n      if (reverseMapping[path]) {\r\n        this.activeTabData = reverseMapping[path];\r\n      }\r\n    }\r\n  },\r\n  // 组件创建时根据当前路由设置activeTabData\r\n  created() {\r\n    const path = this.$route.path;\r\n    const reverseMapping = {\r\n      '/admission': 'admission',\r\n      '/recruitment': 'recruitment',\r\n      '/registration': 'registration',\r\n      '/contact': 'contact'\r\n    };\r\n    if (reverseMapping[path]) {\r\n      this.activeTabData = reverseMapping[path];\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.recruitment-container {\r\n  display: flex;\r\n  flex-direction: column;\r\n  min-height: 100vh;\r\n}\r\n\r\n.header {\r\n  background-color: #0d47a1;\r\n  color: white;\r\n  padding: 10px 20px;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between; /* 添加此行使logo和按钮分布在两端 */\r\n}\r\n\r\n.logo-container {\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n/* 添加导航链接样式 */\r\n.nav-links {\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n.school-name h1 {\r\n  margin: 0;\r\n  font-size: 24px;\r\n}\r\n\r\n/* 其他样式保持不变 */\r\n\r\n/* 删除原来的返回首页按钮样式 */\r\n/* .back-to-home {\r\n  margin: 15px;\r\n  text-align: right;\r\n  padding-right: 20px;\r\n} */\r\n</style>"],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAoEA,OAAAA,aAAA;AACA,OAAAC,eAAA;AACA,OAAAC,kBAAA;AACA,OAAAC,SAAA;AAEA;EACAC,IAAA;EACAC,UAAA;IACAL,aAAA;IACAC,eAAA;IACAC,kBAAA;IACAC;EACA;EACAG,KAAA;IACAC,SAAA;MACAC,IAAA,EA