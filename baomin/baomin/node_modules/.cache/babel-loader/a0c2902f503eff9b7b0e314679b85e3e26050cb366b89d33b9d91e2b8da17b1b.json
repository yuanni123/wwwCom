iner {\r\n  flex: 1;\r\n  padding: 20px;\r\n  background-color: #f5f5f5;\r\n  max-width: 1200px;\r\n  margin: 0 auto;\r\n}\r\n\r\n.section-title {\r\n  color: #0d47a1;\r\n  margin-bottom: 30px;\r\n  text-align: center;\r\n  font-size: 28px;\r\n  font-weight: bold;\r\n}\r\n\r\n.school-intro {\r\n  background-color: white;\r\n  padding: 20px;\r\n  border-radius: 4px;\r\n  box-shadow: 0 2px 12px 0 rgba(0, 0, 0, 0.1);\r\n  line-height: 1.8;\r\n}\r\n\r\n.footer {\r\n  background-color: #535353;\r\n  color: white;\r\n  padding: 40px 0;\r\n  height: auto !important;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n}\r\n\r\n.footer-content {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  justify-content: center;\r\n  font-size: 14px;\r\n}\r\n\r\n.footer-info {\r\n  margin-bottom: 15px;\r\n  text-align: center;\r\n}\r\n\r\n.copyright {\r\n  text-align: center;\r\n  font-size: 12px;\r\n}\r\n</style>"],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAkCA;EACAA,IAAA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}