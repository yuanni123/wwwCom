{"ast":null,"code":"//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n\nexport default {\n  name: 'CampusCulture',\n  data() {\n    return {\n      activeTab: 'activities',\n      dialogVisible: false,\n      selectedPhoto: null,\n      campusActivities: [{\n        id: 1,\n        title: '2023年校园文化艺术节',\n        date: '2023-05-20',\n        description: '为期一周的校园文化艺术节圆满结束，包括歌唱比赛、舞蹈表演、书法展览等多项活动，展示了学生的多才多艺。',\n        image: require('../assets/img/sy/carousel1.jpg'),\n        category: '文化艺术',\n        type: 'success',\n        color: '#67C23A'\n      }, {\n        id: 2,\n        title: '校运会',\n        date: '2023-04-15',\n        description: '一年一度的校运会在操场隆重举行，各班级学生积极参与，展现了良好的体育精神和团队协作能力。',\n        image: require('../assets/img/sy/carousel2.jpg'),\n        category: '体育赛事',\n        type: 'primary',\n        color: '#409EFF'\n      }, {\n        id: 3,\n        title: '职业技能大赛',\n        date: '2023-03-10',\n        description: '学校举办了职业技能大赛，学生们在各自专业领域展示了扎实的技能和创新能力，为未来就业打下坚实基础。',\n        image: require('../assets/img/sy/carousel3.jpg'),\n        category: '技能竞赛',\n        type: 'warning',\n        color: '#E6A23C'\n      }],\n      studentClubs: [{\n        id: 1,\n        name: '科技创新社',\n        description: '致力于培养学生的科技创新能力，定期开展科技制作、编程培训等活动。',\n        image: require('../assets/img/sy/carousel1.jpg'),\n        foundedTime: '2018年',\n        memberCount: 45,\n        category: '科技类',\n        teacher: '张老师'\n      }, {\n        id: 2,\n        name: '文学社',\n        description: '为热爱文学的学生提供交流平台，定期举办读书会、写作比赛等活动。',\n        image: require('../assets/img/sy/carousel2.jpg'),\n        foundedTime: '2017年',\n        memberCount: 38,\n        category: '文化类',\n        teacher: '李老师'\n      }, {\n        id: 3,\n        name: '篮球社',\n        description: '组织校内篮球训练和比赛，培养学生的团队协作精神和体育素养。',\n        image: require('../assets/img/sy/carousel3.jpg'),\n        foundedTime: '2016年',\n        memberCount: 30,\n        category: '体育类',\n        teacher: '王老师'\n      }],\n      schoolHistory: [{\n        year: '2015年',\n        event: '深圳市宝民职业技术学校正式成立，开设计算机应用、电子商务等专业。',\n        image: require('../assets/img/sy/carousel1.jpg')\n      }, {\n        year: '2017年',\n        event: '学校扩建教学楼，增设实训基地，新增幼儿教育、汽车维修等专业。',\n        image: require('../assets/img/sy/carousel2.jpg')\n      }, {\n        year: '2019年',\n        event: '学校被判为\"深圳市优质职业学校\"，教学质量和管理水平得到认可。',\n        image: require('../assets/img/sy/carousel3.jpg')\n      }, {\n        year: '2021年',\n        event: '学校与多家知名企业建立校企合作关系，为学生提供更多实习和就业机会。',\n        image: require('../assets/img/sy/carousel1.jpg')\n      }, {\n        year: '2023年',\n        event: '学校举办建校八周年庆典，回顾发展历程，展望美好未来。',\n        image: require('../assets/img/sy/carousel2.jpg')\n      }],\n      historyPhotos: [{\n        src: require('../assets/img/sy/carousel1.jpg'),\n        year: '2015',\n        title: '学校成立',\n        description: '深圳市宝民职业技术学校成立仪式现场。'\n      }, {\n        src: require('../assets/img/sy/carousel2.jpg'),\n        year: '2017',\n        title: '新教学楼落成',\n        description: '新教学楼落成剪彩仪式。'\n      }, {\n        src: require('../assets/img/sy/carousel3.jpg'),\n        year: '2019',\n        title: '获奖证书',\n        description: '\"深圳市优质职业学校\"荣誉证书。'\n      }, {\n        src: require('../assets/img/sy/carousel1.jpg'),\n        year: '2021',\n        title: '校企合作',\n        description: '与华为公司签署校企合作协议。'\n      }]\n    };\n  },\n  methods: {\n    showPhotoDetail(photo) {\n      this.selectedPhoto = photo;\n      this.dialogVisible = true;\n    }\n  },\n  created() {\n    // 如果有路由参数指定标签，则切换到对应标签\n    if (this.$route.params.tab) {\n      this.activeTab = this.$route.params.tab;\n    }\n  }\n};","map":{"version":3,"names":["name","data","activeTab","dialogVisible","selectedPhoto","campusActivities","id","title","date","description","image","require","category","type","color","studentClubs","foundedTime","memberCount","teacher","schoolHistory","year","event","historyPhotos","src","methods","showPhotoDetail","photo","created","$route","params","tab"],"sources":["src/views/CampusCulture.vue"],"sourcesContent":["<template>\r\n  <div class=\"campus-culture-page\">\r\n    <!-- 头部 -->\r\n    <el-header class=\"header\">\r\n      <div class=\"logo-container\">\r\n        <div class=\"school-logo\">\r\n          <img src=\"../assets/img/sy/fd343a2a5554bb33db411f6d23f6fb88.jpg\" alt=\"学校校标\" />\r\n        </div>\r\n        <div class=\"school-name\">\r\n          <h1>深圳市宝民职业技术学校</h1>\r\n          <p>SHENZHEN BAOMIN VOCATIONAL TECHNICAL SCHOOL</p>\r\n        </div>\r\n      </div>\r\n      <div class=\"nav-links\">\r\n        <router-link to=\"/home\" class=\"nav-link\">返回首页</router-link>\r\n      </div>\r\n    </el-header>\r\n\r\n    <!-- 主要内容 -->\r\n    <div class=\"content-container\">\r\n      <h1 class=\"page-title\">校园文化</h1>\r\n      \r\n      <!-- 导航标签 -->\r\n      <el-tabs v-model=\"activeTab\" type=\"card\" class=\"culture-tabs\">\r\n        <el-tab-pane label=\"校园活动\" name=\"activities\">\r\n          <div class=\"section-content\">\r\n            <h2 class=\"section-title\">丰富多彩的校园活动</h2>\r\n            \r\n            <el-timeline>\r\n              <el-timeline-item\r\n                v-for=\"activity in campusActivities\"\r\n                :key=\"activity.id\"\r\n                :timestamp=\"activity.date\"\r\n                :color=\"activity.color\"\r\n                placement=\"top\"\r\n              >\r\n                <el-card>\r\n                  <div class=\"activity-card\">\r\n                    <div class=\"activity-image\">\r\n                      <el-image :src=\"activity.image\" :alt=\"activity.title\" fit=\"cover\"></el-image>\r\n                    </div>\r\n                    <div class=\"activity-info\">\r\n                      <h3>{{ activity.title }}</h3>\r\n                      <p>{{ activity.description }}</p>\r\n                      <div class=\"activity-tags\">\r\n                        <el-tag size=\"small\" :type=\"activity.type\">{{ activity.category }}</el-tag>\r\n                      </div>\r\n                    </div>\r\n                  </div>\r\n                </el-card>\r\n              </el-timeline-item>\r\n            </el-timeline>\r\n          </div>\r\n        </el-tab-pane>\r\n        \r\n        <el-tab-pane label=\"社团组织\" name=\"clubs\">\r\n          <div class=\"section-content\">\r\n            <h2 class=\"section-title\">多元化的社团组织</h2>\r\n            \r\n            <el-row :gutter=\"20\">\r\n              <el-col :span=\"8\" v-for=\"club in studentClubs\" :key=\"club.id\">\r\n                <el-card class=\"club-card\" :body-style=\"{ padding: '0px' }\">\r\n                  <el-image :src=\"club.image\" class=\"club-image\"></el-image>\r\n                  <div style=\"padding: 14px;\">\r\n                    <h3>{{ club.name }}</h3>\r\n                    <div class=\"club-description\">{{ club.description }}</div>\r\n                    <div class=\"club-info\">\r\n                      <span>成立时间: {{ club.foundedTime }}</span>\r\n                      <span>成员数: {{ club.memberCount }}</span>\r\n                    </div>\r\n                    <div class=\"club-tags\">\r\n                      <el-tag size=\"mini\" type=\"success\">{{ club.category }}</el-tag>\r\n                    </div>\r\n                    <div class=\"club-contact\">\r\n                      <span>指导老师: {{ club.teacher }}</span>\r\n                    </div>\r\n                  </div>\r\n                </el-card>\r\n              </el-col>\r\n            </el-row>\r\n          </div>\r\n        </el-tab-pane>\r\n        \r\n        <el-tab-pane label=\"校史馆\" name=\"history\">\r\n          <div class=\"section-content\">\r\n            <h2 class=\"section-title\">学校历史沿革</h2>\r\n            \r\n            <el-steps direction=\"vertical\" :active=\"schoolHistory.length\">\r\n              <el-step \r\n                v-for=\"(history, index) in schoolHistory\" \r\n                :key=\"index\"\r\n                :title=\"history.year\"\r\n                :description=\"history.event\">\r\n                <template #icon>\r\n                  <el-image \r\n                    v-if=\"history.image\" \r\n                    :src=\"history.image\" \r\n                    class=\"history-image\"\r\n                    fit=\"cover\">\r\n                  </el-image>\r\n                </template>\r\n              </el-step>\r\n            </el-steps>\r\n            \r\n            <div class=\"history-gallery\">\r\n              <h3>历史照片墙</h3>\r\n              <el-row :gutter=\"10\">\r\n                <el-col :span=\"6\" v-for=\"(photo, index) in historyPhotos\" :key=\"index\">\r\n                  <el-card :body-style=\"{ padding: '0px' }\">\r\n                    <el-image \r\n                      :src=\"photo.src\" \r\n                      fit=\"cover\"\r\n                      class=\"gallery-image\"\r\n                      @click=\"showPhotoDetail(photo)\">\r\n                    </el-image>\r\n                    <div class=\"photo-info\">\r\n                      <span>{{ photo.year }} - {{ photo.title }}</span>\r\n                    </div>\r\n                  </el-card>\r\n                </el-col>\r\n              </el-row>\r\n            </div>\r\n          </div>\r\n        </el-tab-pane>\r\n      </el-tabs>\r\n    </div>\r\n    \r\n    <!-- 照片详情对话框 -->\r\n    <el-dialog\r\n      :visible.sync=\"dialogVisible\"\r\n      width=\"60%\">\r\n      <div class=\"photo-detail\" v-if=\"selectedPhoto\">\r\n        <el-image :src=\"selectedPhoto.src\" fit=\"contain\" style=\"width: 100%\"></el-image>\r\n        <h3>{{ selectedPhoto.title }}</h3>\r\n        <p>{{ selectedPhoto.description }}</p>\r\n        <p class=\"photo-year\">{{ selectedPhoto.year }}</p>\r\n      </div>\r\n    </el-dialog>\r\n    \r\n    <!-- 页脚 -->\r\n    <el-footer class=\"footer\">\r\n      <div class=\"footer-content\">\r\n        <div class=\"footer-info\">\r\n          <p>地址：深圳市宝安区石岩石龙仔路宝民学校</p>\r\n        </div>\r\n        <div class=\"copyright\">\r\n          © 2023 深圳市宝民职业技术学校 版权所有\r\n          <p>技术支持：dxh</p>\r\n        </div>\r\n      </div>\r\n    </el-footer>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'CampusCulture',\r\n  data() {\r\n    return {\r\n      activeTab: 'activities',\r\n      dialogVisible: false,\r\n      selectedPhoto: null,\r\n      campusActivities: [\r\n        {\r\n          id: 1,\r\n          title: '2023年校园文化艺术节',\r\n          date: '2023-05-20',\r\n          description: '为期一周的校园文化艺术节圆满结束，包括歌唱比赛、舞蹈表演、书法展览等多项活动，展示了学生的多才多艺。',\r\n          image: require('../assets/img/sy/carousel1.jpg'),\r\n          category: '文化艺术',\r\n          type: 'success',\r\n          color: '#67C23A'\r\n        },\r\n        {\r\n          id: 2,\r\n          title: '校运会',\r\n          date: '2023-04-15',\r\n          description: '一年一度的校运会在操场隆重举行，各班级学生积极参与，展现了良好的体育精神和团队协作能力。',\r\n          image: require('../assets/img/sy/carousel2.jpg'),\r\n          category: '体育赛事',\r\n          type: 'primary',\r\n          color: '#409EFF'\r\n        },\r\n        {\r\n          id: 3,\r\n          title: '职业技能大赛',\r\n          date: '2023-03-10',\r\n          description: '学校举办了职业技能大赛，学生们在各自专业领域展示了扎实的技能和创新能力，为未来就业打下坚实基础。',\r\n          image: require('../assets/img/sy/carousel3.jpg'),\r\n          category: '技能竞赛',\r\n          type: 'warning',\r\n          color: '#E6A23C'\r\n        }\r\n      ],\r\n      studentClubs: [\r\n        {\r\n          id: 1,\r\n          name: '科技创新社',\r\n          description: '致力于培养学生的科技创新能力，定期开展科技制作、编程培训等活动。',\r\n          image: require('../assets/img/sy/carousel1.jpg'),\r\n          foundedTime: '2018年',\r\n          memberCount: 45,\r\n          category: '科技类',\r\n          teacher: '张老师'\r\n        },\r\n        {\r\n          id: 2,\r\n          name: '文学社',\r\n          description: '为热爱文学的学生提供交流平台，定期举办读书会、写作比赛等活动。',\r\n          image: require('../assets/img/sy/carousel2.jpg'),\r\n          foundedTime: '2017年',\r\n          memberCount: 38,\r\n          category: '文化类',\r\n          teacher: '李老师'\r\n        },\r\n        {\r\n          id: 3,\r\n          name: '篮球社',\r\n          description: '组织校内篮球训练和比赛，培养学生的团队协作精神和体育素养。',\r\n          image: require('../assets/img/sy/carousel3.jpg'),\r\n          foundedTime: '2016年',\r\n          memberCount: 30,\r\n          category: '体育类',\r\n          teacher: '王老师'\r\n        }\r\n      ],\r\n      schoolHistory: [\r\n        {\r\n          year: '2015年',\r\n          event: '深圳市宝民职业技术学校正式成立，开设计算机应用、电子商务等专业。',\r\n          image: require('../assets/img/sy/carousel1.jpg')\r\n        },\r\n        {\r\n          year: '2017年',\r\n          event: '学校扩建教学楼，增设实训基地，新增幼儿教育、汽车维修等专业。',\r\n          image: require('../assets/img/sy/carousel2.jpg')\r\n        },\r\n        {\r\n          year: '2019年',\r\n          event: '学校被判为\"深圳市优质职业学校\"，教学质量和管理水平得到认可。',\r\n          image: require('../assets/img/sy/carousel3.jpg')\r\n        },\r\n        {\r\n          year: '2021年',\r\n          event: '学校与多家知名企业建立校企合作关系，为学生提供更多实习和就业机会。',\r\n          image: require('../assets/img/sy/carousel1.jpg')\r\n        },\r\n        {\r\n          year: '2023年',\r\n          event: '学校举办建校八周年庆典，回顾发展历程，展望美好未来。',\r\n          image: require('../assets/img/sy/carousel2.jpg')\r\n        }\r\n      ],\r\n      historyPhotos: [\r\n        {\r\n          src: require('../assets/img/sy/carousel1.jpg'),\r\n          year: '2015',\r\n          title: '学校成立',\r\n          description: '深圳市宝民职业技术学校成立仪式现场。'\r\n        },\r\n        {\r\n          src: require('../assets/img/sy/carousel2.jpg'),\r\n          year: '2017',\r\n          title: '新教学楼落成',\r\n          description: '新教学楼落成剪彩仪式。'\r\n        },\r\n        {\r\n          src: require('../assets/img/sy/carousel3.jpg'),\r\n          year: '2019',\r\n          title: '获奖证书',\r\n          description: '\"深圳市优质职业学校\"荣誉证书。'\r\n        },\r\n        {\r\n          src: require('../assets/img/sy/carousel1.jpg'),\r\n          year: '2021',\r\n          title: '校企合作',\r\n          description: '与华为公司签署校企合作协议。'\r\n        }\r\n      ]\r\n    }\r\n  },\r\n  methods: {\r\n    showPhotoDetail(photo) {\r\n      this.selectedPhoto = photo;\r\n      this.dialogVisible = true;\r\n    }\r\n  },\r\n  created() {\r\n    // 如果有路由参数指定标签，则切换到对应标签\r\n    if (this.$route.params.tab) {\r\n      this.activeTab = this.$route.params.tab;\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.campus-culture-page {\r\n  display: flex;\r\n  flex-direction: column;\r\n  min-height: 100vh;\r\n}\r\n\r\n.header {\r\n  background-color: #0d47a1;\r\n  color: white;\r\n  padding: 10px 20px;\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n}\r\n\r\n.logo-container {\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n.school-logo {\r\n  display: flex;\r\n  align-items: center;\r\n  margin-right: 15px;\r\n}\r\n\r\n.school-logo img {\r\n  width: 50px;\r\n  height: auto;\r\n}\r\n\r\n.school-name h1 {\r\n  margin: 0;\r\n  font-size: 24px;\r\n}\r\n\r\n.school-name p {\r\n  margin: 0;\r\n  font-size: 12px;\r\n}\r\n\r\n.nav-links {\r\n  display: flex;\r\n}\r\n\r\n.nav-link {\r\n  color: white;\r\n  text-decoration: none;\r\n  margin-left: 20px;\r\n  font-size: 14px;\r\n}\r\n\r\n.nav-link:hover {\r\n  text-decoration: underline;\r\n}\r\n\r\n.content-container {\r\n  flex: 1;\r\n  padding: 20px;\r\n  background-color: #f5f5f5;\r\n}\r\n\r\n.page-title {\r\n  text-align: center;\r\n  color: #0d47a1;\r\n  margin-bottom: 30px;\r\n  position: relative;\r\n}\r\n\r\n.page-title:after {\r\n  content: '';\r\n  position: absolute;\r\n  bottom: -10px;\r\n  left: 50%;\r\n  transform: translateX(-50%);\r\n  width: 80px;\r\n  height: 3px;\r\n  background-color: #0d47a1;\r\n}\r\n\r\n.culture-tabs {\r\n  margin-top: 30px;\r\n}\r\n\r\n.section-content {\r\n  padding: 20px 0;\r\n}\r\n\r\n/* 优化字体大小 */\r\n.section-title {\r\n  color: #0d47a1;\r\n  margin-bottom: 30px;\r\n  text-align: center;\r\n  font-size: 28px;  /* 增大标题字体 */\r\n  font-weight: bold;\r\n}\r\n\r\n.el-timeline-item__content h3 {\r\n  font-size: 20px;  /* 增大时间线标题字体 */\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.el-timeline-item__content p {\r\n  font-size: 16px;  /* 增大时间线内容字体 */\r\n  line-height: 1.6;\r\n}\r\n\r\n/* 优化图片尺寸 */\r\n.activity-image {\r\n  width: 300px;  /* 增加活动图片宽度 */\r\n  height: 200px;  /* 增加活动图片高度 */\r\n  margin-right: 20px;\r\n  overflow: hidden;\r\n}\r\n\r\n.club-image {\r\n  width: 100%;\r\n  height: 220px;  /* 增加社团图片高度 */\r\n}\r\n\r\n.history-image {\r\n  width: 60px;  /* 增加历史时间线图片尺寸 */\r\n  height: 60px;\r\n  border-radius: 50%;\r\n  border: 3px solid #0d47a1;  /* 添加边框突出显示 */\r\n}\r\n\r\n.gallery-image {\r\n  width: 100%;\r\n  height: 180px;  /* 增加图库图片高度 */\r\n  cursor: pointer;\r\n  transition: all 0.3s;\r\n}\r\n\r\n/* 优化整体布局 */\r\n.content-container {\r\n  flex: 1;\r\n  padding: 30px;  /* 增加内边距 */\r\n  background-color: #f5f5f5;\r\n  max-width: 1200px;  /* 限制最大宽度 */\r\n  margin: 0 auto;  /* 居中显示 */\r\n}\r\n\r\n/* 优化时间线样式 */\r\n.el-timeline {\r\n  padding: 20px;\r\n  background-color: #fff;\r\n  border-radius: 8px;\r\n  box-shadow: 0 2px 12px 0 rgba(0, 0, 0, 0.1);\r\n}\r\n\r\n.el-timeline-item__node {\r\n  width: 16px;\r\n  height: 16px;\r\n}\r\n\r\n.el-timeline-item__wrapper {\r\n  padding-left: 20px;\r\n}\r\n\r\n/* 优化校史馆时间线样式 */\r\n.el-steps {\r\n  background-color: #fff;\r\n  padding: 