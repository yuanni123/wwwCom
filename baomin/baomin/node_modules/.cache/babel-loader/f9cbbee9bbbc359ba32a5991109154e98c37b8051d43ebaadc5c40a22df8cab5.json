{"ast":null,"code":"//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n\nimport MainNavigation from '../components/MainNavigation.vue';\nimport MoralActivities from '../components/MoralActivities.vue';\nimport MentalHealth from '../components/MentalHealth.vue';\nimport ExcellentStudents from '../components/ExcellentStudents.vue';\nimport StudentWorks from '../components/StudentWorks.vue';\nexport default {\n  name: 'MoralEducationPage',\n  components: {\n    MainNavigation,\n    MoralActivities,\n    MentalHealth,\n    ExcellentStudents,\n    StudentWorks\n  },\n  props: {\n    tab: {\n      type: String,\n      default: 'activities'\n    }\n  },\n  watch: {\n    '$route.query.tab': {\n      handler(newTab) {\n        this.tab = newTab || 'activities';\n      },\n      immediate: true\n    }\n  },\n  data() {\n    return {\n      currentTab: this.tab\n    };\n  },\n  mounted() {\n    console.log('MoralEducationPage 组件已加载，当前选项卡:', this.tab);\n  }\n};","map":{"version":3,"names":["MainNavigation","MoralActivities","MentalHealth","ExcellentStudents","StudentWorks","name","components","props","tab","type","String","default","watch","handler","newTab","immediate","data","currentTab","mounted","console","log"],"sources":["src/views/MoralEducationPage.vue"],"sourcesContent":["<template>\r\n  <div class=\"moral-education-page\">\r\n    <el-header class=\"header\">\r\n      <div class=\"logo-container\">\r\n        <div class=\"school-name\">\r\n          <h1>深圳市宝民职业技术学校</h1>\r\n          <p>SHENZHEN BAOMIN VOCATIONAL TECHNICAL SCHOOL</p>\r\n        </div>\r\n      </div>\r\n    </el-header>\r\n    \r\n    <!-- 使用导航栏组件 -->\r\n    <main-navigation active-index=\"4\"></main-navigation>\r\n    \r\n    <el-container class=\"main-container\">\r\n      <el-main class=\"main-content\">\r\n        <!-- 根据tab参数显示不同内容 -->\r\n        <div v-if