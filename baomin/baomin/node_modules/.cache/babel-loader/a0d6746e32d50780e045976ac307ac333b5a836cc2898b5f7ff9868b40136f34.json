eriod: '2020-至今',\n  description: '信息技术与教育融合专家，引领学校智慧校园建设，推动教育创新发展。',\n  image: '/images/principal5.jpg'\n}]);\nconst achievements = ref([{\n  title: '国家级示范学校',\n  description: '因教育教学质量优异，被教育部评为国家级示范学校。',\n  year: '2008年',\n  icon: '/images/award-icon1.svg'\n}, {\n  title: '教学成果特等奖',\n  description: '学校教学改革成果《创新人才培养模式的探索与实践》获国家级教学成果特等奖。',\n  year: '2012年',\n  icon: '/images/award-icon2.svg'\n}, {\n  title: '科技创新基地',\n  description: '被认定为国家级青少年科技创新教育基地，培养了大批科技创新人才。',\n  year: '2015年',\n  icon: '/images/award-icon3.svg'\n}, {\n  title: '文化传承示范校',\n  description: '因在传统文化教育方面的突出贡献，被判为全国中华优秀传统文化传承示范校。',\n  year: '2018年',\n  icon: '/images/award-icon4.svg'\n}, {\n  title: '智慧教育示范区',\n  description: '学校智慧校园建设成果显著，被列入国家智慧教育示范区建设项目。',\n  year: '2021年',\n  icon: '/images/award-icon5.svg'\n}]);\nconst campusImages = ref([{\n  year: '1978年',\n  src: '/images/campus-1978.jpg',\n  description: '学校初建时期的校园面貌，简朴而充满希望。'\n}, {\n  year: '1990年',\n  src: '/images/campus-1990.jpg',\n  description: '经过首次扩建后的校园，教学设施逐步完善。'\n}, {\n  year: '2000年',\n  src: '/images/campus-2000.jpg',\n  description: '新校区启用，现代化教学楼群初具规模。'\n}, {\n  year: '2010年',\n  src: '/images/campus-2010.jpg',\n  description: '校园环境优美，绿化面积大幅增加，成为花园式学校。'\n}, {\n  year: '2020年',\n  src: '/images/campus-2020.jpg',\n  description: '智慧校园建设后的现代化校园，科技感与人文气息并存。'\n}]);","map":{"version":3,"names":["ref","historyEvents","year","title","description","image","importantFigures","name","period","achievements","icon","campusImages","src"],"sources":["src/lsh/SchoolHistory.vue"],"sourcesContent":["<template>\r\n  <div class=\"school-history\">\r\n    <h1 class=\"section-title\">校史馆</h1>\r\n    <p class=\"section-desc\">了解我校的发展历程和辉煌成就</p>\r\n\r\n    <div class=\"history-timeline\">\r\n      <div class=\"timeline-header\">\r\n        <h2>学校发展历程</h2>\r\n      </div>\r\n      <div class=\"timeline\">\r\n        <div v-for=\"(event, index) in historyEvents\" :key=\"index\" class=\"timeline-item\">\r\n          <div class=\"timeline-dot\"></div>\r\n          <div class=\"timeline-content\">\r\n            <div class=\"timeline-year\">{{ event.year }}</div>\r\n            <h3 class=\"timeline-title\">{{ event.title }}</h3>\r\n            <p class=\"timeline-desc\">{{ event.description }}</p>\r\n            <div class=\"timeline-image\" v-if=\"event.image\">\r\n              <img :src=\"event.image\" :alt=\"event.title\">\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"important-figures\">\r\n      <h2>历任校长</h2>\r\n      <div class=\"figures-grid\">\r\n        <div v-for=\"(figure, index) in importantFigures\" :key=\"index\" class=\"figure-card\">\r\n          <div class=\"figure-image\">\r\n            <img :src=\"figure.image\" :alt=\"figure.name\">\r\n          </div>\r\n          <div class=\"figure-info\">\r\n            <h3>{{ figure.name }}</h3>\r\n            <p class=\"figure-period\">{{ figure.period }}</p>\r\n            <p class=\"figure-desc\">{{ figure.description }}</p>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"achievements\">\r\n      <h2>学校荣誉与成就</h2>\r\n      <div class=\"achievement-cards\">\r\n        <div v-for=\"(achievement, index) in achievements\" :key=\"index\" class=\"achievement-card\">\r\n          <div class=\"achievement-icon\">\r\n            <img :src=\"achievement.icon\" :alt=\"achievement.title\">\r\n          </div>\r\n          <div class=\"achievement-content\">\r\n            <h3>{{ achievement.title }}</h3>\r\n            <p>{{ achievement.description }}</p>\r\n            <div class=\"achievement-year\">{{ achievement.year }}</div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"campus-changes\">\r\n      <h2>校园变迁</h2>\r\n      <div class=\"campus-gallery\">\r\n        <div v-for=\"(image, index) in campusImages\" :key=\"index\" class=\"campus-image-container\">\r\n          <div class=\"campus-image\">\r\n            <img :src=\"image.src\" :alt=\"image.year\">\r\n          </div>\r\n          <div class=\"campus-image-caption\">\r\n            <span class=\"campus-image-year\">{{ image.year }}</span>\r\n            <p>{{ image.description }}</p>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script setup>\r\nimport { ref } from 'vue';\r\n\r\nconst historyEvents = ref([\r\n  {\r\n    year: '1978',\r\n    title: '学校成立',\r\n    description: '在改革开放的浪潮中，我校正式成立，开始了教育事业的探索之路。',\r\n    image: '/images/founding.jpg'\r\n  },\r\n  {\r\n    year: '1985',\r\n    title: '首次扩建',\r\n    description: '随着学校规模扩大，进行了首次校园扩建，新增教学楼和实验室。',\r\n    image: '/images/expansion.jpg'\r\n  },\r\n  {\r\n    year: '1992',\r\n    title: '升格为重点学校',\r\n    description: '因教学质量突出，被判为市级重点学校，教育水平得到社会广泛认可。',\r\n    image: '/images/key-school.jpg'\r\n  },\r\n  {\r\n    year: '2000',\r\n    title: '新校区启用',\r\n    description: '为适应新世纪教育发展需求，新校区正式启用，教学环境得到极大改善。',\r\n    image: '/images/new-campus.jpg'\r\n  },\r\n  {\r\n    year: '2008',\r\n    title: '获评示范学校',\r\n    description: '学校综合实力显著提升，被判为国家级示范学校，迈入新的发展阶段。',\r\n    image: '/images/model-school.jpg'\r\n  },\r\n  {\r\n    year: '2015',\r\n    title: '国际交流中心成立',\r\n    description: '为促进国际教育交流，学校成立国际交流中心，开展多种形式的国际合作项目。',\r\n    image: '/images/international-center.jpg'\r\n  },\r\n  {\r\n    year: '2020',\r\n    title: '智慧校园建设',\r\n    description: '全方位打造智慧校园建设，实现教学、管理、服务的信息化和智能化。',\r\n    image: '/images/smart-campus.jpg'\r\n  },\r\n  {\r\n    year: '2023',\r\n    title: '建校45周年',\r\n    description: '学校迎来建校45周年，举办系列庆祝活动，回顾历史，展望未来。',\r\n    image: '/images/anniversary.jpg'\r\n  }\r\n]);\r\n\r\nconst importantFigures = ref([\r\n  {\r\n    name: '张明远教授',\r\n    period: '1978-1988',\r\n    description: '学校首任校长，教育家，为学校奠定了坚实的发展基础。',\r\n    image: '/images/principal1.jpg'\r\n  },\r\n  {\r\n    name: '李伟博士',\r\n    period: '1988-2000',\r\n    description: '著名学者，在任期间推动学校成为市级重点学校，大力发展科研教学。',\r\n    image: '/images/principal2.jpg'\r\n  },\r\n  {\r\n    name: '王建国教授',\r\n    period: '2000-2010',\r\n    description: '教育改革家，主导新校区建设和示范学校创建工作，提升了学校综合实力。',\r\n    image: '/images/principal3.jpg'\r\n  },\r\n  {\r\n    name: '陈学智博士',\r\n    period: '2010-2020',\r\n    description: '国际教育专家，推动国际交流中心成立，开创学校国际化发展新局面。',\r\n    image: '/images/principal4.jpg'\r\n  },\r\n  {\r\n    name: '林文华教授',\r\n    period: '2020-至今',\r\n    description: '信息技术与教育融合专家，引领学校智慧校园建设，推动教育创新发展。',\r\n    image: '/images/principal5.jpg'\r\n  }\r\n]);\r\n\r\nconst achievements = ref([\r\n  {\r\n    title: '国家级示范学校',\r\n    description: '因教育教学质量优异，被教育部评为国家级示范学校。',\r\n    year: '2008年',\r\n    icon: '/images/award-icon1.svg'\r\n  },\r\n  {\r\n    title: '教学成果特等奖',\r\n    description: '学校教学改革成果《创新人才培养模式的探索与实践》获国家级教学成果特等奖。',\r\n    year: '2012年',\r\n    icon: '/images/award-icon2.svg'\r\n  },\r\n  {\r\n    title: '科技创新基地',\r\n    description: '被认定为国家级青少年科技创新教育基地，培养了大批科技创新人才。',\r\n    year: '2015年',\r\n    icon: '/images/award-icon3.svg'\r\n  },\r\n  {\r\n    title: '文化传承示范校',\r\n    description: '因在传统文化教育方面的突出贡献，被判为全国中华优秀传统文化传承示范校。',\r\n    year: '2018年',\r\n    icon: '/images/award-icon4.svg'\r\n  },\r\n  {\r\n    title: '智慧教育示范区',\r\n    description: '学校智慧校园建设成果显著，被列入国家智慧教育示范区建设项目。',\r\n    year: '2021年',\r\n    icon: '/images/award-icon5.svg'\r\n  }\r\n]);\r\n\r\nconst campusImages = ref([\r\n  {\r\n    year: '1978年',\r\n    src: '/images/campus-1978.jpg',\r\n    description: '学校初建时期的校园面貌，简朴而充满希望。'\r\n  },\r\n  {\r\n    year: '1990年',\r\n    src: '/images/campus-1990.jpg',\r\n    description: '经过首次扩建后的校园，教学设施逐步完善。'\r\n  },\r\n  {\r\n    year: '2000年',\r\n    src: '/images/campus-2000.jpg',\r\n    description: '新校区启用，现代化教学楼群初具规模。'\r\n  },\r\n  {\r\n    year: '2010年',\r\n    src: '/images/campus-2010.jpg',\r\n    description: '校园环境优美，绿化面积大幅增加，成为花园式学校。'\r\n  },\r\n  {\r\n    year: '2020年',\r\n    src: '/images/campus-2020.jpg',\r\n    description: '智慧校园建设后的现代化校园，科技感与人文气息并存。'\r\n  }\r\n]);\r\n</script>\r\n\r\n<style scoped>\r\n.school-history {\r\n  padding: 1rem;\r\n}\r\n\r\n.section-title {\r\n  color: #1e3c72;\r\n  font-size: 2.5rem;\r\n  margin-bottom: 0.5rem;\r\n  text-align: center;\r\n}\r\n\r\n.section-desc {\r\n  color: #666;\r\n  text-align: center;\r\n  margin-bottom: 2rem;\r\n  font-size: 1.2rem;\r\n}\r\n\r\n.history-timeline {\r\n  margin-bottom: 3rem;\r\n}\r\n\r\n.timeline-header h2 {\r\n  color: #1e3c72;\r\n  margin-bottom: 1.5rem;\r\n  font-size: 1.8rem;\r\n  border-bottom: 2px solid #e0e0e0;\r\n  padding-bottom: 0.5rem;\r\n}\r\n\r\n.timeline {\r\n  position: relative;\r\n  padding: 2rem 0;\r\n}\r\n\r\n.timeline::before {\r\n  content: '';\r\n  position: absolute;\r\n  top: 0;\r\n  bottom: 0;\r\n  left: 50px;\r\n  width: 4px;\r\n  background: linear-gradient(to bottom, #1e3c72, #2a5298);\r\n}\r\n\r\n.timeline-item {\r\n  position: relative;\r\n  padding-left: 100px;\r\n  margin-bottom: 3rem;\r\n}\r\n\r\n.timeline-dot {\r\n  position: absolute;\r\n  left: 42px;\r\n  width: 20px;\r\n  height: 20px;\r\n  border-radius: 50%;\r\n  background-color: #1e3c72;\r\n  border: 4px solid white;\r\n  box-shadow: 0 0 0 3px rgba(30, 60, 114, 0.3);\r\n}\r\n\r\n.timeline-content {\r\n  background-color: white;\r\n  padding: 1.5rem;\r\n  border-radius: 8px;\r\n  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);\r\n}\r\n\r\n.timeline-year {\r\n  display: inline-block;\r\n  padding: 0.3rem 1rem;\r\n  background-color: #1e3c72;\r\n  color: white;\r\n  border-radius: 20px;\r\n  font-weight: bold;\r\n  margin-bottom: 0.8rem;\r\n}\r\n\r\n.timeline-title {\r\n  color: #1e3c72;\r\n  margin-bottom: 0.8rem;\r\n  font-size: 1.4rem;\r\n}\r\n\r\n.timeline-desc {\r\n  color: #666;\r\n  line-height: 1.6;\r\n  margin-bottom: 1rem;\r\n}\r\n\r\n.timeline-image img {\r\n  width: 100%;\r\n  border-radius: 4px;\r\n  margin-top: 1rem;\r\n}\r\n\r\n.important-figures {\r\n  margin-bottom: 3rem;\r\n}\r\n\r\n.important-figures h2 {\r\n  color: #1e3c72;\r\n  margin-bottom: 1.5rem;\r\n  font-size: 1.8rem;\r\n  border-bottom: 2px solid #e0e0e0;\r\n  padding-bottom: 0.5rem;\r\n}\r\n\r\n.figures-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));\r\n  gap: 2rem;\r\n}\r\n\r\n.figure-card {\r\n  background-color: white;\r\n  border-radius: 8px;\r\n  overflow: hidden;\r\n  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n.figure-image img {\r\n  width: 100%;\r\n  height: 250px;\r\n  object-fit: cover;\r\n}\r\n\r\n.figure-info {\r\n  padding: 1.5rem;\r\n}\r\n\r\n.figure-info h3 {\r\n  color: #1e3c72;\r\n  margin-bottom: 0.5rem;\r\n  font-size: 1.4rem;\r\n}\r\n\r\n.figure-period {\r\n  color: #888;\r\n  font-style: italic;\r\n  margin-bottom: 1rem;\r\n}\r\n\r\n.figure-desc {\r\n  color: #666;\r\n  line-height: 1.5;\r\n}\r\n\r\n.achievements {\r\n  margin-bottom: 3rem;\r\n}\r\n\r\n.achievements h2 {\r\n  color: #1e3c72;\r\n  margin-bottom: 1.5rem;\r\n  font-size: 1.8rem;\r\n  border-bottom: 2px solid #e0e0e0;\r\n  padding-bottom: 0.5rem;\r\n}\r\n\r\n.achievement-cards {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));\r\n  gap: 1.5rem;\r\n}\r\n\r\n.campus-gallery {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));\r\n  gap: 1.5rem;\r\n}\r\n</style>"],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AA0EA,SAAAA,GAAA;AAEA,MAAAC,aAAA,GAAAD,GAAA,EACA;EACAE,IAAA;EACAC,KAAA;EACAC,WAAA;EACAC,KAAA;AACA,GACA;EACAH,IAAA;EACAC,KAAA;EACAC,WAAA;EACAC,KAAA;AACA,GACA;EACAH,IAAA;EACAC,KAAA;EACAC,WAAA;EACAC,KAAA;AACA,GACA;EACAH,IAAA;EACAC,KAAA;EACAC,WAAA;EACAC,KAAA;AACA,GACA;EACAH,IAAA;EACAC,KAAA;EACAC,WAAA;EACAC,KAAA;AACA,GACA;EACAH,IAAA;EACAC,KAAA;EACAC,WAAA;EACAC,KAAA;AACA,GACA;EACAH,IAAA;EACAC,KAAA;EACAC,WAAA;EACAC,KAAA;AACA,GACA;EACAH,IAAA;EACAC,KAAA;EACAC,WAAA;EACAC,KAAA;AACA,EACA;AAEA,MAAAC,gBAAA,GAAAN,GAAA,EACA;EACAO,IAAA;EACAC,MAAA;EACAJ,WAAA;EACAC,KAAA;AACA,GACA;EACAE,IAAA;EACAC,MAAA;EACAJ,WAAA;E