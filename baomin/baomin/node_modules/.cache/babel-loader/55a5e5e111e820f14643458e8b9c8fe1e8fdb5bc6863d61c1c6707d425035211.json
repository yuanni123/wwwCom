{"ast":null,"code":"//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n\nexport default {\n  name: 'ExcellentStudents',\n  data() {\n    return {\n      excellentStudents: [{\n        name: '张三',\n        class: '计算机应用1班',\n        achievement: '全国技能大赛一等奖',\n        image: '/images/students/student1.jpg'\n      }, {\n        name: '李四',\n        class: '电子商务2班',\n        achievement: '省级优秀学生',\n        image: '/images/students/student2.jpg'\n      }\n      // 可以添加更多学生数据\n      ]\n    };\n  }\n};","map":{"version":3,"names":["name","data","excellentStudents","class","achievement","image"],"sources":["src/components/ExcellentStudents.vue"],"sourcesContent":["<template>\r\n  <div class=\"excellent-students\">\r\n    <h3>优秀学生展示</h3>\r\n    <el-row :gutter=\"20\">\r\n      <el-col :xs=\"24\" :sm=\"12\" :md=\"8\" v-for=\"(student, index) in excellentStudents\" :key=\"index\">\r\n        <el-card class=\"student-card\">\r\n          <div class=\"student-image\">\r\n            <img :src=\"student.image\" alt=\"学生照片\">\r\n          </div>\r\n          <div class=\"student-info\">\r\n            <h4>{{ student.name }}</h4>\r\n            <p class=\"student-class\">{{ student.class }}</p>\r\n            <p class=\"student-achievement\">{{ student.achievement }}</p>\r\n          </div>\r\n        </el-card>\r\n      </el-col>\r\n    </el-row>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'ExcellentStudents',\r\n  data() {\r\n    return {\r\n      excellentStudents: [\r\n        {\r\n          name: '张三',\r\n          class: '计算机应用1班',\r\n          achievement: '全国技能大赛一等奖',\r\n          image: '/images/students/student1.jpg'\r\n        },\r\n        {\r\n          name: '李四',\r\n          class: '电子商务2班',\r\n          achievement: '省级优秀学生',\r\n          image: '/images/students/student2.jpg'\r\n        },\r\n        // 可以添加更多学生数据\r\n      ]\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.excellent-students {\r\n  margin-bottom: 30px;\r\n}\r\n\r\n.student-card {\r\n  margin-bottom: 20px;\r\n  transition: all 0.3s;\r\n}\r\n\r\n.student-card:hover {\r\n  transform: translateY(-5px);\r\n  box-shadow: 0 10px 20px rgba(0,0,0,0.1);\r\n}\r\n\r\n.student-image {\r\n  height: 200px;\r\n  overflow: hidden;\r\n}\r\n\r\n.student-image img {\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: cover;\r\n}\r\n\r\n.student-info {\r\n  padding: 15px;\r\n}\r\n\r\nh4 {\r\n  margin: 0 0 10px 0;\r\n  color: #0d47a1;\r\n}\r\n\r\n.student-class {\r\n  color: #666;\r\n  margin: 5px 0;\r\n}\r\n\r\n.student-achievement {\r\n  color: #e65100;\r\n  font-weight: bold;\r\n}\r\n</style>"],"mappings":";;;;;;;;;;;;;;;;;;;;;AAqBA;EACAA,IAAA;EACAC,KAAA;IACA;MACAC,iBAAA,GACA;QACAF,IAAA;QACAG,KAAA;QACAC,WAAA;QACAC,KAAA;MACA,GACA;QACAL,IAAA;QACAG,KAAA;QACAC,WAAA;QACAC,KAAA;MACA;MACA;MAAA;IAEA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}