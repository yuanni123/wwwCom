{"ast":null,"code":"//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n\nexport default {\n  name: 'NewsPage',\n  data() {\n    return {\n      newsItems: [{\n        id: 1,\n        title: '我校举办2023年技能大赛',\n        summary: '为提高学生专业技能水平，展示职业教育教学成果，我校于上周成功举办了2023年校内技能大赛。比赛涵盖电子技术、计算机应用、机械加工等多个专业领域，全校师生积极参与，展现了扎实的专业技能和良好的职业素养。',\n        date: '2023-05-15'\n      }, {\n        id: 2,\n        title: '校企合作新进展：与华为签署人才培养协议',\n        summary: '近日，我校与华为技术有限公司签署了校企合作协议，共同推进ICT人才培养计划。根据协议，双方将在课程开发、实训基地建设、教师培训、学生实习就业等方面开展深度合作，为学生提供更好的学习条件和就业机会。',\n        date: '2023-05-10'\n      }, {\n        id: 3,\n        title: '我校学生在省职业技能大赛中获佳绩',\n        summary: '在刚刚结束的广东省职业院校技能大赛中，我校学生表现优异，共获得一等奖2项、二等奖3项、三等奖5项。这一成绩充分展示了我校职业教育的教学水平和学生的专业技能，为学校赢得了荣誉。',\n        date: '2023-04-28'\n      }, {\n        id: 4,\n        title: '学校举办2023届毕业典礼',\n        summary: '6月20日，我校隆重举行2023届毕业典礼，校领导、教师代表与全体毕业生共同见证这一重要时刻，祝愿毕业生前程似锦。典礼上，校长对毕业生提出了殷切期望，希望他们不忘初心，砥砺前行，为社会做出贡献。',\n        date: '2023-06-20'\n      }, {\n        id: 5,\n        title: '我校开展\"职业素养提升月\"系列活动',\n        summary: '为培养学生良好的职业素养，提高就业竞争力，我校近期开展了\"职业素养提升月\"系列活动。活动包括职业礼仪培训、简历制作指导、模拟面试等环节，帮助学生了解职场要求，提升职业素养。',\n        date: '2023-04-15'\n      }, {\n        id: 6,\n        title: '学校召开教育教学工作会议',\n        summary: '上周，我校召开了2023年春季学期教育教学工作会议，总结了上学期工作成果，部署了本学期重点任务。会议强调要以提高教育教学质量为核心，深化教学改革，加强师资队伍建设，为学生提供更优质的教育服务。',\n        date: '2023-03-10'\n      }]\n    };\n  },\n  methods: {\n    backToHome() {\n      this.$router.push('/');\n    },\n    viewNewsDetail(id) {\n      this.$router.push(`/news/detail/${id}`);\n    },\n    formatDay(dateString) {\n      const date = new Date(dateString);\n      return date.getDate();\n    },\n    formatMonthYear(dateString) {\n      const date = new Date(dateString);\n      const month = date.getMonth() + 1;\n      return `${month}月`;\n    },\n    handleCurrentChange(val) {\n      console.log(`当前页: ${val}`);\n      // 这里可以添加分页加载数据的逻辑\n    }\n  }\n};","map":{"version":3,"names":["name","data","newsItems","id","title","summary","date","methods","backToHome","$router","push","viewNewsDetail","formatDay","dateString","Date","getDate","formatMonthYear","month","getMonth","handleCurrentChange","val","console","log"],"sources":["src/xinwen/NewsPage.vue"],"sourcesContent":["<template>\r\n  <div class=\"news-page-container\">\r\n    <el-header class=\"header\">\r\n      <div class=\"logo-container\">\r\n        <div class=\"school-logo\">\r\n          <img src=\"../assets/img/sy/fd343a2a5554bb33db411f6d23f6fb88.jpg\" alt=\"学校校标\" />\r\n        </div>\r\n        <div class=\"school-name\">\r\n          <h1>深圳市宝民职业技术学校</h1>\r\n          <p>SHENZHEN BAOMIN VOCATIONAL TECHNICAL SCHOOL</p>\r\n        </div>\r\n      </div>\r\n    </el-header>\r\n    \r\n    <!-- 返回首页按钮 -->\r\n    <div class=\"back-to-home\">\r\n      <el-button type=\"primary\" icon=\"el-icon-back\" @click=\"backToHome\">返回首页</el-button>\r\n    </div>\r\n    \r\n    <el-container class=\"main-container\">\r\n      <el-main class=\"main-content\">\r\n        <!-- 页面标题 -->\r\n        <div class=\"page-title\">\r\n          <h2>新闻中心</h2>\r\n          <div class=\"title-underline\"></div>\r\n        </div>\r\n        \r\n        <!-- 新闻列表 -->\r\n        <div class=\"news-list\">\r\n          <div v-for=\"news in newsItems\" :key=\"news.id\" class=\"news-item\" @click=\"viewNewsDetail(news.id)\">\r\n            <div class=\"news-date\">\r\n              <div class=\"day\">{{ formatDay(news.date) }}</div>\r\n              <div class=\"month-year\">{{ formatMonthYear(news.date) }}</div>\r\n            </div>\r\n            <div class=\"news-content\">\r\n              <h3 class=\"news-title\">{{ news.title }}</h3>\r\n              <p class=\"news-summary\">{{ news.summary }}</p>\r\n            </div>\r\n          </div>\r\n        </div>\r\n        \r\n        <!-- 分页 -->\r\n        <div class=\"pagination-container\">\r\n          <el-pagination\r\n            background\r\n            layout=\"prev, pager, next\"\r\n            :total=\"100\"\r\n            @current-change=\"handleCurrentChange\">\r\n          </el-pagination>\r\n        </div>\r\n      </el-main>\r\n    </el-container>\r\n    \r\n    <el-footer class=\"footer\">\r\n      <div class=\"footer-content\">\r\n        <div class=\"footer-info\">\r\n          <p>地址：深圳市宝安区石岩石龙仔路宝民学校</p>\r\n        </div>\r\n        <div class=\"copyright\">\r\n          © 2023 深圳市宝民职业技术学校 版权所有\r\n          <p>技术支持：dxh</p>\r\n        </div>\r\n      </div>\r\n    </el-footer>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'NewsPage',\r\n  data() {\r\n    return {\r\n      newsItems: [\r\n        {\r\n          id: 1,\r\n          title: '我校举办2023年技能大赛',\r\n          summary: '为提高学生专业技能水平，展示职业教育教学成果，我校于上周成功举办了2023年校内技能大赛。比赛涵盖电子技术、计算机应用、机械加工等多个专业领域，全校师生积极参与，展现了扎实的专业技能和良好的职业素养。',\r\n          date: '2023-05-15'\r\n        },\r\n        {\r\n          id: 2,\r\n          title: '校企合作新进展：与华为签署人才培养协议',\r\n          summary: '近日，我校与华为技术有限公司签署了校企合作协议，共同推进ICT人才培养计划。根据协议，双方将在课程开发、实训基地建设、教师培训、学生实习就业等方面开展深度合作，为学生提供更好的学习条件和就业机会。',\r\n          date: '2023-05-10'\r\n        },\r\n        {\r\n          id: 3,\r\n          title: '我校学生在省职业技能大赛中获佳绩',\r\n          summary: '在刚刚结束的广东省职业院校技能大赛中，我校学生表现优异，共获得一等奖2项、二等奖3项、三等奖5项。这一成绩充分展示了我校职业教育的教学水平和学生的专业技能，为学校赢得了荣誉。',\r\n          date: '2023-04-28'\r\n        },\r\n        {\r\n          id: 4,\r\n          title: '学校举办2023届毕业典礼',\r\n          summary: '6月20日，我校隆重举行2023届毕业典礼，校领导、教师代表与全体毕业生共同见证这一重要时刻，祝愿毕业生前程似锦。典礼上，校长对毕业生提出了殷切期望，希望他们不忘初心，砥砺前行，为社会做出贡献。',\r\n          date: '2023-06-20'\r\n        },\r\n        {\r\n          id: 5,\r\n          title: '我校开展\"职业素养提升月\"系列活动',\r\n          summary: '为培养学生良好的职业素养，提高就业竞争力，我校近期开展了\"职业素养提升月\"系列活动。活动包括职业礼仪培训、简历制作指导、模拟面试等环节，帮助学生了解职场要求，提升职业素养。',\r\n          date: '2023-04-15'\r\n        },\r\n        {\r\n          id: 6,\r\n          title: '学校召开教育教学工作会议',\r\n          summary: '上周，我校召开了2023年春季学期教育教学工作会议，总结了上学期工作成果，部署了本学期重点任务。会议强调要以提高教育教学质量为核心，深化教学改革，加强师资队伍建设，为学生提供更优质的教育服务。',\r\n          date: '2023-03-10'\r\n        }\r\n      ]\r\n    }\r\n  },\r\n  methods: {\r\n    backToHome() {\r\n      this.$router.push('/');\r\n    },\r\n    viewNewsDetail(id) {\r\n      this.$router.push(`/news/detail/${id}`);\r\n    },\r\n    formatDay(dateString) {\r\n      const date = new Date(dateString);\r\n      return date.getDate();\r\n    },\r\n    formatMonthYear(dateString) {\r\n      const date = new Date(dateString);\r\n      const month = date.getMonth() + 1;\r\n      return `${month}月`;\r\n    },\r\n    handleCurrentChange(val) {\r\n      console.log(`当前页: ${val}`);\r\n      // 这里可以添加分页加载数据的逻辑\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.news-page-container {\r\n  display: flex;\r\n  flex-direction: column;\r\n  min-height: 100vh;\r\n}\r\n\r\n.header {\r\n  background-color: #0d47a1;\r\n  color: white;\r\n  padding: 10px 20px;\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n.logo-container {\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n.school-logo {\r\n  display: flex;\r\n  align-items: center;\r\n  margin-right: 15px;\r\n}\r\n\r\n.school-logo img {\r\n  width: 50px;\r\n  height: auto;\r\n}\r\n\r\n.school-name h1 {\r\n  margin: 0;\r\n  font-size: 24px;\r\n}\r\n\r\n.school-name p {\r\n  margin: 0;\r\n  font-size: 12px;\r\n}\r\n\r\n.back-to-home {\r\n  margin: 15px 20px;\r\n}\r\n\r\n.main-container {\r\n  flex: 1;\r\n}\r\n\r\n.main-content {\r\n  padding: 20px;\r\n  background-color: #f5f5f5;\r\n}\r\n\r\n.page-title {\r\n  text-align: center;\r\n  margin-bottom: 30px;\r\n}\r\n\r\n.page-title h2 {\r\n  font-size: 28px;\r\n  color: #0d47a1;\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.title-underline {\r\n  width: 80px;\r\n  height: 3px;\r\n  background-color: #0d47a1;\r\n  margin: 0 auto;\r\n}\r\n\r\n.news-list {\r\n  margin-bottom: 30px;\r\n}\r\n\r\n.news-item {\r\n  display: flex;\r\n  margin-bottom: 20px;\r\n  background-color: white;\r\n  border-radius: 4px;\r\n  overflow: hidden;\r\n  box-shadow: 0 2px 12px 0 rgba(0, 0, 0, 0.1);\r\n  cursor: pointer;\r\n  transition: all 0.3s;\r\n}\r\n\r\n.news-item:hover {\r\n  transform: translateY(-5px);\r\n  box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);\r\n}\r\n\r\n.news-date {\r\n  background-color: #0d47a1;\r\n  color: white;\r\n  padding: 15px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  justify-content: center;\r\n  align-items: center;\r\n  min-width: 80px;\r\n}\r\n\r\n.day {\r\n  font-size: 24px;\r\n  font-weight: bold;\r\n}\r\n\r\n.month-year {\r\n  font-size: 14px;\r\n}\r\n\r\n.news-content {\r\n  padding: 15px;\r\n  flex: 1;\r\n}\r\n\r\n.news-title {\r\n  margin-top: 0;\r\n  margin-bottom: 10px;\r\n  color: #333;\r\n}\r\n\r\n.news-summary {\r\n  color: #666;\r\n  margin: 0;\r\n  line-height: 1.6;\r\n}\r\n\r\n.pagination-container {\r\n  display: flex;\r\n  justify-content: center;\r\n  margin-top: 30px;\r\n}\r\n\r\n.footer {\r\n  background-color: #535353;\r\n  color: white;\r\n  padding: 40px 0;\r\n  height: 160% !important;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n}\r\n\r\n.footer-content {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  justify-content: center;\r\n  font-size: 14px;\r\n}\r\n\r\n.footer-info {\r\n  margin-bottom: 15px;\r\n  text-align: center;\r\n}\r\n\r\n.footer-info p {\r\n  margin: 5px 0;\r\n  font-size: 13px;\r\n}\r\n\r\n.copyright {\r\n  text-align: center;\r\n  font-size: 12px;\r\n}\r\n\r\n.copyright p {\r\n  font-size: 11px;\r\n  margin: 3px 0;\r\n}\r\n\r\n@media (max-width: 768px) {\r\n  .news-item {\r\n    flex-direction: column;\r\n  }\r\n  \r\n  .news-date {\r\n    width: 100%;\r\n    flex-direction: row;\r\n    justify-content: flex-start;\r\n  }\r\n  \r\n  .day {\r\n    margin-right: 5px;\r\n  }\r\n}\r\n</style>"],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAoEA;EACAA,IAAA;EACAC,KAAA;IACA;MACAC,SAAA,GACA;QACAC,EAAA;QACAC,KAAA;QACAC,OAAA;QACAC,IAAA;MACA,GACA;QACAH,EAAA;QACAC,KAAA;QACAC,OAAA;QACAC,IAAA;MACA,GACA;QACAH,EAAA;QACAC,KAAA;QACAC,OAAA;QACAC,IAAA;MACA,GACA;QACAH,EAAA;QACAC,KAAA;QACAC,OAAA;QACAC,IAAA;MACA,GACA;QACAH,EAAA;QACAC,KAAA;QACAC,OAAA;QACAC,IAAA;MACA,GACA;QACAH,EAAA;QACAC,KAAA;QACAC,OAAA;QACAC,IAAA;MACA;IAEA;EACA;EACAC,OAAA;IACAC,WAAA;MACA,KAAAC,OAAA,CAAAC,IAAA;IACA;IACAC,eAAAR,EAAA;MACA,KAAAM,OAAA,CAAAC,IAAA,iBAAAP,EAAA;IACA;IACAS,UAAAC,UAAA;MACA,MAAAP,IAAA,OAAAQ,IAAA,CAAAD,UAAA;MACA,OAAAP,IAAA,CAAAS,OAAA;IACA;IACAC,gBAAAH,UAAA;MACA,MAAAP,IAAA,OAAAQ,IAAA,CAAAD,UAAA;MACA,MAAAI,KAAA,GAAAX,IAAA,CAAAY,QAAA;MACA,UAAAD,KAAA;IACA;IACAE,oBAAAC,GAAA;MACAC,OAAA,CAAAC,GAAA,SAAAF,GAAA;MACA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}