isor: '陈音老师',\r\n    logo: '/images/choir-club.jpg'\r\n  },\r\n  {\r\n    id: 7,\r\n    name: '辩论队',\r\n    categoryId: 'academic',\r\n    description: '提高学生的逻辑思维和表达能力，参加各类辩论赛事，举办校内辩论比赛。',\r\n    foundedYear: '2012年',\r\n    memberCount: 30,\r\n    advisor: '吴教授',\r\n    logo: '/images/debate-club.jpg'\r\n  },\r\n  {\r\n    id: 8,\r\n    name: '环保协会',\r\n    categoryId: 'volunteer',\r\n    description: '宣传环保理念，组织环保活动，如植树、垃圾分类宣传、校园清洁等。',\r\n    foundedYear: '2013年',\r\n    memberCount: 85,\r\n    advisor: '林教授',\r\n    logo: '/images/eco-club.jpg'\r\n  }\r\n]);\r\n\r\nconst clubActivities = ref([\r\n  {\r\n    title: '文学社诗歌朗诵会',\r\n    description: '以\"青春与梦想\"为主题的诗歌朗诵会，展示文学社成员的才艺。',\r\n    date: '2023-10-15',\r\n    club: '文学社',\r\n    location: '学校礼堂'\r\n  },\r\n  {\r\n    title: '篮球协会友谊赛',\r\n    description: '与兄弟学校进行的篮球友谊赛，增进校际交流。',\r\n    date: '2023-10-20',\r\n    club: '篮球协会',\r\n    location: '体育馆'\r\n  },\r\n  {\r\n    title: '环保协会植树活动',\r\n    description: '在校园周边进行的植树活动，提高环保意识。',\r\n    date: '2023-11-05',\r\n    club: '环保协会',\r\n    location: '校园东区'\r\n  }\r\n]);\r\n\r\nconst filteredClubs = computed(() => {\r\n  if (activeCategory.value === 'all') {\r\n    return clubs.value;\r\n  } else {\r\n    return clubs.value.filter(club => club.categoryId === activeCategory.value);\r\n  }\r\n});\r\n\r\nconst getCategoryName = (categoryId) => {\r\n  const category = categories.value.find(cat => cat.id === categoryId);\r\n  return category ? category.name : '';\r\n};\r\n</script>"],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAqEA,SAAAA,GAAA,EAAAC,QAAA;AAEA,MAAAC,cAAA,GAAAF,GAAA;AAEA,MAAAG,UAAA,GAAAH,GAAA,EACA;EAAAI,EAAA;EAAAC,IAAA;AAAA,GACA;EAAAD,EAAA;EAAAC,IAAA;AAAA,GACA;EAAAD,EAAA;EAAAC,IAAA;AAAA,GACA;EAAAD,EAAA;EAAAC,IAAA;AAAA,GACA;EAAAD,EAAA;EAAAC,IAAA;AAAA,GACA;EAAAD,EAAA;EAAAC,IAAA;AAAA,EACA;AAEA,MAAAC,KAAA,GAAAN,GAAA,EACA;EACAI,EAAA;EACAC,IAAA;EACAE,UAAA;EACAC,WAAA;EACAC,WAAA;EACAC,WAAA;EACAC,OAAA;EACAC,IAAA;AACA,GACA;EACAR