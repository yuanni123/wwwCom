{"ast":null,"code":"//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n\nimport { ref, computed } from 'vue';\nconst activeCategory = ref('all');\nconst categories = ref([{\n  id: 'all',\n  name: '全部社团'\n}, {\n  id: 'academic',\n  name: '学术研究'\n}, {\n  id: 'arts',\n  name: '文化艺术'\n}, {\n  id: 'sports',\n  name: '体育运动'\n}, {\n  id: 'volunteer',\n  name: '志愿公益'\n}, {\n  id: 'technology',\n  name: '科技创新'\n}]);\nconst clubs = ref([{\n  id: 1,\n  name: '文学社',\n  categoryId: 'academic',\n  description: '致力于培养学生的文学素养，开展诗歌朗诵、文学讲座、写作比赛等活动。',\n  foundedYear: '2005年',\n  memberCount: 78,\n  advisor: '李明教授',\n  logo: '/images/literature-club.jpg'\n}, {\n  id: 2,\n  name: '舞蹈团',\n  categoryId: 'arts',\n  description: '培养舞蹈爱好者，表演各类舞蹈，包括民族舞、现代舞、街舞等，定期举办舞蹈演出。',\n  foundedYear: '2008年',\n  memberCount: 45,\n  advisor: '张艺老师',\n  logo: '/images/dance-club.jpg'\n}, {\n  id: 3,\n  name: '篮球协会',\n  categoryId: 'sports',\n  description: '组织校内篮球比赛，提供篮球训练和交流的平台，增强学生体质。',\n  foundedYear: '2003年',\n  memberCount: 120,\n  advisor: '王强教练',\n  logo: '/images/basketball-club.jpg'\n}, {\n  id: 4,\n  name: '志愿者协会',\n  categoryId: 'volunteer',\n  description: '组织各类志愿服务活动，包括社区服务、环保活动、支教活动等，培养学生的社会责任感。',\n  foundedYear: '2010年',\n  memberCount: 200,\n  advisor: '赵慧老师',\n  logo: '/images/volunteer-club.jpg'\n}, {\n  id: 5,\n  name: '机器人俱乐部',\n  categoryId: 'technology',\n  description: '专注于机器人设计与制作，参加各类机器人比赛，培养学生的创新能力和实践能力。',\n  foundedYear: '2015年',\n  memberCount: 35,\n  advisor: '刘博士',\n  logo: '/images/robotics-club.jpg'\n}, {\n  id: 6,\n  name: '合唱团',\n  categoryId: 'arts',\n  description: '培养学生的音乐素养，定期举办合唱比赛和音乐会，参与校内外各类文艺演出。',\n  foundedYear: '2007年',\n  memberCount: 60,\n  advisor: '陈音老师',\n  logo: '/images/choir-club.jpg'\n}, {\n  id: 7,\n  name: '辩论队',\n  categoryId: 'academic',\n  description: '提高学生的逻辑思维和表达能力，参加各类辩论赛事，举办校内辩论比赛。',\n  foundedYear: '2012年',\n  memberCount: 30,\n  advisor: '吴教授',\n  logo: '/images/debate-club.jpg'\n}, {\n  id: 8,\n  name: '环保协会',\n  categoryId: 'volunteer',\n  description: '宣传环保理念，组织环保活动，如植树、垃圾分类宣传、校园清洁等。',\n  foundedYear: '2013年',\n  memberCount: 85,\n  advisor: '林教授',\n  logo: '/images/eco-club.jpg'\n}]);\nconst clubActivities = ref([{\n  title: '文学社诗歌朗诵会',\n  description: '以\"青春与梦想\"为主题的诗歌朗诵会，展示文学社成员的才艺。',\n  date: '2023-10-15',\n  club: '文学社',\n  location: '学校礼堂'\n}, {\n  title: '篮球协会友谊赛',\n  description: '与兄弟学校进行的篮球友谊赛，增进校际交流。',\n  date: '2023-10-20',\n  club: '篮球协会',\n  location: '体育馆'\n}, {\n  title: '环保协会植树活动',\n  description: '在校园周边进行的植树活动，提高环保意识。',\n  date: '2023-11-05',\n  club: '环保协会',\n  location: '校园东区'\n}]);\nconst filteredClubs = computed(() => {\n  if (activeCategory.value === 'all') {\n    return clubs.value;\n  } else {\n    return clubs.value.filter(club => club.categoryId === activeCategory.value);\n  }\n});\nconst getCategoryName = categoryId => {\n  const category = categories.value.find(cat => cat.id === categoryId);\n  return category ? category.name : '';\n};","map":{"version":3,"names":["ref","computed","activeCategory","categories","id","name","clubs","categoryId","description","foundedYear","memberCount","advisor","logo","clubActivities","title","date","club","location","filteredClubs","value","filter","getCategoryName","category","find","cat"],"sources":["src/lsh/StudentClubs.vue"],"sourcesContent":["<template>\r\n  <div class=\"student-clubs\">\r\n    <h1 class=\"section-title\">社团组织</h1>\r\n    <p class=\"section-desc\">探索丰富多彩的校园社团，找到志同道合的伙伴</p>\r\n\r\n    <div class=\"club-categories\">\r\n      <button \r\n        v-for=\"category in categories\" \r\n        :key=\"category.id\"\r\n        :class=\"['category-btn', { active: activeCategory === category.id }]\"\r\n        @click=\"activeCategory = category.id\"\r\n      >\r\n        {{ category.name }}\r\n      </button>\r\n    </div>\r\n\r\n    <div class=\"clubs-container\">\r\n      <div v-for=\"club in filteredClubs\" :key=\"club.id\" class=\"club-card\">\r\n        <div class=\"club-header\">\r\n          <div class=\"club-logo\" :style=\"{ backgroundImage: `url(${club.logo})` }\"></div>\r\n          <div class=\"club-title\">\r\n            <h3>{{ club.name }}</h3>\r\n            <span class=\"club-category\">{{ getCategoryName(club.categoryId) }}</span>\r\n          </div>\r\n        </div>\r\n        <div class=\"club-content\">\r\n          <p class=\"club-desc\">{{ club.description }}</p>\r\n          <div class=\"club-info\">\r\n            <div class=\"info-item\">\r\n              <span class=\"info-label\">成立时间</span>\r\n              <span class=\"info-value\">{{ club.foundedYear }}</span>\r\n            </div>\r\n            <div class=\"info-item\">\r\n              <span class=\"info-label\">成员数量</span>\r\n              <span class=\"info-value\">{{ club.memberCount }}人</span>\r\n            </div>\r\n            <div class=\"info-item\">\r\n              <span class=\"info-label\">指导老师</span>\r\n              <span class=\"info-value\">{{ club.advisor }}</span>\r\n            </div>\r\n          </div>\r\n        </div>\r\n        <div class=\"club-footer\">\r\n          <button class=\"join-btn\">加入社团</button>\r\n          <button class=\"more-btn\">了解更多</button>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"club-activities\">\r\n      <h2>最新社团活动</h2>\r\n      <div class=\"activity-timeline\">\r\n        <div v-for=\"(activity, index) in clubActivities\" :key=\"index\" class=\"timeline-item\">\r\n          <div class=\"timeline-date\">{{ activity.date }}</div>\r\n          <div class=\"timeline-content\">\r\n            <h3>{{ activity.title }}</h3>\r\n            <p>{{ activity.description }}</p>\r\n            <div class=\"timeline-meta\">\r\n              <span>{{ activity.club }}</span>\r\n              <span>{{ activity.location }}</s