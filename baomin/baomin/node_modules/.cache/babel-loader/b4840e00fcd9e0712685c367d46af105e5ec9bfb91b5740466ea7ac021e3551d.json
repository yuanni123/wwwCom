{"ast":null,"code":"//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n\nimport MainNavigation from '../components/MainNavigation.vue';\nexport default {\n  name: 'SchoolOverview',\n  components: {\n    MainNavigation\n  },\n  data() {\n    return {\n      activeTab: 'intro',\n      schoolImages: [require('../assets/img/school/school1.jpg'), require('../assets/img/school/school2.jpg'), require('../assets/img/school/school3.jpg')],\n      leadershipTeam: [{\n        id: 1,\n        name: '张校长',\n        title: '校长',\n        description: '从事教育工作30余年，曾获\"优秀教育工作者\"称号，致力于职业教育改革与创新。',\n        avatar: require('../assets/img/leaders/principal.jpg')\n      }, {\n        id: 2,\n        name: '李副校长',\n        title: '副校长',\n        description: '负责教学工作，推动校企合作，提升学校教学质量和学生就业率。',\n        avatar: require('../assets/img/leaders/vice_principal1.jpg')\n      }, {\n        id: 3,\n        name: '王副校长',\n        title: '副校长',\n        description: '负责学校行政和后勤工作，确保学校各项工作有序进行。',\n        avatar: require('../assets/img/leaders/vice_principal2.jpg')\n      }],\n      honors: [{\n        id: 1,\n        year: '2023年',\n        title: '广东省优质技工学校',\n        description: '学校被判为广东省优质技工学校，这是对学校办学质量的高度认可。',\n        color: '#409EFF',\n        image: require('../assets/img/honors/honor1.jpg')\n      }, {\n        id: 2,\n        year: '2022年',\n        title: '深圳市职业教育先进单位',\n        description: '学校被判为深圳市职业教育先进单位，表彰学校在职业教育领域的突出贡献。',\n        color: '#67C23A',\n        image: require('../assets/img/honors/honor2.jpg')\n      }, {\n        id: 3,\n        year: '2021年',\n        title: '校企合作示范基地',\n        description: '学校被判为校企合作示范基地，肯定了学校在校企合作方面的成果。',\n        color: '#E6A23C',\n        image: require('../assets/img/honors/honor3.jpg')\n      }],\n      campusImages: [{\n        url: require('../assets/img/campus/campus1.jpg'),\n        title: '教学楼'\n      }, {\n        url: require('../assets/img/campus/campus2.jpg'),\n        title: '实训中心'\n      }, {\n        url: require('../assets/img/campus/campus3.jpg'),\n        title: '图书馆'\n      }, {\n        url: require('../assets/img/campus/campus4.jpg'),\n        title: '运动场'\n      }, {\n        url: require('../assets/img/campus/campus5.jpg'),\n        title: '学生宿舍'\n      }, {\n        url: require('../assets/img/campus/campus6.jpg'),\n        title: '校园景观'\n      }]\n    };\n  },\n  created() {\n    // 根据URL查询参数设置当前活动的标签页\n    const tab = this.$route.query.tab;\n    if (tab) {\n      this.activeTab = tab;\n    }\n  },\n  watch: {\n    // 监听路由变化，更新活动标签页\n    '$route.query.tab': function (newTab) {\n      if (newTab) {\n        this.activeTab = newTab;\n      } else {\n        this.activeTab = 'intro';\n      }\n    }\n  },\n  methods: {\n    handleSelect(key) {\n      this.activeTab = key;\n      // 更新URL查询参数，但不触发路由变化\n      if (key === 'intro') {\n        this.$router.push({\n          path: '/school-overview'\n        });\n      } else {\n        this.$router.push({\n          path: '/school-overview',\n          query: {\n            tab: key\n          }\n        });\n      }\n    }\n  }\n};","map":{"version":3,"names":["MainNavigation","name","components","data","activeTab","schoolImages","require","leadershipTeam","id","title","description","avatar","honors","year","color","image","campusImages","url","created","tab","$route","query","watch","$route.query.tab","newTab","methods","handleSelect","key","$router","push","path"],"sources":["src/views/SchoolOverview.vue"],"sourcesContent":["<template>\r\n  <div class=\"school-overview-page\">\r\n    <el-header class=\"header\">\r\n      <div class=\"logo-container\">\r\n        <div class=\"school-name\">\r\n          <h1>深圳市宝民职业技术学校</h1>\r\n          <p>SHENZHEN BAOMIN VOCATIONAL TECHNICAL SCHOOL</p>\r\n        </div>\r\n      </div>\r\n    </el-header>\r\n    \r\n    <!-- 使用导航栏组件 -->\r\n    <main-navigation active-index=\"1\"></main-navigation>\r\n    \r\n    <el-container class=\"main-container\">\r\n      <el-aside width=\"220px\" class=\"sidebar\">\r\n        <el-menu\r\n          :default-active=\"activeTab\"\r\n          class=\"menu\"\r\n          background-color=\"#0d47a1\"\r\n          text-color=\"#fff\"\r\n          active-text-color=\"#ffd04b\"\r\n          @select=\"handleSelect\">\r\n          <el-menu-item index=\"intro\">\r\n            <span>学校简介</span>\r\n          </el-menu-item>\r\n          <el-menu-item index=\"leadership\">\r\n            <span>领导团队</span>\r\n          </el-menu-item>\r\n          <el-menu-item index=\"honors\">\r\n            <span>荣誉资质</span>\r\n          </el-menu-item>\r\n          <el-menu-item index=\"campus\">\r\n            <span>校园风光</span>\r\n          </el-menu-item>\r\n        </el-menu>\r\n      </el-aside>\r\n      \r\n      <el-main class=\"main-content\">\r\n        <!-- 学校简介 -->\r\n        <div v-show=\"activeTab === 'intro'\" class=\"content-section\">\r\n          <section class=\"section school-intro\">\r\n            <div class=\"section-title\">\r\n              <h2>学校简介</h2>\r\n            </div>\r\n            <div class=\"school-intro-content\">\r\n              <p>深圳市宝民技工学校是经深圳人力资源和社会保障厅批准设立的一所全日制技工学校，学校办学至今已有17年历史，以口碑办学。\r\n              学校目前开设有新媒体与互联网应用、网络营销与直播技术、计算机应用与维修、电子商务、幼儿教育、汽车维修、3D 打印技术应用、模具制造、电梯安装与维修等9个专业，\r\n              其中计算机应用与维修、电子商务、幼儿教育、新媒体与互联网应用、网络营销与直播技术等5个专业为常设专业。</p>\r\n\r\n              <p>学校加强校企合作，推进工学融合、模拟实训，致力于为社会培养既有一定专业理论水平，又有很强动手能力的高素质技术技能型人才。逐步形成\"产教联动、校企融合，企业环境、工学一体，素养为本、技能为用\"的办学模式</p>\r\n              \r\n              <div class=\"school-images\">\r\n                <el-carousel :interval=\"4000\" type=\"card\" height=\"300px\">\r\n                  <el-carousel-item v-for=\"(image, index) in schoolImages\" :key=\"index\">\r\n                    <el-image :src=\"image\" fit=\"cover\" class=\"carousel-image\"></el-image>\r\n                  </el-carousel-item>\r\n                </el-carousel>\r\n              </div>\r\n            </div>\r\n          </section>\r\n        </div>\r\n\r\n        <!-- 领导团队 -->\r\n        <div v-show=\"activeTab === 'leadership'\" class=\"content-section\">\r\n          <section class=\"section leadership\">\r\n            <div class=\"section-title\">\r\n              <h2>领导团队</h2>\r\n            </div>\r\n            <div class=\"leadership-content\">\r\n              <el-row :gutter=\"20\">\r\n                <el-col :span=\"8\" v-for=\"leader in leadershipTeam\" :key=\"leader.id\">\r\n                  <el-card class=\"leader-card\" shadow=\"hover\">\r\n                    <div class=\"leader-avatar\">\r\n                      <el-avatar :size=\"100\" :src=\"leader.avatar\"></el-avatar>\r\n                    </div>\r\n                    <div class=\"leader-info\">\r\n                      <h3>{{ leader.name }}</h3>\r\n                      <p class=\"leader-title\">{{ leader.title }}</p>\r\n                      <p class=\"leader-description\">{{ leader.description }}</p>\r\n                    </div>\r\n                  </el-card>\r\n                </el-col>\r\n              </el-row>\r\n            </div>\r\n          </section>\r\n        </div>\r\n\r\n        <!-- 荣誉资质 -->\r\n        <div v-show=\"activeTab === 'honors'\" class=\"content-section\">\r\n          <section class=\"section honors\">\r\n            <div class=\"section-title\">\r\n              <h2>荣誉资质</h2>\r\n            </div>\r\n            <div class=\"honors-content\">\r\n              <el-timeline>\r\n                <el-timeline-item\r\n                  v-for=\"honor in honors\"\r\n                  :key=\"honor.id\"\r\n                  :timestamp=\"honor.year\"\r\n                  placement=\"top\"\r\n                  :color=\"honor.color\"\r\n                >\r\n                  <el-card>\r\n                    <h3>{{ honor.title }}</h3>\r\n                    <p>{{ honor.description }}</p>\r\n                    <div class=\"honor-image\" v-if=\"honor.image\">\r\n                      <el-image :src=\"honor.image\" fit=\"cover\" :preview-src-list=\"[honor.image]\"></el-image>\r\n                    </div>\r\n                  </el-card>\r\n                </el-timeline-item>\r\n              </el-timeline>\r\n            </div>\r\n          </section>\r\n        </div>\r\n\r\n        <!-- 校园风光 -->\r\n        <div v-show=\"activeTab === 'campus'\" class=\"content-section\">\r\n          <section class=\"section campus\">\r\n            <div class=\"section-title\">\r\n              <h2>校园风光</h2>\r\n            </div>\r\n            <div class=\"campus-content\">\r\n              <el-row :gutter=\"20\">\r\n                <el-col :xs=\"24\" :sm=\"12\" :md=\"8\" :lg=\"6\" v-for=\"(image, index) in campusImages\" :key=\"index\">\r\n                  <el-card class=\"campus-card\" shadow=\"hover\">\r\n                    <el-image \r\n                      :src=\"image.url\" \r\n                      fit=\"cover\" \r\n                      :preview-src-list=\"campusImages.map(img => img.url)\"\r\n                      class=\"campus-image\"\r\n                    ></el-image>\r\n                    <div class=\"campus-image-title\">{{ image.title }}</div>\r\n                  </el-card>\r\n                </el-col>\r\n              </el-row>\r\n            </div>\r\n          </section>\r\n        </div>\r\n      </el-main>\r\n    </el-container>\r\n    \r\n    <el-footer class=\"footer\">\r\n      <div class=\"footer-content\">\r\n        <p>地址：深圳市宝安区石岩石龙仔路宝民学校</p>\r\n        <div class=\"copyright\">\r\n          © 2023 深圳市宝民职业技术学校 版权所有\r\n          <p>技术支持：dxh</p>\r\n        </div>\r\n      </div>\r\n    </el-footer>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport MainNavigation from '../components/MainNavigation.vue'\r\n\r\nexport default {\r\n  name: 'SchoolOverview',\r\n  components: {\r\n    MainNavigation\r\n  },\r\n  data() {\r\n    return {\r\n      activeTab: 'intro',\r\n      schoolImages: [\r\n        require('../assets/img/school/school1.jpg'),\r\n        require('../assets/img/school/school2.jpg'),\r\n        require('../assets/img/school/school3.jpg')\r\n      ],\r\n      leadershipTeam: [\r\n        {\r\n          id: 1,\r\n          name: '张校长',\r\n          title: '校长',\r\n          description: '从事教育工作30余年，曾获\"优秀教育工作者\"称号，致力于职业教育改革与创新。',\r\n          avatar: require('../assets/img/leaders/principal.jpg')\r\n        },\r\n        {\r\n          id: 2,\r\n          name: '李副校长',\r\n          title: '副校长',\r\n          description: '负责教学工作，推动校企合作，提升学校教学质量和学生就业率。',\r\n          avatar: require('../assets/img/leaders/vice_principal1.jpg')\r\n        },\r\n        {\r\n          id: 3,\r\n          name: '王副校长',\r\n          title: '副校长',\r\n          description: '负责学校行政和后勤工作，确保学校各项工作有序进行。',\r\n          avatar: require('../assets/img/leaders/vice_principal2.jpg')\r\n        }\r\n      ],\r\n      honors: [\r\n        {\r\n          id: 1,\r\n          year: '2023年',\r\n          title: '广东省优质技工学校',\r\n          description: '学校被判为广东省优质技工学校，这是对学校办学质量的高度认可。',\r\n          color: '#409EFF',\r\n          image: require('../assets/img/honors/honor1.jpg')\r\n        },\r\n        {\r\n          id: 2,\r\n          year: '2022年',\r\n          title: '深圳市职业教育先进单位',\r\n          description: '学校被判为深圳市职业教育先进单位，表彰学校在职业教育领域的突出贡献。',\r\n          color: '#67C23A',\r\n          image: require('../assets/img/honors/honor2.jpg')\r\n        },\r\n        {\r\n          id: 3,\r\n          year: '2021年',\r\n          title: '校企合作示范基地',\r\n          description: '学校被判为校企合作示范基地，肯定了学校在校企合作方面的成果。',\r\n          color: '#E6A23C',\r\n          image: require('../assets/img/honors/honor3.jpg')\r\n        }\r\n      ],\r\n      campusImages: [\r\n        {\r\n          url: require('../assets/img/campus/campus1.jpg'),\r\n          title: '教学楼'\r\n        },\r\n        {\r\n          url: require('../assets/img/campus/campus2.jpg'),\r\n          title: '实训中心'\r\n        },\r\n        {\r\n          url: require('../assets/img/campus/campus3.jpg'),\r\n          title: '图书馆'\r\n        },\r\n        {\r\n          url: require('../assets/img/campus/campus4.jpg'),\r\n          title: '运动场'\r\n        },\r\n        {\r\n          url: require('../assets/img/campus/campus5.jpg'),\r\n          title: '学生宿舍'\r\n        },\r\n        {\r\n          url: require('../assets/img/campus/campus6.jpg'),\r\n          title: '校园景观'\r\n        }\r\n      ]\r\n    }\r\n  },\r\n  created() {\r\n    // 根据URL查询参数设置当前活动的标签页\r\n    const tab = this.$route.query.tab;\r\n    if (tab) {\r\n      this.activeTab = tab;\r\n    }\r\n  },\r\n  watch: {\r\n    // 监听路由变化，更新活动标签页\r\n    '$route.query.tab': function(newTab) {\r\n      if (newTab) {\r\n        this.activeTab = newTab;\r\n      } else {\r\n        this.activeTab = 'intro';\r\n      }\r\n    }\r\n  },\r\n  methods: {\r\n    handleSelect(key) {\r\n      this.activeTab = key;\r\n      // 更新URL查询参数，但不触发路由变化\r\n      if (key === 'intro') {\r\n        this.$router.push({ path: '/school-overview' });\r\n      } else {\r\n        this.$router.push({ path: '/school-overview', query: { tab: key } });\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.school-overview-page {\r\n  display: flex;\r\n  flex-direction: column;\r\n  min-height: 100vh;\r\n}\r\n\r\n.header {\r\n  background-color: #0d47a1;\r\n  color: white;\r\n  padding: 10px 20px;\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n.logo-container {\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n.school-name h1 {\r\n  margin: 0;\r\n  font-size: 24px;\r\n}\r\n\r\n.school-name p {\r\n  margin: 0;\r\n  font-size: 12px;\r\n}\r\n\r\n.main-container {\r\n  flex: 1;\r\n  background-color: #f5f5f5;\r\n}\r\n\r\n.sidebar {\r\n  background-color: #0d47a1;\r\n  color: white;\r\n}\r\n\r\n.menu {\r\n  border-right: none;\r\n}\r\n\r\n.main-content {\r\n  padding: 20px;\r\n}\r\n\r\n.content-section {\r\n  background-color: white;\r\n  padding: 20px;\r\n  border-radius: 4px;\r\n  box-shadow: 0 2px 12px 0 rgba(0, 0, 0, 0.1);\r\n}\r\n\r\n.section-title {\r\n  margin-bottom: 20px;\r\n  padding-bottom: 10px;\r\n  border-bottom: 2px solid #0d47a1;\r\n}\r\n\r\n.section-title h2 {\r\n  color: #0d47a1;\r\n  font-size: 24px;\r\n  margin: 0;\r\n}\r\n\r\n.school-intro-content {\r\n  line-height: 1.8;\r\n  font-size: 16px;\r\n}\r\n\r\n.school-images {\r\n  margin-top: 20px;\r\n}\r\n\r\n.carousel-image {\r\n  width: 100%;\r\n  height: 100%;\r\n}\r\n\r\n.leader-card {\r\n  margin-bottom: 20px;\r\n  text-align: center;\r\n}\r\n\r\n.leader-avatar {\r\n  margin-bottom: 15px;\r\n}\r\n\r\n.leader-info h3 {\r\n  margin: 0;\r\n  font-size: 18px;\r\n  color: #0d47a1;\r\n}\r\n\r\n.leader-title {\r\n  color: #606266;\r\n  margin: 5px 0;\r\n}\r\n\r\n.leader-description {\r\n  text-align: left;\r\n  line-height: 1.6;\r\n}\r\n\r\n.honor-image {\r\n  margin-top: 10px;\r\n}\r\n\r\n.honor-image .el-image {\r\n  width: 100%;\r\n  max-height: 200px;\r\n}\r\n\r\n.campus-card {\r\n  margin-bottom: 20px;\r\n  overflow: hidden;\r\n}\r\n\r\n.campus-image {\r\n  width: 100%;\r\n  height: 200px;\r\n  transition: transform 0.3s;\r\n}\r\n\r\n.campus-image:hover {\r\n  transform: scale(1.05);\r\n}\r\n\r\n.campus-image-title {\r\n  text-align: center;\r\n  padding: 10px 0;\r\n  font-size: 16px;\r\n  color: #0d47a1;\r\n}\r\n\r\n.footer {\r\n  background-color: #535353;\r\n  color: white;\r\n  padding: 40px 0;\r\n  height: auto !important;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-con