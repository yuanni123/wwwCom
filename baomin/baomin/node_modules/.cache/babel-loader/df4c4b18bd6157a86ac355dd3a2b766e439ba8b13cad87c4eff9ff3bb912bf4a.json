{"ast":null,"code":"//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n\nimport MainNavigation from '../components/MainNavigation.vue';\nexport default {\n  name: 'SchoolOverview',\n  components: {\n    MainNavigation\n  },\n  data() {\n    return {\n      activeTab: 'intro',\n      // 使用静态数据替代图片资源\n      schoolImages: [\n      // 使用占位图片URL\n      'https://via.placeholder.com/800x400?text=学校外观', 'https://via.placeholder.com/800x400?text=教学楼', 'https://via.placeholder.com/800x400?text=实训中心'],\n      leadershipTeam: [{\n        id: 1,\n        name: '张校长',\n        title: '校长',\n        description: '从事教育工作30余年，曾获\"优秀教育工作者\"称号，致力于职业教育改革与创新。',\n        // 使用占位图片\n        avatar: 'https://via.placeholder.com/150?text=张校长'\n      }, {\n        id: 2,\n        name: '李副校长',\n        title: '副校长',\n        description: '负责教学工作，推动校企合作，提升学校教学质量和学生就业率。',\n        avatar: 'https://via.placeholder.com/150?text=李副校长'\n      }, {\n        id: 3,\n        name: '王副校长',\n        title: '副校长',\n        description: '负责学校行政和后勤工作，确保学校各项工作有序进行。',\n        avatar: 'https://via.placeholder.com/150?text=王副校长'\n      }],\n      honors: [{\n        id: 1,\n        year: '2023年',\n        title: '广东省优质技工学校',\n        description: '学校被判为广东省优质技工学校，这是对学校办学质量的高度认可。',\n        color: '#409EFF',\n        // 使用占位图片\n        image: 'https://via.placeholder.com/400x200?text=优质技工学校荣誉证书'\n      }, {\n        id: 2,\n        year: '2022年',\n        title: '深圳市职业教育先进单位',\n        description: '学校被判为深圳市职业教育先进单位，表彰学校在职业教育领域的突出贡献。',\n        color: '#67C23A',\n        image: 'https://via.placeholder.com/400x200?text=先进单位荣誉证书'\n      }, {\n        id: 3,\n        year: '2021年',\n        title: '校企合作示范基地',\n        description: '学校被判为校企合作示范基地，肯定了学校在校企合作方面的成果。',\n        color: '#E6A23C',\n        image: 'https://via.placeholder.com/400x200?text=示范基地荣誉证书'\n      }],\n      campusImages: [{\n        url: 'https://via.placeholder.com/400x300?text=教学楼',\n        title: '教学楼'\n      }, {\n        url: 'https://via.placeholder.com/400x300?text=实训中心',\n        title: '实训中心'\n      }, {\n        url: 'https://via.placeholder.com/400x300?text=图书馆',\n        title: '图书馆'\n      }, {\n        url: 'https://via.placeholder.com/400x300?text=运动场',\n        title: '运动场'\n      }, {\n        url: 'https://via.placeholder.com/400x300?text=学生宿舍',\n        title: '学生宿舍'\n      }, {\n        url: 'https://via.placeholder.com/400x300?text=校园景观',\n        title: '校园景观'\n      }]\n    };\n  },\n  created() {\n    // 根据URL查询参数设置当前活动的标签页\n    const tab = this.$route.query.tab;\n    if (tab) {\n      this.activeTab = tab;\n    }\n  },\n  watch: {\n    // 监听路由变化，更新活动标签页\n    '$route.query.tab': function (newTab) {\n      if (newTab) {\n        this.activeTab = newTab;\n      } else {\n        this.activeTab = 'intro';\n      }\n    }\n  },\n  methods: {\n    handleSelect(key) {\n      this.activeTab = key;\n\n      // 修复路由导航错误\n      const currentQuery = this.$route.query.tab;\n      try {\n        if (key === 'intro') {\n          if (currentQuery) {\n            // 只有当需要移除查询参数时才导航\n            this.$router.push({\n              path: '/school-overview',\n              query: {}\n            }).catch(err => {\n              if (err.name !== 'NavigationDuplicated') {\n                throw err;\n              }\n            });\n          }\n        } else if (key !== currentQuery) {\n          // 只有当切换到不同的标签页时才导航\n          this.$router.push({\n            path: '/school-overview',\n            query: {\n              tab: key\n            }\n          }).catch(err => {\n            if (err.name !== 'NavigationDuplicated') {\n              throw err;\n            }\n          });\n        }\n      } catch (err) {\n        // 忽略导航重复错误\n        if (err.name !== 'NavigationDuplicated') {\n          console.error(err);\n        }\n      }\n    }\n  }\n};","map":{"version":3,"names":["MainNavigation","name","components","data","activeTab","schoolImages","leadershipTeam","id","title","description","avatar","honors","year","color","image","campusImages","url","created","tab","$route","query","watch","$route.query.tab","newTab","methods","handleSelect","key","currentQuery","$router","push","path","catch","err","console","error"],"sources":["src/views/SchoolOverview.vue"],"sourcesContent":["<template>\r\n  <div class=\"school-overview-page\">\r\n    <el-header class=\"header\">\r\n      <div class=\"logo-container\">\r\n        <div class=\"school-name\">\r\n          <h1>深圳市宝民职业技术学校</h1>\r\n          <p>SHENZHEN BAOMIN VOCATIONAL TECHNICAL SCHOOL</p>\r\n        </div>\r\n      </div>\r\n    </el-header>\r\n    \r\n    <!-- 使用导航栏组件 -->\r\n    <main-navigation active-index=\"1\"></main-navigation>\r\n    \r\n    <!-- 添加横幅图片 -->\r\n    <div class=\"banner-container\">\r\n      <el-image \r\n        src=\"https://via.placeholder.com/1920x400?text=宝民职业技术学校校园风光\" \r\n        fit=\"cover\" \r\n        class=\"banner-image\">\r\n      </el-image>\r\n      <div class=\"banner-overlay\">\r\n        <h1>学校概况</h1>\r\n        <p>了解我们的历史、使命和愿景</p>\r\n      </div>\r\n    </div>\r\n    \r\n    <el-container class=\"main-container\">\r\n      <el-aside width=\"220px\" class=\"sidebar\">\r\n        <!-- 自定义菜单替代原有菜单 -->\r\n        <div class=\"custom-menu\">\r\n          <div class=\"menu-header\">\r\n            <h2>学校概况</h2>\r\n          </div>\r\n          <div class=\"menu-items\">\r\n            <div \r\n              class=\"menu-item\" \r\n              :class=\"{ 'active': activeTab === 'intro' }\"\r\n              @click=\"handleSelect('intro')\">\r\n              学校简介\r\n              <div v-if=\"activeTab === 'intro'\" class=\"active-indicator\"></div>\r\n            </div>\r\n            <div \r\n              class=\"menu-item\" \r\n              :class=\"{ 'active': activeTab === 'leadership' }\"\r\n              @click=\"handleSelect('leadership')\">\r\n              领导团队\r\n              <div v-if=\"activeTab === 'leadership'\" class=\"active-indicator\"></div>\r\n            </div>\r\n            <div \r\n              class=\"menu-item\" \r\n              :class=\"{ 'active': activeTab === 'honors' }\"\r\n              @click=\"handleSelect('honors')\">\r\n              荣誉资质\r\n              <div v-if=\"activeTab === 'honors'\" class=\"active-indicator\"></div>\r\n            </div>\r\n            <div \r\n              class=\"menu-item\" \r\n              :class=\"{ 'active': activeTab === 'campus' }\"\r\n              @click=\"handleSelect('campus')\">\r\n              校园风光\r\n              <div v-if=\"activeTab === 'campus'\" class=\"active-indicator\"></div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </el-aside>\r\n      \r\n      <el-main class=\"main-content\">\r\n        <!-- 学校简介 -->\r\n        <div v-show=\"activeTab === 'intro'\" class=\"content-section\">\r\n          <section class=\"section school-intro\">\r\n            <div class=\"section-title\">\r\n              <h2>学校简介</h2>\r\n            </div>\r\n            <div class=\"school-intro-content\">\r\n              <p>深圳市宝民技工学校是经深圳人力资源和社会保障厅批准设立的一所全日制技工学校，学校办学至今已有17年历史，以口碑办学。</p>\r\n              \r\n              <p>学校目前开设有新媒体与互联网应用、网络营销与直播技术、计算机应用与维修、电子商务、幼儿教育、汽车维修、3D 打印技术应用、模具制造、电梯安装与维修等9个专业，\r\n              其中计算机应用与维修、电子商务、幼儿教育、新媒体与互联网应用、网络营销与直播技术等5个专业为常设专业。</p>\r\n\r\n              <p>学校加强校企合作，推进工学融合、模拟实训，致力于为社会培养既有一定专业理论水平，又有很强动手能力的高素质技术技能型人才。逐步形成\"产教联动、校企融合，企业环境、工学一体，素养为本、技能为用\"的办学模式</p>\r\n              \r\n              <div class=\"school-images\">\r\n                <el-carousel :interval=\"4000\" type=\"card\" height=\"300px\">\r\n                  <el-carousel-item v-for=\"(image, index) in schoolImages\" :key=\"index\">\r\n                    <el-image :src=\"image\" fit=\"cover\" class=\"carousel-image\"></el-image>\r\n                  </el-carousel-item>\r\n                </el-carousel>\r\n              </div>\r\n            </div>\r\n          </section>\r\n        </div>\r\n\r\n        <!-- 领导团队 -->\r\n        <div v-show=\"activeTab === 'leadership'\" class=\"content-section\">\r\n          <section class=\"section leadership\">\r\n            <div class=\"section-title\">\r\n              <h2>领导团队</h2>\r\n            </div>\r\n            <div class=\"leadership-content\">\r\n              <el-row :gutter=\"30\">\r\n                <el-col :xs=\"24\" :sm=\"24\" :md=\"8\" v-for=\"leader in leadershipTeam\" :key=\"leader.id\" class=\"leader-col\">\r\n                  <el-card class=\"leader-card\" shadow=\"hover\">\r\n                    <div class=\"leader-avatar\">\r\n                      <el-avatar :size=\"120\" :src=\"leader.avatar\"></el-avatar>\r\n                    </div>\r\n                    <div class=\"leader-info\">\r\n                      <h3>{{ leader.name }}</h3>\r\n                      <p class=\"leader-title\">{{ leader.title }}</p>\r\n                      <p class=\"leader-description\">{{ leader.description }}</p>\r\n                    </div>\r\n                  </el-card>\r\n                </el-col>\r\n              </el-row>\r\n            </div>\r\n          </section>\r\n        </div>\r\n\r\n        <!-- 荣誉资质 -->\r\n        <div v-show=\"activeTab === 'honors'\" class=\"content-section\">\r\n          <section class=\"section honors\">\r\n            <div class=\"section-title\">\r\n              <h2>荣誉资质</h2>\r\n            </div>\r\n            <div class=\"honors-content\">\r\n              <el-timeline>\r\n                <el-timeline-item\r\n                  v-for=\"honor in honors\"\r\n                  :key=\"honor.id\"\r\n                  :timestamp=\"honor.year\"\r\n                  placement=\"top\"\r\n                  :color=\"honor.color\"\r\n                >\r\n                  <el-card class=\"honor-card\">\r\n                    <h3>{{ honor.title }}</h3>\r\n                    <p>{{ honor.description }}</p>\r\n                    <div class=\"honor-image\" v-if=\"honor.image\">\r\n                      <el-image :src=\"honor.image\" fit=\"cover\" :preview-src-list=\"[honor.image]\"></el-image>\r\n                    </div>\r\n                  </el-card>\r\n                </el-timeline-item>\r\n              </el-timeline>\r\n            </div>\r\n          </section>\r\n        </div>\r\n\r\n        <!-- 校园风光 -->\r\n        <div v-show=\"activeTab === 'campus'\" class=\"content-section\">\r\n          <section class=\"section campus\">\r\n            <div class=\"section-title\">\r\n              <h2>校园风光</h2>\r\n            </div>\r\n            <div class=\"campus-content\">\r\n              <el-row :gutter=\"30\">\r\n                <el-col :xs=\"24\" :sm=\"12\" :md=\"8\" :lg=\"8\" v-for=\"(image, index) in campusImages\" :key=\"index\" class=\"campus-col\">\r\n                  <el-card class=\"campus-card\" shadow=\"hover\">\r\n                    <el-image \r\n                      :src=\"image.url\" \r\n                      fit=\"cover\" \r\n                      :preview-src-list=\"campusImages.map(img => img.url)\"\r\n                      class=\"campus-image\"\r\n                    ></el-image>\r\n                    <div class=\"campus-image-title\">{{ image.title }}</div>\r\n                  </el-card>\r\n                </el-col>\r\n              </el-row>\r\n            </div>\r\n          </section>\r\n        </div>\r\n      </el-main>\r\n    </el-container>\r\n    \r\n    <el-footer class=\"footer\">\r\n      <div class=\"footer-content\">\r\n        <p>地址：深圳市宝安区松白路7022号宝民技工学校</p>\r\n        <div class=\"copyright\">\r\n          © 2023 深圳市宝民技工学校 版权所有\r\n        </div>\r\n      </div>\r\n    </el-footer>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport MainNavigation from '../components/MainNavigation.vue'\r\n\r\nexport default {\r\n  name: 'SchoolOverview',\r\n  components: {\r\n    MainNavigation\r\n  },\r\n  data() {\r\n    return {\r\n      activeTab: 'intro',\r\n      // 使用静态数据替代图片资源\r\n      schoolImages: [\r\n        // 使用占位图片URL\r\n        'https://via.placeholder.com/800x400?text=学校外观',\r\n        'https://via.placeholder.com/800x400?text=教学楼',\r\n        'https://via.placeholder.com/800x400?text=实训中心'\r\n      ],\r\n      leadershipTeam: [\r\n        {\r\n          id: 1,\r\n          name: '张校长',\r\n          title: '校长',\r\n          description: '从事教育工作30余年，曾获\"优秀教育工作者\"称号，致力于职业教育改革与创新。',\r\n          // 使用占位图片\r\n          avatar: 'https://via.placeholder.com/150?text=张校长'\r\n        },\r\n        {\r\n          id: 2,\r\n          name: '李副校长',\r\n          title: '副校长',\r\n          description: '负责教学工作，推动校企合作，提升学校教学质量和学生就业率。',\r\n          avatar: 'https://via.placeholder.com/150?text=李副校长'\r\n        },\r\n        {\r\n          id: 3,\r\n          name: '王副校长',\r\n          title: '副校长',\r\n          description: '负责学校行政和后勤工作，确保学校各项工作有序进行。',\r\n          avatar: 'https://via.placeholder.com/150?text=王副校长'\r\n        }\r\n      ],\r\n      honors: [\r\n        {\r\n          id: 1,\r\n          year: '2023年',\r\n          title: '广东省优质技工学校',\r\n          description: '学校被判为广东省优质技工学校，这是对学校办学质量的高度认可。',\r\n          color: '#409EFF',\r\n          // 使用占位图片\r\n          image: 'https://via.placeholder.com/400x200?text=优质技工学校荣誉证书'\r\n        },\r\n        {\r\n          id: 2,\r\n          year: '2022年',\r\n          title: '深圳市职业教育先进单位',\r\n          description: '学校被判为深圳市职业教育先进单位，表彰学校在职业教育领域的突出贡献。',\r\n          color: '#67C23A',\r\n          image: 'https://via.placeholder.com/400x200?text=先进单位荣誉证书'\r\n        },\r\n        {\r\n          id: 3,\r\n          year: '2021年',\r\n          title: '校企合作示范基地',\r\n          description: '学校被判为校企合作示范基地，肯定了学校在校企合作方面的成果。',\r\n          color: '#E6A23C',\r\n          image: 'https://via.placeholder.com/400x200?text=示范基地荣誉证书'\r\n        }\r\n      ],\r\n      campusImages: [\r\n        {\r\n          url: 'https://via.placeholder.com/400x300?text=教学楼',\r\n          title: '教学楼'\r\n        },\r\n        {\r\n          url: 'https://via.placeholder.com/400x300?text=实训中心',\r\n          title: '实训中心'\r\n        },\r\n        {\r\n          url: 'https://via.placeholder.com/400x300?text=图书馆',\r\n          title: '图书馆'\r\n        },\r\n        {\r\n          url: 'https://via.placeholder.com/400x300?text=运动场',\r\n          title: '运动场'\r\n        },\r\n        {\r\n          url: 'https://via.placeholder.com/400x300?text=学生宿舍',\r\n          title: '学生宿舍'\r\n        },\r\n        {\r\n          url: 'https://via.placeholder.com/400x300?text=校园景观',\r\n          title: '校园景观'\r\n        }\r\n      ]\r\n    }\r\n  },\r\n  created() {\r\n    // 根据URL查询参数设置当前活动的标签页\r\n    const tab = this.$route.query.tab;\r\n    if (tab) {\r\n      this.activeTab = tab;\r\n    }\r\n  },\r\n  watch: {\r\n    // 监听路由变化，更新活动标签页\r\n    '$route.query.tab': function(newTab) {\r\n      if (newTab) {\r\n        this.activeTab = newTab;\r\n      } else {\r\n        this.activeTab = 'intro';\r\n      }\r\n    }\r\n  },\r\n  methods: {\r\n    handleSelect(key) {\r\n      this.activeTab = key;\r\n      \r\n      // 修复路由导航错误\r\n      const currentQuery = this.$route.query.tab;\r\n      \r\n      try {\r\n        if (key === 'intro') {\r\n          if (currentQuery) {\r\n            // 只有当需要移除查询参数时才导航\r\n            this.$router.push({ path: '/school-overview', query: {} }).catch(err => {\r\n              if (err.name !== 'NavigationDuplicated') {\r\n                throw err;\r\n              }\r\n            });\r\n          }\r\n        } else if (key !== currentQuery) {\r\n          // 只有当切换到不同的标签页时才导航\r\n          this.$router.push({ path: '/school-overview', query: { tab: key } }).catch(err => {\r\n            if (err.name !== 'NavigationDuplicated') {\r\n              throw err;\r\n            }\r\n          });\r\n        }\r\n      } catch (err) {\r\n        // 忽略导航重复错误\r\n        if (err.name !== 'NavigationDuplicated') {\r\n          console.error(err);\r\n        }\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.school-overview-page {\r\n  display: flex;\r\n  flex-direction: column;\r\n  min-height: 100vh;\r\n}\r\n\r\n/* 添加横幅样式 */\r\n.banner-container {\r\n  position: relative;\r\n  width: 100%;\r\n  height: 250px;\r\n  overflow: hidden;\r\n}\r\n\r\n.banner-image {\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: cover;\r\n}\r\n\r\n.banner-overlay {\r\n  position: absolute;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  background: rgba(13, 71, 161, 0.6);\r\n  display: flex;\r\n  flex-direction: column;\r\n  justify-content: center;\r\n  align-items: center;\r\n  color: white;\r\n  text-align: center;\r\n}\r\n\r\n.banner-overlay h1 {\r\n  font-size: 36px;\r\n  margin: 0 0 10px 0;\r\n  text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);\r\n}\r\n\r\n.banner-overlay p {\r\n  font-size: 18px;\r\n  margin: 0;\r\n  text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.5);\r\n}\r\n\r\n.header {\r\n  background-color: #0d47a1;\r\n  color: white;\r\n  padding: 10px 20px;\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n.logo-container {\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n.school-name h1 {\r\n  margin: 0;\r\n  font-size: 24px;\r\n}\r\n\r\n.school-name p {\r\n  margin: 0;\r\n  font-size: 12px;\r\n}\r\n\r\n.main-container {\r\n  flex: 1;\r\n  background-color: #f5f5f5;\r\n  padding: 30px;\r\n