{"ast":null,"code":"//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n//\n\nexport default {\n  name: 'ContactUs',\n  data() {\n    return {\n      form: {\n        name: '',\n        phone: '',\n        school: '',\n        content: ''\n      },\n      rules: {\n        name: [{\n          required: true,\n          message: '请输入姓名',\n          trigger: 'blur'\n        }],\n        phone: [{\n          required: true,\n          message: '请输入电话',\n          trigger: 'blur'\n        }],\n        school: [{\n          required: true,\n          message: '请输入就读学校',\n          trigger: 'blur'\n        }],\n        content: [{\n          required: true,\n          message: '请输入留言内容',\n          trigger: 'blur'\n        }]\n      },\n      // 百度地图嵌入URL\n      mapUrl: 'https://map.baidu.com/poi/%E6%B7%B1%E5%9C%B3%E5%B8%82%E5%AE%9D%E6%B0%91%E6%8A%80%E5%B7%A5%E5%AD%A6%E6%A0%A1/@12683949.565,2560220.71,19z?uid=a3e1a9d8b8bac7b0a367b4f3&ugc_type=3&ugc_ver=1&device_ratio=2&compat=1&pcevaname=pc4.1&querytype=detailConInfo&da_src=shareurl'\n    };\n  },\n  mounted() {\n    // 在组件挂载后加载地图\n    this.initMap();\n  },\n  methods: {\n    submitForm(formName) {\n      this.$refs[formName].validate(valid => {\n        if (valid) {\n          this.$message({\n            message: '留言提交成功！',\n            type: 'success'\n          });\n          this.$refs[formName].resetFields();\n        } else {\n          return false;\n        }\n      });\n    },\n    initMap() {\n      // 确保百度地图脚本已加载\n      if (typeof BMap === 'undefined') {\n        const script = document.createElement('script');\n        script.src = 'https://api.map.baidu.com/api?v=3.0&ak=您的百度地图AK&callback=initBaiduMap';\n        script.async = true;\n        document.body.appendChild(script);\n\n        // 定义全局回调函数\n        window.initBaiduMap = () => {\n          this.createMap();\n        };\n      } else {\n        this.createMap();\n      }\n    },\n    createMap() {\n      // 创建百度地图实例\n      const map = new BMap.Map('school-map');\n      // 深圳市宝安区松白路7022号的大致坐标（需要根据实际位置调整）\n      const point = new BMap.Point(113.9, 22.6);\n      map.centerAndZoom(point, 16);\n      map.enableScrollWheelZoom(true);\n\n      // 添加地图控件\n      map.addControl(new BMap.NavigationControl());\n      map.addControl(new BMap.ScaleControl());\n      map.addControl(new BMap.OverviewMapControl());\n\n      // 添加标记点\n      const marker = new BMap.Marker(point);\n      map.addOverlay(marker);\n\n      // 添加信息窗口\n      const infoWindow = new BMap.InfoWindow('深圳市宝民技工学校', {\n        title: '学校地址',\n        enableMessage: true\n      });\n      marker.addEventListener('click', function () {\n        map.openInfoWindow(infoWindow, point);\n      });\n    }\n  }\n};","map":{"version":3,"names":["name","data","form","phone","school","content","rules","required","message","trigger","mapUrl","mounted","initMap","methods","submitForm","formName","$refs","validate","valid","$message","type","resetFields","BMap","script","document","createElement","src","async","body","appendChild","window","initBaiduMap","createMap","map","Map","point","Point","centerAndZoom","enableScrollWheelZoom","addControl","NavigationControl","ScaleControl","OverviewMapControl","marker","Marker","addOverlay","infoWindow","InfoWindow","title","enableMessage","addEventListener","openInfoWindow"],"sources":["src/components/ContactUs.vue"],"sourcesContent":["<template>\r\n  <div class=\"contact-us-container\">\r\n    <div class=\"contact-info\">\r\n      <h2>联系我们</h2>\r\n      <div class=\"info-item\">\r\n        <div class=\"label\">电话：</div>\r\n        <div class=\"value\">1801877xxx</div>\r\n      </div>\r\n      <div class=\"info-item\">\r\n        <div class=\"label\">QQ：</div>\r\n        <div class=\"value\">146479xxx</div>\r\n      </div>\r\n      <div class=\"info-item\">\r\n        <div class=\"label\">邮箱：</div>\r\n        <div class=\"value\">14xxxxx7518@qq.com</div>\r\n      </div>\r\n      <div class=\"info-item\">\r\n        <div class=\"label\">地址：</div>\r\n        <div class=\"value\">深圳市宝安区松白路7022号宝民技工学校</div>\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"contact-form\">\r\n      <h2>发表您的留言：</h2>\r\n      <el-form :model=\"form\" ref=\"form\" :rules=\"rules\" label-position=\"top\">\r\n        <el-row :gutter=\"20\">\r\n          <el-col :span=\"12\">\r\n            <el-form-item label=\"姓名：\" prop=\"name\">\r\n              <el-input v-model=\"form.name\" placeholder=\"请输入姓名\"></el-input>\r\n            </el-form-item>\r\n          </el-col>\r\n          <el-col :span=\"12\">\r\n            <el-form-item label=\"电话：\" prop=\"phone\">\r\n              <el-input v-model=\"form.phone\" placeholder=\"请输入电话\"></el-input>\r\n            </el-form-item>\r\n          </el-col>\r\n        </el-row>\r\n        <el-form-item label=\"就读学校：\" prop=\"school\">\r\n          <el-input v-model=\"form.school\" placeholder=\"请输入就读学校\"></el-input>\r\n        </el-form-item>\r\n        <el-form-item label=\"内容：\" prop=\"content\">\r\n          <el-input \r\n            type=\"textarea\" \r\n            v-model=\"form.content\" \r\n            placeholder=\"请输入留言内容\" \r\n            :rows=\"5\">\r\n          </el-input>\r\n        </el-form-item>\r\n        <el-form-item>\r\n          <el-button type=\"primary\" @click=\"submitForm('form')\" class=\"submit-btn\">提交留言</el-button>\r\n        </el-form-item>\r\n      </el-form>\r\n    </div>\r\n\r\n    <!-- 添加地图组件 -->\r\n    <div class=\"map-container\">\r\n      <h2>学校位置</h2>\r\n      <!-- 替换为iframe嵌入地图 -->\r\n      <iframe \r\n        :src=\"mapUrl\" \r\n        class=\"map\" \r\n        frameborder=\"0\" \r\n        scrolling=\"no\">\r\n      </iframe>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'ContactUs',\r\n  data() {\r\n    return {\r\n      form: {\r\n        name: '',\r\n        phone: '',\r\n        school: '',\r\n        content: ''\r\n      },\r\n      rules: {\r\n        name: [\r\n          { required: true, message: '请输入姓名', trigger: 'blur' }\r\n        ],\r\n        phone: [\r\n          { required: true, message: '请输入电话', trigger: 'blur' }\r\n        ],\r\n        school: [\r\n          { required: true, message: '请输入就读学校', trigger: 'blur' }\r\n        ],\r\n        content: [\r\n          { required: true, message: '请输入留言内容', trigger: 'blur' }\r\n        ]\r\n      },\r\n      // 百度地图嵌入URL\r\n      mapUrl: 'https://map.baidu.com/poi/%E6%B7%B1%E5%9C%B3%E5%B8%82%E5%AE%9D%E6%B0%91%E6%8A%80%E5%B7%A5%E5%AD%A6%E6%A0%A1/@12683949.565,2560220.71,19z?uid=a3e1a9d8b8bac7b0a367b4f3&ugc_type=3&ugc_ver=1&device_ratio=2&compat=1&pcevaname=pc4.1&querytype=detailConInfo&da_src=shareurl'\r\n    }\r\n  },\r\n  mounted() {\r\n    // 在组件挂载后加载地图\r\n    this.initMap();\r\n  },\r\n  methods: {\r\n    submitForm(formName) {\r\n      this.$refs[formName].validate((valid) => {\r\n        if (valid) {\r\n          this.$message({\r\n            message: '留言提交成功！',\r\n            type: 'success'\r\n          });\r\n          this.$refs[formName].resetFields();\r\n        } else {\r\n          return false;\r\n        }\r\n      });\r\n    },\r\n    initMap() {\r\n      // 确保百度地图脚本已加载\r\n      if (typeof BMap === 'undefined') {\r\n        const script = document.createElement('script');\r\n        script.src = 'https://api.map.baidu.com/api?v=3.0&ak=您的百度地图AK&callback=initBaiduMap';\r\n        script.async = true;\r\n        document.body.appendChild(script);\r\n        \r\n        // 定义全局回调函数\r\n        window.initBaiduMap = () => {\r\n          this.createMap();\r\n        };\r\n      } else {\r\n        this.createMap();\r\n      }\r\n    },\r\n    createMap() {\r\n      // 创建百度地图实例\r\n      const map = new BMap.Map('school-map');\r\n      // 深圳市宝安区松白路7022号的大致坐标（需要根据实际位置调整）\r\n      const point = new BMap.Point(113.9, 22.6);\r\n      map.centerAndZoom(point, 16);\r\n      map.enableScrollWheelZoom(true);\r\n      \r\n      // 添加地图控件\r\n      map.addControl(new BMap.NavigationControl());\r\n      map.addControl(new BMap.ScaleControl());\r\n      map.addControl(new BMap.OverviewMapControl());\r\n      \r\n      // 添加标记点\r\n      const marker = new BMap.Marker(point);\r\n      map.addOverlay(marker);\r\n      \r\n      // 添加信息窗口\r\n      const infoWindow = new BMap.InfoWindow('深圳市宝民技工学校', {\r\n        title: '学校地址',\r\n        enableMessage: true\r\n      });\r\n      marker.addEventListener('click', function() {\r\n        map.openInfoWindow(infoWindow, point);\r\n      });\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.contact-us-container {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 30px;\r\n  padding: 20px;\r\n  background-color: #fff;\r\n  border-radius: 4px;\r\n  box-shadow: 0 2px 12px 0 rgba(0, 0, 0, 0.1);\r\n}\r\n\r\n.contact-info {\r\n  background-color: #f8f8f8;\r\n  padding: 20px;\r\n  border-radius: 4px;\r\n}\r\n\r\n.contact-info h2 {\r\n  color: #0d47a1;\r\n  margin-top: 0;\r\n  margin-bottom: 20px;\r\n  border-bottom: 2px solid #0d47a1;\r\n  padding-bottom: 10px;\r\n}\r\n\r\n.info-item {\r\n  display: flex;\r\n  margin-bottom: 15px;\r\n}\r\n\r\n.label {\r\n  font-weight: bold;\r\n  width: 60px;\r\n}\r\n\r\n.value {\r\n  flex: 1;\r\n}\r\n\r\n.contact-form h2 {\r\n  color: #0d47a1;\r\n  margin-top: 0;\r\n  margin-bottom: 20px;\r\n  border-bottom: 2px solid #0d47a1;\r\n  padding-bottom: 10px;\r\n}\r\n\r\n.submit-btn {\r\n  width: 120px;\r\n  background-color: #1890ff;\r\n  border-color: #1890ff;\r\n}\r\n\r\n.el-form-item__label {\r\n  font-weight: bold;\r\n}\r\n\r\n/* 地图容器样式 */\r\n.map-container {\r\n  margin-top: 20px;\r\n}\r\n\r\n.map-container h2 {\r\n  color: #0d47a1;\r\n  margin-top: 0;\r\n  margin-bottom: 20px;\r\n  border-bottom: 2px solid #0d47a1;\r\n  padding-bottom: 10px;\r\n}\r\n\r\n.map {\r\n  width: 100%;\r\n  height: 400px;\r\n  border-radius: 4px;\r\n  overflow: hidden;\r\n  box-shadow: 0 2px 12px 0 rgba(0, 0, 0, 0.1);\r\n}\r\n</style>"],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAqEA;EACAA,IAAA;EACAC,KAAA;IACA;MACAC,IAAA;QACAF,IAAA;QACAG,KAAA;QACAC,MAAA;QACAC,OAAA;MACA;MACAC,KAAA;QACAN,IAAA,GACA;UAAAO,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA,EACA;QACAN,KAAA,GACA;UAAAI,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA,EACA;QACAL,MAAA,GACA;UAAAG,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA,EACA;QACAJ,OAAA,GACA;UAAAE,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA;MAEA;MACA;MACAC,MAAA;IACA;EACA;EACAC,QAAA;IACA;IACA,KAAAC,OAAA;EACA;EACAC,OAAA;IACAC,WAAAC,QAAA;MACA,KAAAC,KAAA,CAAAD,QAAA,EAAAE,QAAA,CAAAC,KAAA;QACA,IAAAA,KAAA;UACA,KAAAC,QAAA;YACAX,OAAA;YACAY,IAAA;UACA;UACA,KAAAJ,KAAA,CAAAD,QAAA,EAAAM,WAAA;QACA;UACA;QACA;MACA;IACA;IACAT,QAAA;MACA;MACA,WAAAU,IAAA;QACA,MAAAC,MAAA,GAAAC,QAAA,CAAAC,aAAA;QACAF,MAAA,CAAAG,GAAA;QACAH,MAAA,CAAAI,KAAA;QACAH,QAAA,CAAAI,IAAA,CAAAC,WAAA,CAAAN,MAAA;;QAEA;QACAO,MAAA,CAAAC,YAAA;UACA,KAAAC,SAAA;QACA;MACA;QACA,KAAAA,SAAA;MACA;IACA;IACAA,UAAA;MACA;MACA,MAAAC,GAAA,OAAAX,IAAA,CAAAY,GAAA;MACA;MACA,MAAAC,KAAA,OAAAb,IAAA,CAAAc,KAAA;MACAH,GAAA,CAAAI,aAAA,CAAAF,KAAA;MACAF,GAAA,CAAAK,qBAAA;;MAEA;MACAL,GAAA,CAAAM,UAAA,KAAAjB,IAAA,CAAAkB,iBAAA;MACAP,GAAA,CAAAM,UAAA,KAAAjB,IAAA,CAAAmB,YAAA;MACAR,GAAA,CAAAM,UAAA,KAAAjB,IAAA,CAAAoB,kBAAA;;MAEA;MACA,MAAAC,MAAA,OAAArB,IAAA,CAAAsB,MAAA,CAAAT,KAAA;MACAF,GAAA,CAAAY,UAAA,CAAAF,MAAA;;MAEA;MACA,MAAAG,UAAA,OAAAxB,IAAA,CAAAyB,UAAA;QACAC,KAAA;QACAC,aAAA;MACA;MACAN,MAAA,CAAAO,gBAAA;QACAjB,GAAA,CAAAkB,cAAA,CAAAL,UAAA,EAAAX,KAAA;MACA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}